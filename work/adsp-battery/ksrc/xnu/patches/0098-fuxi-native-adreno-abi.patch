+     case 0x8405: r->tl2=v; break;
+     case 0x8406: r->br2=v; break;
+     case 0xb2c0: r->s2_info=v; break;
+     case 0xb2c1: r->s2_size=v; break;
+     case 0x8400: r->bc=v; break;
