+ if (!vm->inline_attached && !vm->root_va[2]) {
+  vm->root_va[2] = FG_INL_L2 | 3;
+  FG_PT_PUBLISH(vm->root_va, 4096);
+  vm->inline_attached = 1;
+ }
+ return vm->inline_attached;
+}
+static int fg_inl_to_present(void)
+{
