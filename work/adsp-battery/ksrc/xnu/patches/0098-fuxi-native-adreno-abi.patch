+#ifndef FG_SOFT_RECOVER_HW
+#ifdef FUXI_GPU_XNU
+static int fg_soft_recover_hw(struct fuxi_gpu_vm *guilty_vm)
+{
+ fg_irq_quiesce_soft();
+ unsigned cb = g_cb(g3_bank);
+ const char *fail_step = NULL;
+ uint32_t fsr_pre = g3_sr(cb + 0x58);
+ uint32_t cp_pre = g3_gr(0x823);
+ uint32_t rbbm_pre = g3_gr(0x210);
+ uint32_t fsr_rst = 0, cp_rst = 0, rbbm_rst = 0;
+ uint32_t fsr_sqe = 0, cp_sqe = 0, rbbm_sqe = 0;
+ unsigned rbbm_halt_ack = 0;
+
+ if (fg_access_failed) { fail_step = "pre-mmio"; goto fail; }
+
+ /* Unblock any stalled SMMU context bank transaction (FSR.SS) BEFORE GBIF bus drain,
+  * otherwise AXI stall keeps 0x3c46 drain acks blocked until timeout. */
+ if (fsr_pre & (1u << 30)) {
+  if (!g3_sw(cb + 0x08, 1)) { fail_step = "cb-resume-pre"; goto fail; }
+ }
+ if (fsr_pre && !g3_sw(cb + 0x58, fsr_pre)) { fail_step = "fsr-clear-pre"; goto fail; }
+ /* Halt SQE before draining GBIF so no new CP fetches issue during bus quiesce. */
+ if (!g3_gw(G3_SQE_CNTL, 3)) { fail_step = "sqe-halt"; goto fail; }
+ if (guilty_vm && fg_abi_tlb_asid(guilty_vm->asid)) { fail_step = "tlb-guilty"; goto fail; }
+
+ /* Halt RBBM->GBIF (0x16) and GBIF client/arbiter (0x3c45); keep halted across SW reset
+  * and until after CB2 switches to G3_PT so residual UCHE/SP fetches cannot fault on ASID 2. */
+ {
+  uint64_t hv = 1;
+  if (fg_access(GPU_REG_BASE + 0x16*4, &hv, 1, 0)) { fail_step = "rbbm-halt-wr"; goto fail; }
+  for (unsigned i = 0; i < 1000; i++) {
+   hv = 0;
+   if (fg_access(GPU_REG_BASE + 0x17*4, &hv, 0, 0)) { fail_step = "rbbm-halt-rd"; goto fail; }
+   if (hv & 1u) { rbbm_halt_ack = 1; break; }
+   delay(1);
+  }
+ }
+
+ uint64_t v = 1;
+ int good = !fg_access(GPU_REG_BASE + 0x3c45*4, &v, 1, 0);
+ for (unsigned step = 1; step <= 2 && good; step++) {
+  unsigned i;
+  for (i = 0; i < 1000; i++) {
+   v = 0;
+   if (fg_access(GPU_REG_BASE + 0x3c46*4, &v, 0, 0)) { good = 0; break; }
+   if (v & step) break;
+   delay(1);
+  }
+  if (i == 1000) good = 0;
+  if (step == 1 && good) {
+   v = 2;
+   if (fg_access(GPU_REG_BASE + 0x3c45*4, &v, 1, 0)) good = 0;
+  }
+ }
+ if (!good) { fail_step = "gbif-halt"; goto fail; }
+ (void)g3_gr(0x3c46);
+ (void)g3_gr(0x17);
+ __asm__ volatile("dsb sy" ::: "memory");
+ if (fg_access_failed) { fail_step = "halt-barrier"; goto fail; }
+
+ /* Pulse RBBM_SW_RESET while GBIF_HALT stays asserted and before switching TTBR to G3_PT. */
+ v = 1;
+ if (fg_access(GPU_REG_BASE + 0x43*4, &v, 1, 0)) { fail_step = "sw-reset-set"; goto fail; }
+ delay(100);
+ v = 0;
+ if (fg_access(GPU_REG_BASE + 0x43*4, &v, 1, 0)) { fail_step = "sw-reset-clr"; goto fail; }
+ (void)g3_gr(0x43);
+ delay(20);
+ if (fg_suspends != UINT64_MAX) ++fg_suspends;
+
+ fsr_rst = g3_sr(cb + 0x58);
+ cp_rst = g3_gr(0x823);
+ rbbm_rst = g3_gr(0x210);
+ if (fg_access_failed) { fail_step = "post-reset-rd"; goto fail; }
+ if (fsr_rst & (1u << 30)) {
+  if (!g3_sw(cb + 0x08, 1)) { fail_step = "cb-resume-rst"; goto fail; }
+ }
+ if (fsr_rst && !g3_sw(cb + 0x58, fsr_rst)) { fail_step = "fsr-clear-rst"; goto fail; }
+ {
+  uint32_t gfsr_rst = g3_sr(SMMU_GFSR);
+  if (fg_access_failed) { fail_step = "gfsr-rd"; goto fail; }
+  if (gfsr_rst && !g3_sw(SMMU_GFSR, gfsr_rst)) { fail_step = "gfsr-clr"; goto fail; }
+ }
+ if (!g3_gw(0x37, 0xffffffffu)) { fail_step = "int-clear-rst"; goto fail; }
+
+ /* GPU core is reset and GBIF is still halted: switch CB2 to safe G3_PT (ASID 2). */
+ if (!fg_abi_switch_vm(NULL)) { fail_step = "switch-g3pt"; goto fail; }
+ {
+  uint32_t fsr_pt = g3_sr(cb + 0x58);
+  if (fg_access_failed) { fail_step = "fsr-pt-rd"; goto fail; }
+  if (fsr_pt & G3_FSR_MASK) {
+   if (fsr_pt & (1u << 30)) (void)g3_sw(cb + 0x08, 1);
+   if (!g3_sw(cb + 0x58, fsr_pt)) { fail_step = "fsr-pt-clr"; goto fail; }
+  }
+ }
+
+ /* Verify/reload SQE firmware and zero ring + RPTR shadow before g3_hw_init() clears halts. */
+ if (g3_sqe()) { fail_step = "sqe-reload"; goto fail; }
+ g3_wptr = 0;
+ g_zero(G3_RING_PA, 32768);
+ g_zero(G3_PTR_PA, 16);
+
+ /* Re-program CP/UCHE/RB registers (releases 0x3c45/0x16 halts with readbacks). */
+ if (!g3_hw_init()) { fail_step = "hw-init"; goto fail; }
+ if (!g3_gw(0x37, 0xffffffffu)) { fail_step = "int-clear-hw"; goto fail; }
+ if (g3_verify_pointers()) { fail_step = "verify-ptrs"; goto fail; }
+
+ /* Match g3_cp_start(): load CP_THREAD_CONTROL + CP_ME_INIT into ring BEFORE G3_SQE_CNTL=1. */
+ g3_wptr = 0;
+ g3_emit(g3_pkt7(0x17, 1)); g3_emit(1u << 27);
+ g3_emit(g3_pkt7(0x48, 4)); g3_emit(0x4b); g3_emit(3); g3_emit(0x20000000); g3_emit(2);
+ __asm__ volatile("dsb sy" ::: "memory");
+ if (fg_access_failed || g3_faulted()) { fail_step = "pre-sqe-fault"; goto fail; }
+ if (!g3_gw(0x807, 0)) { fail_step = "wptr0"; goto fail; }
+ __asm__ volatile("dsb sy" ::: "memory");
+ if (!g3_gw(G3_SQE_CNTL, 1)) { fail_step = "sqe-cntl"; goto fail; }
+ delay(100);
+ fsr_sqe = g3_sr(cb + 0x58);
+ cp_sqe = g3_gr(0x823);
+ rbbm_sqe = g3_gr(0x210);
+ if (fg_access_failed || g3_faulted()) { fail_step = "sqe-start-fault"; goto fail; }
+
+ if (!g3_gw(0x807, g3_wptr)) { fail_step = "me-init-wptr"; goto fail; }
+ if (g3_wait(0)) { fail_step = "me-init-wait"; goto fail; }
+
+ /* Re-apply SM8550 UBWC NC settings and CMP_DBG bit 11. */
+ uint32_t cmp = g3_gr(G4_RB_CMP_DBG);
+ if (fg_access_failed || !g3_gw(G4_RB_CMP_DBG, cmp | (1u<<11))) { fail_step = "cmp-dbg"; goto fail; }
+ static const struct { unsigned reg; uint32_t val; } nc_writes[] = {
+  {G4_RB_NC, 0x816}, {G4_TPL1_NC, 6}, {G4_SP_NC, 0x26},
+  {G3_APERTURE_HOST, 1u<<12}, {G4_GRAS_NC, 0x60},
+  {G3_APERTURE_HOST, 2u<<12}, {G4_GRAS_NC, 0x60},
+  {G3_APERTURE_HOST, 0},
+ };
+ for (unsigned i = 0; i < sizeof(nc_writes)/sizeof(nc_writes[0]); i++)
+  if (!g3_gw(nc_writes[i].reg, nc_writes[i].val)) { fail_step = "nc-writes"; goto fail; }
+
+ /* Self-test CP_MEM_WRITE to unused scratch slot G3_FENCE_PA + 8. */
+ uint32_t sentinel = 0x5a730001u ^ (guilty_vm ? guilty_vm->seq : 0u);
+ g_wr(G3_FENCE_PA, 8, 0);
+ g3_emit(g3_pkt7(0x3d, 3)); g3_emit(G3_FENCE_VA + 8); g3_emit(0); g3_emit(sentinel);
+ g3_emit(g3_pkt7(0x26, 0));
+ g3_wptr &= 8191;
+ __asm__ volatile("dsb sy" ::: "memory");
+ if (!g3_gw(0x807, g3_wptr)) { fail_step = "selftest-wptr"; goto fail; }
+ unsigned ok = 0;
+ for (unsigned i = 0; i < 2000; i++) {
+  if (g3_read(G3_FENCE_PA + 8) == sentinel && g3_gr(0x806) == g3_wptr && !(g3_gr(0x210) & ~1u) &&
+      !fg_access_failed && !g3_faulted()) { ok = 1; break; }
+  if (fg_access_failed || g3_faulted()) { fail_step = "selftest-fault"; goto fail; }
+  delay(5);
+ }
+ if (!ok || fg_access_failed || g3_faulted()) {
+  if (!fail_step) fail_step = (fg_access_failed || g3_faulted()) ? "selftest-fault" : "selftest-timeout";
+  goto fail;
+ }
+
+ /* Restore backboardd VM (if live) and fence IRQ if previously armed. */
+ if (fg_bb_vm && fg_bb_vm->in_use && !fg_bb_vm->poisoned) {
+  if (!fg_abi_switch_vm(fg_bb_vm)) { fail_step = "restore-bb-vm"; goto fail; }
+ }
+ if (!fg_irq_rearm_soft()) { fail_step = "irq-rearm"; goto fail; }
+ if (fg_soft_recover_count <= 8) {
+  printf("FUXI GPU RECOVER: hw_ok rbbm_halt=%u pre(fsr=%#x cp=%#x rbbm=%#x) rst(fsr=%#x cp=%#x rbbm=%#x) sqe(fsr=%#x cp=%#x rbbm=%#x)\n",
+      rbbm_halt_ack, fsr_pre, cp_pre, rbbm_pre, fsr_rst, cp_rst, rbbm_rst, fsr_sqe, cp_sqe, rbbm_sqe);
+ }
+ return 1;
+fail:
+ fg_irq_quiesce();
+ printf("FUXI GPU RECOVER: hw_fail step=%s rbbm_halt=%u pre(fsr=%#x cp=%#x rbbm=%#x) rst(fsr=%#x cp=%#x rbbm=%#x) sqe(fsr=%#x cp=%#x rbbm=%#x) acc=%u\n",
+     fail_step ? fail_step : "unknown", rbbm_halt_ack, fsr_pre, cp_pre, rbbm_pre, fsr_rst, cp_rst, rbbm_rst, fsr_sqe, cp_sqe, rbbm_sqe, fg_access_failed);
+ return 0;
+}
+#define FG_SOFT_RECOVER_HW(vm) fg_soft_recover_hw(vm)
+#else
+static int fg_soft_recover_fail_model;
+static unsigned fg_soft_recover_calls;
+static int fg_soft_recover_hw(struct fuxi_gpu_vm *guilty_vm)
+{
+ (void)guilty_vm;
+ fg_soft_recover_calls++;
+ if (fg_soft_recover_fail_model) return 0;
+ fault = 0;
+ fg_access_failed = 0;
+ g3_wptr = 0;
+ (void)g3_gw(0x806, 0);
+ (void)g3_gw(0x807, 0);
+ (void)g3_gw(0x210, 0);
+ if (fg_suspends != UINT64_MAX) ++fg_suspends;
+ return 1;
+}
+#define FG_SOFT_RECOVER_HW(vm) fg_soft_recover_hw(vm)
+#endif
+#endif
