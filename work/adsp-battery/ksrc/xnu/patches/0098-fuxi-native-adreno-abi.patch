+enum { FG_DDS_FLIPS, FG_DDS_COPIES, FG_DDS_MAPS, FG_DDS_REMAPS, FG_DDS_HITS, FG_DDS_TLBI, FG_DDS_FSR, FG_DDS_EVICTS, FG_DDS_LATE, FG_DDS_ONTIME,
