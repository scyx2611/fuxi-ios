+ if (fg_dd_fetch < FG_DD_SLOTS_N) m |= 1u << fg_dd_fetch;
+ if (fg_scanout_back_ready && fg_scanout_ready >= 3 && fg_scanout_ready < 3 + FG_DD_SLOTS_N) m |= 1u << (fg_scanout_ready - 3);
