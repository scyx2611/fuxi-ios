+ for (unsigned y = 0; y < 2400u; y++) {
+  if (y == y0) y = y0 + h;
+  for (unsigned x = 0; x < 1080u; x++) ((volatile uint32_t *)pixels)[y*1080u + x] = 0xff000000u;
