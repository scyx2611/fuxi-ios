+static void fg_abi_stall_done(void)
+{
+ fg_abi_stall_stats[fg_abi_stage==1 ? 5 : 6]++;
+ fg_abi_stall_log(fg_abi_stage==1 ? "completed after WPTR kick" : "completed after bus drain");
+ fg_abi_stage=0;
