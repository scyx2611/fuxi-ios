+  vm->pt_slabs[i].handle = NULL;
+  vm->pt_slabs[i].va = NULL;
+  vm->pt_slabs[i].pa = 0;
+ }
+ vm->pt_slab_count = 0;
+ vm->pt_next_slot = 0;
+}
