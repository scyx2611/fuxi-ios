+int sns_compass_encode_persisted_bias(const int32_t bias_q16[3], uint8_t out[SNS_COMPASS_PERSIST_BYTES]);
+int sns_compass_decode_persisted_bias(const uint8_t in[SNS_COMPASS_PERSIST_BYTES], int32_t bias_q16[3]);
