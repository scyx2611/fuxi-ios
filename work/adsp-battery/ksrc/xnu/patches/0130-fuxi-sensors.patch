+    static const SsrOps kOps = {
+        .context = NULL,
+        .now_ms = rpc_now_ms,
+        .send = rpc_op_send,
+        .wait = rpc_op_wait,
+        .trace = rpc_op_trace,
+        .publish = rpc_op_publish,
+        .prepare = rpc_op_prepare,
+        .pack_size = rpc_op_pack_size,
+        .pack_read = rpc_op_pack_read,
+        .alloc = rpc_op_alloc,
