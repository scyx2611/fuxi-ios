+static const SnsHidKind kKinds[SNS_HID_KINDS] = {
+    {0xff00, 0x03, "Pagani Accelerometer", 0},
+    {0xff00, 0x09, "Pagani Gyroscope", 0},
+    {0xff00, 0x0a, "Pagani Compass", 0},
