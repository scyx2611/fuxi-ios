+static void
+on_hid_demand(unsigned kind, uint32_t demand)
+{
+    if (kind >= SNS_HID_KINDS) return;
+    __atomic_store_n(&gDemand[kind], demand, __ATOMIC_RELEASE);
+    __atomic_fetch_or(&gDemandDirty, 1u << kind, __ATOMIC_RELEASE);
+    fs_wake(kEvDemand);
+}
