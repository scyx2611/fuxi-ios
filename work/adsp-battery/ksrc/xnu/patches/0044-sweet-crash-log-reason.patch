 #include <pexpert/pexpert.h>
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <pexpert/device_tree.h>
+
+unsigned fuxi_media_exit_enabled(void);
+
+unsigned
+fuxi_media_exit_enabled(void)
+{
+	static int cached = -1;
+	int cur = __atomic_load_n(&cached, __ATOMIC_RELAXED);
+	unsigned mode = 0;
+	DTEntry chosen;
+	const void *prop = NULL;
+	unsigned int bytes = 0;
+
+	if (cur >= 0) {
+		return (unsigned)cur;
+	}
+	if (!PE_parse_boot_argn("fuximediaexit", &mode, sizeof(mode))) {
+		mode = 0;
+		if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+		    SecureDTGetProperty(chosen, "fuxi,media-exit-trace", &prop, &bytes) == kSuccess &&
+		    prop != NULL && bytes == sizeof(uint32_t)) {
+			memcpy(&mode, prop, sizeof(mode));
+		}
+	}
+	mode = mode != 0 ? 1u : 0u;
+	__atomic_store_n(&cached, (int)mode, __ATOMIC_RELAXED);
+	return mode;
+}
+
+/* 0: ignore, 1: media/WebKit target, 2: lskdd (tight cap)；kern_sig.c 的 SIGKILL 送出者追蹤共用 */
+unsigned fuxi_media_exit_kind(const char *name);
+
+unsigned
+fuxi_media_exit_kind(const char *name)
+{
+	if (name == NULL) {
+		return 0;
+	}
+	if (strcmp(name, "mediaserverd") == 0 ||
+	    strcmp(name, "MobileSafari") == 0 ||
+	    strcmp(name, "audiomxd") == 0 ||
+	    strncmp(name, "VTDecoderXPC", 12) == 0 ||
+	    strncmp(name, "com.apple.WebKit", 16) == 0) {
+		return 1;
+	}
+	if (strcmp(name, "lskdd") == 0) {
+		return 2;
+	}
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
