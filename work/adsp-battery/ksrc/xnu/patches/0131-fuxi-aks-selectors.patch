+static const char sweet_aks_bag_uuid_key[] = "SWEET AKS fuxi bag uuid, v1";
+
+/* Selector 23 (kAKSBagUUID): deterministic 16-byte UUID from /chosen/unique-chip-id. */
+static IOReturn
+sweet_aks_bag_uuid(IOExternalMethodArguments *args)
+{
+	DTEntry chosen;
+	void const *prop = NULL;
+	unsigned int bytes = 0;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "unique-chip-id", &prop, &bytes) != kSuccess ||
+	    prop == NULL || bytes == 0) {
+		return kIOReturnError;
+	}
+
+	uint8_t chip_id[32];
+	uint32_t chip_len = bytes > sizeof(chip_id) ? (uint32_t)sizeof(chip_id) : bytes;
+	memcpy(chip_id, prop, chip_len);
+
+	uint8_t digest[CCSHA256_OUTPUT_SIZE];
+	cchmac(ccsha256_di(), sizeof(sweet_aks_bag_uuid_key) - 1,
+	    sweet_aks_bag_uuid_key, chip_len, chip_id, digest);
+	IOReturn ret = sweet_aks_struct_out(args, digest, 16);
+	cc_clear(sizeof(chip_id), chip_id);
+	cc_clear(sizeof(digest), digest);
+	return ret;
+}
