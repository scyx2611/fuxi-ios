+} gMic;
+
+static void mic_unmap_regions(void)
+{
+    for (unsigned i = 0; i < 6u; i++) {
+        struct fuxi_mic_region *r = &gMicRegions[i];
+        if (r->map_va) {
+            pmap_remove(kernel_pmap, r->map_va, r->map_va + r->map_size);
+            kmem_free(kernel_map, r->map_va, r->map_size);
+            r->map_va = 0;
+            r->map_size = 0;
+            r->va = 0;
+        }
+    }
+    gMic.regions_mapped = false;
+}
+
+static bool mic_map_regions(void)
+{
+    for (unsigned i = 0; i < 6u; i++) {
+        struct fuxi_mic_region *r = &gMicRegions[i];
+        uint64_t page_pa = r->pa & ~(uint64_t)PAGE_MASK;
+        vm_size_t page_off = (vm_size_t)(r->pa - page_pa);
+        vm_size_t map_size = (page_off + r->size + PAGE_MASK) & ~(vm_size_t)PAGE_MASK;
+        vm_offset_t map_va = 0;
+        kern_return_t kr = kmem_alloc(kernel_map, &map_va, map_size,
+            KMA_VAONLY | KMA_KOBJECT | KMA_NOPAGEWAIT, VM_KERN_MEMORY_IOKIT);
+        if (kr != KERN_SUCCESS) {
+            mic_unmap_regions();
+            return false;
+        }
+        for (vm_size_t off = 0; off < map_size; off += PAGE_SIZE) {
+            kr = pmap_enter_options_addr(kernel_pmap, map_va + off, page_pa + off,
+                VM_PROT_READ | VM_PROT_WRITE, VM_PROT_NONE, VM_WIMG_IO, TRUE, PMAP_OPTIONS_NOWAIT, NULL);
+            if (kr != KERN_SUCCESS) {
+                pmap_remove(kernel_pmap, map_va, map_va + map_size);
+                kmem_free(kernel_map, map_va, map_size);
+                mic_unmap_regions();
+                return false;
+            }
+        }
+        r->map_va = map_va;
+        r->map_size = map_size;
+        r->va = map_va + page_off;
+    }
+    gMic.regions_mapped = true;
+    return true;
+}
+
+static vm_offset_t mic_lookup_va(uint64_t pa)
+{
+    if ((pa & 3u) != 0u) return 0;
+    for (unsigned i = 0; i < 6u; i++) {
+        const struct fuxi_mic_region *r = &gMicRegions[i];
+        if (r->va && pa >= r->pa && pa + 4u <= r->pa + r->size) {
+            return r->va + (vm_offset_t)(pa - r->pa);
+        }
+    }
+    return 0;
+}
+
+static uint32_t mic_mmio_rd(void *ctx, uint64_t pa, uint32_t *faulted)
+{
+    (void)ctx;
+    vm_offset_t va = mic_lookup_va(pa);
+    if (!va) {
+        if (faulted) *faulted = 1u;
+        return 0;
+    }
+    uint32_t v = *(volatile uint32_t *)va;
+    __asm__ volatile("dmb oshld" ::: "memory");
+    if (faulted) *faulted = 0u;
+    return v;
+}
+
+static unsigned mic_mmio_wr(void *ctx, uint64_t pa, uint32_t value)
+{
+    (void)ctx;
+    vm_offset_t va = mic_lookup_va(pa);
+    if (!va) return 1u;
+    __asm__ volatile("dmb oshst" ::: "memory");
+    *(volatile uint32_t *)va = value;
+    __asm__ volatile("dmb oshst" ::: "memory");
+    return 0u;
+}
+
+static void mic_delay_us(void *ctx, uint32_t us)
+{
+    (void)ctx;
+    if (us < 1000u) {
+        delay(us);
+    } else {
+        IOSleep(us / 1000u);
+    }
+}
