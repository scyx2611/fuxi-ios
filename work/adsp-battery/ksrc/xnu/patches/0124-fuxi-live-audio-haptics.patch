+/* 從待機（ampToneDownEx 後 GLOBAL_EN=0、BST_EN=0、AMP_EN=0、0x4800=0）喚醒下方功放。
+ * 參考小米 cs35l41.c cs35l41_main_amp_event(POST_PMU)：先確認無致命故障並清除待機期鎖存的
+ * PLL_UNLOCK，在 GLOBAL_EN=0 狀態先設好數位靜音與目標類比增益（含 ZC），依序開 ASP_RX1 -> BST_EN -> AMP_EN，
+ * 再執行 ampTonePowerUp（pup_patch＋GLOBAL_EN＋PUP_DONE＋PLL_LOCK）。 */
+static int ampLiveWake(uint8_t address, uint32_t gain, unsigned *pup_ms, uint32_t *status3, uint32_t status[4])
+{
+    for (unsigned i = 0; i < 4; i++) {
+        if (!ampRead(address, FM_IRQ1_STATUS1 + 4u * i, &status[i])) return 0;
+    }
+    if ((status[0] & FM_TONE_ERRORS) || (status[2] & FM_OTP_BOOT_ERR)) {
+        printf("FUXI AMP: live wake refused fault irq1=%#x/%#x/%#x/%#x\n",
+            status[0], status[1], status[2], status[3]);
+        return 0;
+    }
+    for (unsigned i = 0; i < 4; i++) {
+        if (status[i] && !ampWrite32(address, FM_IRQ1_STATUS1 + 4u * i, status[i])) return 0;
+    }
+    if (!ampSet(address, FM_DIG_VOL, FUXI_AUDIO_DIG_VOL_MUTE) ||
+        !ampSet(address, FM_AMP_GAIN, (gain << 5) | FM_AMP_GAIN_ZC)) return 0;
+    if (!ampSet(address, 0x4800, 0x10000) || !ampSet(address, FM_PWR_CTRL2, 0x20)) return 0;
+    IOSleep(1);
+    if (!ampSet(address, FM_PWR_CTRL2, 0x21)) return 0;
+    IOSleep(1);
+    if (!ampTonePowerUp(address, pup_ms, status3)) return 0;
+    return ampToneCheck(address, status);
+}
