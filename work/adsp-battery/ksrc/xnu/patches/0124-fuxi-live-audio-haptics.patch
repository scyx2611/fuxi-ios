+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* FUXI 即時喇叭音訊串流（ADT fuxi,amp=8 搭配 fuxi,audio-spf=6）：
+ * - 64 KiB 48 kHz 16-bit 立體聲環形緩衝（341 ms），由 FuxiAudio.driver 經 kern.fuxiaudiopcm 寫入，
+ *   由 fuxi_audio_spf.c 每 20 ms 週期轉為 4-slot 32-bit TDM 餵給 ADSP AudioReach。
+ * - 音量與播放狀態由 kern.fuxiaudiovol 傳入，映射到 CS35L41 AMP_DIG_VOL_CTRL（0x6000，2 ms 軟斜坡），
+ *   數位上限硬夾在 <= 0 dB、類比增益硬夾在 <= 18（19.0 dB，不超過小米原廠 Android 值）。
+ * - 參考：work/adsp-battery/ref-xiaomi-cirrus-92a9fde479/cs35l41.c (cs35l41_set_vol) 與
+ *   work/adsp-battery/android-audio-config-1117/odm/etc/audio/sku_kalama/mixer_paths_overlay_static.xml。 */
+#ifndef FUXI_AUDIO_STREAM_H
+#define FUXI_AUDIO_STREAM_H
+
+#include <stdint.h>
+
+enum {
+    FUXI_AUDIO_RING_FRAMES = 16384u, /* 16384 frames * 4 B = 64 KiB (341.3 ms @ 48 kHz) */
+    FUXI_AUDIO_RING_MASK = FUXI_AUDIO_RING_FRAMES - 1u,
+    FUXI_AUDIO_VOL_MAX_MILLI = 1000u,
+    FUXI_AUDIO_VOL_ACTIVE_BIT = 0x80000000u,
+    FUXI_AUDIO_GAIN_DEFAULT = 12u,   /* 12.5 dB 類比增益（原廠保護模式為 18 = 19.0 dB） */
+    FUXI_AUDIO_GAIN_MAX = 18u,       /* 絕不超過原廠 18 */
+    FUXI_AUDIO_MAX_DB_DEFAULT = -12, /* 預設數位上限 -12 dB，確保首次耳聽安全 */
+    FUXI_AUDIO_DIG_VOL_MUTE = 0xa67bu, /* -102 dB + 2 ms 軟斜坡 (VOL_RAMP=3)，消除靜音／待機切斷爆音 */
+    FUXI_AUDIO_CHIME_FRAMES = 19200u, /* 400 ms @ 48 kHz */
+    FUXI_AUDIO_CHIME_FADE = 1440u,    /* 30 ms 淡入淡出 */
+    FUXI_AUDIO_IDLE_MUTE_MS = 2000u,  /* 靜音超過 2 秒自動將 0x6000 切回靜音 */
+    FUXI_AUDIO_IDLE_PDN_MIN_MS = 200u,
+    FUXI_AUDIO_STOP_PDN_MS = 200u,    /* StopIO（active==0）後靜音 160 ms + 40 ms 斜坡快速下電，避免重開機爆音 */
+    FUXI_AUDIO_IDLE_PDN_DEFAULT_MS = 2500u,
+    FUXI_AUDIO_IDLE_PDN_MAX_MS = 60000u,
+    FUXI_AUDIO_IDLE_PDN_RAMP_MS = 40u, /* 數位靜音後至少留 40 ms 軟斜坡＋排空再下電 */
+    FUXI_AUDIO_PRIME_FRAMES = 2880u,  /* 60 ms 預緩衝（3 個 TDM 週期，對齊 FUXI_TONE_AHEAD） */
+    FUXI_AUDIO_MAX_LATENCY_FRAMES = 9600u, /* 200 ms 延遲上限，容納 2048 幀批次與排程抖動 */
+    FUXI_AUDIO_TRIM_TARGET_FRAMES = 4800u, /* 超出上限時裁回 100 ms（高於預緩衝避免裁切後欠載） */
+    FUXI_AUDIO_FADE_FRAMES = 32u,     /* ~0.67 ms 邊界淡入淡出，消除起停／欠載 DC 爆音 */
+    FUXI_AUDIO_WAKE_HOLD_PERIODS = 2u, /* 功放待機喚醒期間最多暫緩消耗 2 個 TDM 週期（40 ms），防止 5 ms 提示音被截頭 */
+};
+
+enum fuxi_amp_power_action {
+    FUXI_AMP_ACT_NONE = 0,
+    FUXI_AMP_ACT_STANDBY = 1,
+    FUXI_AMP_ACT_WAKE = 2,
+};
+
+typedef struct {
+    int powered;
+    int prev_active;
+    int muted;
+    uint64_t prev_last_nz;
+    uint64_t last_activity_ns;
+    uint64_t muted_since_ns;
+    uint32_t pdn_count;
+    uint32_t wake_count;
+} FuxiAmpPowerState;
+
+static inline uint32_t fuxi_audio_clamp_idle_pdn_ms(uint32_t raw)
+{
+    if (!raw) {
+        return 0u;
+    }
+    if (raw == 1u) {
+        return FUXI_AUDIO_IDLE_PDN_DEFAULT_MS;
+    }
+    if (raw < FUXI_AUDIO_IDLE_PDN_MIN_MS) {
+        return FUXI_AUDIO_IDLE_PDN_MIN_MS;
+    }
+    if (raw > FUXI_AUDIO_IDLE_PDN_MAX_MS) {
+        return FUXI_AUDIO_IDLE_PDN_MAX_MS;
+    }
+    return raw;
+}
+
+static inline void fuxi_amp_power_init(FuxiAmpPowerState *st, uint64_t start_ns,
+    int active, uint64_t last_nz, int start_muted)
+{
+    st->powered = 1;
+    st->prev_active = active ? 1 : 0;
+    st->muted = start_muted ? 1 : 0;
+    st->prev_last_nz = last_nz;
+    st->last_activity_ns = start_ns;
+    st->muted_since_ns = start_muted ? start_ns : 0ull;
+    st->pdn_count = 0u;
+    st->wake_count = 0u;
+}
+
+/* 決策 CS35L41 即時播放迴圈的靜音、閒置類比下電（ampToneDown）與快速喚醒（ampLiveWake）。
+ * idle_pdn_ms == 0 時完全沿用舊有純數位靜音行為，不觸發 STANDBY／WAKE。 */
+static inline enum fuxi_amp_power_action fuxi_amp_power_step(FuxiAmpPowerState *st,
+    uint64_t now_ns, int in_chime, int active, uint64_t last_nz,
+    uint32_t idle_pdn_ms, int *want_unmute_out)
+{
+    const int recent_audio = last_nz != 0 && now_ns >= last_nz &&
+        (now_ns - last_nz) < (uint64_t)FUXI_AUDIO_IDLE_MUTE_MS * 1000000ull;
+    if (!idle_pdn_ms) {
+        st->prev_active = active ? 1 : 0;
+        st->prev_last_nz = last_nz;
+        *want_unmute_out = (in_chime || active || recent_audio) ? 1 : 0;
+        return FUXI_AMP_ACT_NONE;
+    }
+    const int new_nz = (last_nz != 0 && last_nz != st->prev_last_nz);
+    const int active_edge = (active && !st->prev_active);
+    st->prev_active = active ? 1 : 0;
+    st->prev_last_nz = last_nz;
+    if (in_chime || new_nz || active_edge) {
+        st->last_activity_ns = now_ns;
+    }
+    if (!st->powered) {
+        if (in_chime || new_nz || active_edge) {
+            st->muted = 0;
+            st->muted_since_ns = 0ull;
+            *want_unmute_out = 1;
+            return FUXI_AMP_ACT_WAKE;
+        }
+        *want_unmute_out = 0;
+        return FUXI_AMP_ACT_NONE;
+    }
+    const uint64_t silent_ns = now_ns >= st->last_activity_ns ? (now_ns - st->last_activity_ns) : 0ull;
+    const uint32_t eff_pdn_ms = (!active && idle_pdn_ms > FUXI_AUDIO_STOP_PDN_MS)
+        ? FUXI_AUDIO_STOP_PDN_MS : idle_pdn_ms;
+    const uint32_t eff_mute_ms = eff_pdn_ms > FUXI_AUDIO_IDLE_PDN_RAMP_MS
+        ? (eff_pdn_ms - FUXI_AUDIO_IDLE_PDN_RAMP_MS) : 0u;
+    const uint32_t mute_ms = eff_mute_ms < FUXI_AUDIO_IDLE_MUTE_MS ? eff_mute_ms : FUXI_AUDIO_IDLE_MUTE_MS;
+    const int want_unmute = (in_chime || silent_ns < (uint64_t)mute_ms * 1000000ull) ? 1 : 0;
+    *want_unmute_out = want_unmute;
+    if (want_unmute) {
+        st->muted = 0;
+        st->muted_since_ns = 0ull;
+        return FUXI_AMP_ACT_NONE;
+    }
+    if (!st->muted) {
+        st->muted = 1;
+        st->muted_since_ns = now_ns;
+        return FUXI_AMP_ACT_NONE;
+    }
+    if (now_ns >= st->muted_since_ns &&
+        (now_ns - st->muted_since_ns) >= (uint64_t)FUXI_AUDIO_IDLE_PDN_RAMP_MS * 1000000ull &&
+        silent_ns >= (uint64_t)eff_pdn_ms * 1000000ull) {
+        return FUXI_AMP_ACT_STANDBY;
+    }
+    return FUXI_AMP_ACT_NONE;
+}
+
+typedef struct {
+    uint32_t read_pos;
+    uint32_t write_pos;
+    uint32_t writes;
+    uint32_t underruns;
+    uint32_t overflows;
+    uint32_t nonzero_periods;
+    uint32_t primed;
+    uint32_t max_used;
+    uint32_t has_nonzero;
+    uint32_t last_nz_end;
+    int16_t samples[FUXI_AUDIO_RING_FRAMES * 2u];
+} FuxiAudioRing;
+
+/* 封裝 kern.fuxiaudiovol：bit 31 = active，bits 0..15 = volume_milli (0..1000)。 */
+static inline uint32_t fuxi_audio_vol_pack(uint32_t volume_milli, int active)
+{
+    if (volume_milli > FUXI_AUDIO_VOL_MAX_MILLI) {
+        volume_milli = FUXI_AUDIO_VOL_MAX_MILLI;
+    }
+    return volume_milli | (active ? FUXI_AUDIO_VOL_ACTIVE_BIT : 0u);
+}
+
+static inline uint32_t fuxi_audio_vol_milli(uint32_t packed)
+{
+    uint32_t milli = packed & 0xffffu;
+    return milli > FUXI_AUDIO_VOL_MAX_MILLI ? FUXI_AUDIO_VOL_MAX_MILLI : milli;
+}
+
+static inline int fuxi_audio_vol_active(uint32_t packed)
+{
+    return (packed & FUXI_AUDIO_VOL_ACTIVE_BIT) != 0;
+}
+
+/* 將 iOS 音量（0..1000）轉成 CS35L41 AMP_DIG_VOL_CTRL（0x6000）暫存器值。
+ * max_db_x8 為上限（1/8 dB 單位，必須 <= 0；高於 0 強制夾回 0 dB）。
+ * 低階 3 bit 設 3（2 ms 軟斜坡，與小米原廠 mixer_paths_overlay_static.xml 一致）。 */
+static inline uint32_t fuxi_audio_volume_to_reg(uint32_t volume_milli, int max_db_x8)
+{
+    if (!volume_milli) {
+        return FUXI_AUDIO_DIG_VOL_MUTE;
+    }
+    if (volume_milli > FUXI_AUDIO_VOL_MAX_MILLI) {
+        volume_milli = FUXI_AUDIO_VOL_MAX_MILLI;
+    }
+    if (max_db_x8 > 0) {
+        max_db_x8 = 0;
+    }
+    if (max_db_x8 < -384) {
+        max_db_x8 = -384;
+    }
+    /* 線性映射 1..1000 到 -48 dB (-384) .. max_db_x8 */
+    int span = 384 + max_db_x8;
+    int atten_x8 = -384 + (int)(((uint64_t)volume_milli * (uint64_t)span + 500u) / 1000u);
+    if (atten_x8 < -816) {
+        atten_x8 = -816;
+    }
+    if (atten_x8 > max_db_x8) {
+        atten_x8 = max_db_x8;
+    }
+    uint32_t code = ((uint32_t)atten_x8) & 0x7ffu;
+    return 0x8000u | (code << 3) | 3u;
+}
+
+static inline uint32_t fuxi_audio_clamp_gain(uint32_t gain)
+{
+    return gain > FUXI_AUDIO_GAIN_MAX ? FUXI_AUDIO_GAIN_MAX : gain;
+}
+
+static inline uint32_t fuxi_audio_ring_used(const FuxiAudioRing *ring)
+{
+    return ring ? (ring->write_pos - ring->read_pos) : 0u;
+}
+
+static inline uint32_t fuxi_audio_ring_has_nonzero(const FuxiAudioRing *ring)
+{
+    return (ring && ring->has_nonzero &&
+        (int32_t)(ring->last_nz_end - ring->read_pos) > 0) ? 1u : 0u;
+}
+
+/* 判斷本次 TDM 週期是否應先送靜音而不消耗環形緩衝，等 CS35L41 離開待機上電並解靜音。
+ * 最多連續暫緩 FUXI_AUDIO_WAKE_HOLD_PERIODS 個週期，避免異常時永久卡住排空。 */
+static inline int fuxi_audio_should_hold_for_wake(uint32_t amp_awake, uint32_t ring_avail, uint32_t *hold_count)
+{
+    if (amp_awake || !ring_avail) {
+        if (hold_count) {
+            *hold_count = 0u;
+        }
+        return 0;
+    }
+    if (hold_count && *hold_count < FUXI_AUDIO_WAKE_HOLD_PERIODS) {
+        (*hold_count)++;
+        return 1;
+    }
+    return 0;
+}
+
+static inline void fuxi_audio_pcm_peaks(const int16_t *pcm, uint32_t frames, uint32_t *left_peak, uint32_t *right_peak)
+{
+    uint32_t lpk = 0u, rpk = 0u;
+    if (pcm) {
+        for (uint32_t i = 0; i < frames; i++) {
+            int32_t l = pcm[i * 2u];
+            int32_t r = pcm[i * 2u + 1u];
+            uint32_t al = (uint32_t)(l < 0 ? -l : l);
+            uint32_t ar = (uint32_t)(r < 0 ? -r : r);
+            if (al > lpk) lpk = al;
+            if (ar > rpk) rpk = ar;
+        }
+    }
+    if (left_peak) *left_peak = lpk;
+    if (right_peak) *right_peak = rpk;
+}
+
+/* 寫入 stereo int16 PCM。若緩衝滿則丟棄最舊樣點，避免延遲越積越大。回傳是否含非零樣點。 */
+static inline int fuxi_audio_ring_write(FuxiAudioRing *ring, const int16_t *pcm, uint32_t frames)
+{
+    if (!ring || !pcm || !frames) {
+        return 0;
+    }
+    if (frames > FUXI_AUDIO_RING_FRAMES) {
+        pcm += (frames - FUXI_AUDIO_RING_FRAMES) * 2u;
+        frames = FUXI_AUDIO_RING_FRAMES;
+        ring->overflows++;
+    }
+    uint32_t used = ring->write_pos - ring->read_pos;
+    if (used + frames > FUXI_AUDIO_RING_FRAMES) {
+        ring->read_pos = ring->write_pos + frames - FUXI_AUDIO_RING_FRAMES;
+        ring->overflows++;
+    }
+    int nonzero = 0;
+    uint32_t pos = ring->write_pos;
+    uint32_t last_nz = 0u;
+    for (uint32_t i = 0; i < frames; i++) {
+        uint32_t slot = (pos + i) & FUXI_AUDIO_RING_MASK;
+        int16_t left = pcm[i * 2u];
+        int16_t right = pcm[i * 2u + 1u];
+        ring->samples[slot * 2u] = left;
+        ring->samples[slot * 2u + 1u] = right;
+        if (left || right) {
+            nonzero = 1;
+            last_nz = pos + i + 1u;
+        }
+    }
+    ring->write_pos = pos + frames;
+    if (nonzero) {
+        ring->has_nonzero = 1u;
+        ring->last_nz_end = last_nz;
+    }
+    uint32_t after = ring->write_pos - ring->read_pos;
+    if (after > ring->max_used) {
+        ring->max_used = after;
+    }
+    if (after > FUXI_AUDIO_MAX_LATENCY_FRAMES) {
+        ring->read_pos = ring->write_pos - FUXI_AUDIO_TRIM_TARGET_FRAMES;
+        ring->overflows++;
+    }
+    if (ring->has_nonzero && (int32_t)(ring->last_nz_end - ring->read_pos) <= 0) {
+        ring->has_nonzero = 0u;
+    }
+    ring->writes++;
+    return nonzero;
+}
+
+/* 讀取 frames 筆 stereo int16 轉成 4-slot 32-bit TDM。
+ * stereo_slots == 0：單下方喇叭模式，將 (L+R)/2 填進四個槽（避免左聲道漏聽）。
+ * stereo_slots != 0：立體聲，slot 0/2 = L、slot 1/3 = R。
+ * 回傳非零 frame 數。 */
+static inline uint32_t fuxi_audio_ring_read_tdm(FuxiAudioRing *ring, volatile uint32_t *tdm_out,
+    uint32_t frames, int stereo_slots, int active)
+{
+    if (!tdm_out || !frames) {
+        return 0;
+    }
+    uint32_t avail = ring ? (ring->write_pos - ring->read_pos) : 0u;
+    int fade_in = 0;
+    if (ring && !ring->primed) {
+        if (avail >= FUXI_AUDIO_PRIME_FRAMES || (avail > 0u && !active)) {
+            ring->primed = 1u;
+            fade_in = 1;
+        } else {
+            for (uint32_t i = 0; i < frames; i++) {
+                tdm_out[i * 4u + 0u] = 0u;
+                tdm_out[i * 4u + 1u] = 0u;
+                tdm_out[i * 4u + 2u] = 0u;
+                tdm_out[i * 4u + 3u] = 0u;
+            }
+            return 0u;
+        }
+    }
+    uint32_t take = avail < frames ? avail : frames;
+    int fade_out = ring && take < frames;
+    uint32_t fo_len = take < FUXI_AUDIO_FADE_FRAMES ? take : FUXI_AUDIO_FADE_FRAMES;
+    uint32_t fi_len = take < FUXI_AUDIO_FADE_FRAMES ? take : FUXI_AUDIO_FADE_FRAMES;
+    uint32_t nonzero = 0;
+    uint32_t pos = ring ? ring->read_pos : 0u;
+    for (uint32_t i = 0; i < take; i++) {
+        uint32_t idx = (pos + i) & FUXI_AUDIO_RING_MASK;
+        int32_t left = ring->samples[idx * 2u];
+        int32_t right = ring->samples[idx * 2u + 1u];
+        if (fade_in && i < fi_len) {
+            left = (left * (int32_t)i) / (int32_t)fi_len;
+            right = (right * (int32_t)i) / (int32_t)fi_len;
+        }
+        if (fade_out && i >= take - fo_len) {
+            int32_t rem = (int32_t)(take - 1u - i);
+            left = (left * rem) / (int32_t)fo_len;
+            right = (right * rem) / (int32_t)fo_len;
+        }
+        if (left || right) {
+            nonzero++;
+        }
+        if (stereo_slots) {
+            uint32_t sl = (uint32_t)(left << 16);
+            uint32_t sr = (uint32_t)(right << 16);
+            tdm_out[i * 4u + 0u] = sl;
+            tdm_out[i * 4u + 1u] = sr;
+            tdm_out[i * 4u + 2u] = sl;
+            tdm_out[i * 4u + 3u] = sr;
+        } else {
+            int32_t mono = (left + right) >> 1;
+            uint32_t sm = (uint32_t)(mono << 16);
+            tdm_out[i * 4u + 0u] = sm;
+            tdm_out[i * 4u + 1u] = sm;
+            tdm_out[i * 4u + 2u] = sm;
+            tdm_out[i * 4u + 3u] = sm;
+        }
+    }
+    if (ring) {
+        ring->read_pos = pos + take;
+        if (ring->has_nonzero && (int32_t)(ring->last_nz_end - ring->read_pos) <= 0) {
+            ring->has_nonzero = 0u;
+        }
+        if (take < frames) {
+            ring->primed = 0u;
+            if (active) {
+                ring->underruns++;
+            }
+        }
+        if (nonzero) {
+            ring->nonzero_periods++;
+        }
+    }
+    for (uint32_t i = take; i < frames; i++) {
+        tdm_out[i * 4u + 0u] = 0u;
+        tdm_out[i * 4u + 1u] = 0u;
+        tdm_out[i * 4u + 2u] = 0u;
+        tdm_out[i * 4u + 3u] = 0u;
+    }
+    return nonzero;
+}
+
+/* 800 Hz（48000 / 60）柔和開機驗證音（-18 dBFS，400 ms，前後 30 ms 淡入淡出）。 */
+static inline int32_t fuxi_audio_chime_sample(uint32_t frame)
+{
+    static const int32_t sine60[60] = {
+        0, 28263301, 56217121, 83555377, 109978754, 135197954, 158937860, 180940587,
+        200968341, 218805975, 234263218, 247176430, 257410085, 264857867, 269443359, 271120312,
+        269872497, 265713571, 258686843, 248864927, 236349257, 221269527, 203782952, 184073390,
+        162350351, 138847949, 113823610, 87556614, 60346519, 32511417,
+        0, -28263301, -56217121, -83555377, -109978754, -135197954, -158937860, -180940587,
+        -200968341, -218805975, -234263218, -247176430, -257410085, -264857867, -269443359, -271120312,
+        -269872497, -265713571, -258686843, -248864927, -236349257, -221269527, -203782952, -184073390,
+        -162350351, -138847949, -113823610, -87556614, -60346519, -32511417
+    };
+    if (frame >= FUXI_AUDIO_CHIME_FRAMES) {
+        return 0;
+    }
+    uint32_t left = FUXI_AUDIO_CHIME_FRAMES - frame;
+    uint32_t gain = frame < FUXI_AUDIO_CHIME_FADE ? frame : left < FUXI_AUDIO_CHIME_FADE ? left : FUXI_AUDIO_CHIME_FADE;
+    return (int32_t)((int64_t)sine60[frame % 60u] * gain / FUXI_AUDIO_CHIME_FADE);
+}
+
+#endif /* FUXI_AUDIO_STREAM_H */
