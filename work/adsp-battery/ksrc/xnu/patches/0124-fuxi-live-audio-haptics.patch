+static void mic_hw_worker(void *arg, wait_result_t wait_result)
+{
+    (void)arg;
+    (void)wait_result;
+    bool ok = fuxi_mic_hw_bringup(&gMic.hw);
+    __atomic_store_n(&gMic.hw_done, ok ? 1u : 2u, __ATOMIC_RELEASE);
+}
+
+static void mic_set_state_bits(uint32_t clear_bits, uint32_t set_bits)
+{
+    uint32_t cur = __atomic_load_n(&gMicState, __ATOMIC_ACQUIRE);
+    __atomic_store_n(&gMicState, (cur & ~clear_bits) | set_bits, __ATOMIC_RELEASE);
+}
+
+static uint32_t mic_next_cmd_token(void)
+{
+    uint32_t tok = FUXI_MIC_CMD_TOKEN_BASE | (uint32_t)(++gMic.cmd_seq & 0xffu);
+    gMic.cmd_token = tok;
+    return tok;
+}
+
+static bool mic_send_cmd(uint32_t opcode, bool is_prm, const uint8_t *packet, uint32_t len)
+{
+    if (!len || !gSpf.channel || !gSpf.up || gGraph.link_lost) return false;
+    if (sheng_adsp_send(gSpf.channel, packet, len) != 0) return false;
+    gMic.cmd_opcode = opcode;
+    gMic.cmd_is_prm = is_prm;
+    gMic.cmd_waiting = true;
+    gMic.cmd_reply_ready = false;
+    gMic.cmd_status = 0;
+    clock_interval_to_deadline(FUXI_MIC_CMD_TIMEOUT_MS, NSEC_PER_MSEC, &gMic.cmd_deadline);
+    return true;
+}
+
+static void mic_fail(const char *why, uint32_t status)
+{
+    printf("FUXI AUDIO MIC: failed at %s status=%#x phase=%u\n", why, status, (unsigned)gMic.phase);
+    mic_set_state_bits(FUXI_MIC_STATE_READY | FUXI_MIC_STATE_CAPTURING, FUXI_MIC_STATE_FAILED);
+    gMic.cmd_waiting = false;
+    gMic.cmd_reply_ready = false;
+    gMic.selftest_active = false;
+    gMic.unmute_pending = false;
+    if (gMic.regions_mapped && gMic.hw.held && __atomic_load_n(&gMic.hw_done, __ATOMIC_ACQUIRE) != 0u) {
+        fuxi_mic_hw_down(&gMic.hw);
+    }
+    if (gSpf.up && !gGraph.link_lost) {
+        if (gMic.cap_opened) { gMic.phase = FUXI_MIC_FAIL_CLOSE_CAP; return; }
+        if (gMic.mic_opened) { gMic.phase = FUXI_MIC_FAIL_CLOSE_MIC; return; }
+        if (gMic.clock_held) { gMic.phase = FUXI_MIC_FAIL_REL_CLK; return; }
+    }
+    if (gMic.regions_mapped && __atomic_load_n(&gMic.hw_done, __ATOMIC_ACQUIRE) != 0u) {
+        mic_unmap_regions();
+    }
+    gMic.phase = FUXI_MIC_FAILED;
+}
+
+static void mic_submit_reads(void)
+{
+    if (!gSpf.channel || !gSpf.up || gGraph.link_lost || !gGraph.map_handle || !gGraph.dma_address) return;
+    while (gMic.in_flight < FUXI_MIC_AHEAD) {
+        uint8_t packet[FUXI_SPF_INTENT_BYTES];
+        uint32_t seq = gMic.read_next;
+        uint32_t slot = seq % FUXI_MIC_SLOTS;
+        uint32_t tok = FUXI_MIC_READ_TOKEN_BASE | (seq & 0xffu);
+        uint64_t addr = gGraph.dma_address + FUXI_MIC_DMA_OFFSET + (uint64_t)slot * FUXI_MIC_PERIOD;
+        uint32_t len = fuxi_ar_read(packet, sizeof(packet), FUXI_SPF_PORT, tok, addr, gGraph.map_handle, FUXI_MIC_PERIOD);
+        if (!len || sheng_adsp_send(gSpf.channel, packet, len) != 0) break;
+        gMic.read_next++;
+        gMic.in_flight++;
+    }
+}
+
+static bool mic_receive(const uint8_t *data, uint32_t length)
+{
+    if (gMic.phase == FUXI_MIC_OFF || gMic.phase == FUXI_MIC_FAILED) return false;
+    if (!data || length > FUXI_SPF_INTENT_BYTES) return false;
+    FuxiArAnswer ans;
+    int kind = fuxi_ar_parse(data, length, &ans);
+    if (kind <= 0) return false;
+    if ((ans.token & 0xffffff00u) == FUXI_MIC_CMD_TOKEN_BASE) {
+        if (!gMic.cmd_waiting || ans.token != gMic.cmd_token) return true;
+        if (gMic.cmd_is_prm) {
+            if (kind == FuxiArPrmDone || (kind == FuxiArBasicResult && ans.result_opcode == gMic.cmd_opcode && ans.status != 0u)) {
+                gMic.cmd_status = ans.status;
+                gMic.cmd_reply_ready = true;
+            }
+        } else if (kind == FuxiArBasicResult && ans.result_opcode == gMic.cmd_opcode) {
+            gMic.cmd_status = ans.status;
+            gMic.cmd_reply_ready = true;
+        }
+        return true;
+    }
+    if ((ans.token & 0xffffff00u) == FUXI_MIC_READ_TOKEN_BASE) {
+        if (gMic.in_flight > 0u) gMic.in_flight--;
+        gMic.last_read_at = mach_absolute_time();
+        if (kind == FuxiArReadDone && ans.status == 0u && ans.handle == gGraph.map_handle &&
+            ans.address >= gGraph.dma_address + FUXI_MIC_DMA_OFFSET) {
+            uint64_t rel = ans.address - (gGraph.dma_address + FUXI_MIC_DMA_OFFSET);
+            uint32_t slot = (uint32_t)(rel / FUXI_MIC_PERIOD);
+            uint8_t *base = fuxi_audio_dma_buffer();
+            if (base && slot < FUXI_MIC_SLOTS && (rel % FUXI_MIC_PERIOD) == 0u) {
+                uint32_t off = ans.offset < FUXI_MIC_PERIOD ? (ans.offset & ~1u) : 0u;
+                uint32_t max_b = FUXI_MIC_PERIOD - off;
+                uint32_t bytes = ans.data_bytes <= max_b ? ans.data_bytes : max_b;
+                uint32_t count = bytes / 2u;
+                int16_t tmp[FUXI_MIC_PERIOD / 2u];
+                volatile int16_t *src = (volatile int16_t *)(base + FUXI_MIC_DMA_OFFSET + slot * FUXI_MIC_PERIOD + off);
+                __asm__ volatile("dmb oshld" ::: "memory");
+                for (uint32_t i = 0; i < count; i++) {
+                    int16_t s = src[i];
+                    tmp[i] = s;
+                    uint32_t mag = (uint32_t)(s < 0 ? -(int32_t)s : (int32_t)s);
+                    if (gMic.selftest_active) {
+                        if (s != 0) gMic.st_nonzero++;
+                        gMic.st_sum_abs += mag;
+                        if (mag > gMic.st_peak) gMic.st_peak = mag;
+                    } else {
+                        if (mag > gMic.cap_peak) gMic.cap_peak = mag;
+                    }
+                }
+                if (gMic.selftest_active) {
+                    gMic.st_samples += count;
+                } else {
+                    gMic.cap_samples += count;
+                }
+                if (count > 0u && __atomic_load_n(&gMicWanted, __ATOMIC_ACQUIRE)) {
+                    lck_mtx_lock(&gMicRingLock);
+                    (void)fuxi_mic_ring_push(&gMicRing, tmp, count);
+                    lck_mtx_unlock(&gMicRingLock);
+                }
+                gMic.read_done++;
+                gMic.stall_count = 0;
+                return true;
+            }
+        }
+        gMic.read_errors++;
+        return true;
+    }
+    return false;
+}
+
+static void mic_poll(void)
+{
+    static const struct { uint32_t hz, attr; } clk_tries[3] = {
+        {19200000u, 1u}, {9600000u, 1u}, {19200000u, 0u},
+    };
+    static const FuxiArFormat mic_fmt = {48000u, 16u, 1u};
+    uint8_t packet[FUXI_SPF_INTENT_BYTES];
+    uint32_t len = 0;
+
+    if (!gMic.mode || gMic.phase == FUXI_MIC_FAILED) return;
+    if (gMic.phase == FUXI_MIC_OFF) {
+        if (gSpf.format != 6 || gTone.phase != FUXI_TONE_PCM_PLAY ||
+            !gGraph.map_handle || !gGraph.dma_address || !gSpf.up || gGraph.link_lost) {
+            return;
+        }
+        gMic.clk_try = 0;
+        gMic.phase = FUXI_MIC_CLK_REQ;
+    }
+    if (gMic.phase < FUXI_MIC_FAIL_CLOSE_CAP && (!gSpf.up || gGraph.link_lost || gTone.phase != FUXI_TONE_PCM_PLAY)) {
+        mic_fail("link-or-tone-lost", 0);
+        return;
+    }
+
+    const uint64_t now = mach_absolute_time();
+
+    if (gMic.phase == FUXI_MIC_HW_WAIT) {
+        uint32_t done = __atomic_load_n(&gMic.hw_done, __ATOMIC_ACQUIRE);
+        if (done == 0u) {
+            if (now >= gMic.cmd_deadline) {
+                printf("FUXI AUDIO MIC: hw bringup timeout\n");
+                mic_set_state_bits(FUXI_MIC_STATE_READY | FUXI_MIC_STATE_CAPTURING, FUXI_MIC_STATE_FAILED);
+                gMic.phase = FUXI_MIC_FAILED;
+            }
+            return;
+        }
+        if (done != 1u) {
+            printf("FUXI AUDIO MIC: hw failed step=%u why=%u faults=%u bad_reg=%#x bus=%#x ver=%#x\n",
+                gMic.hw.stop_step, gMic.hw.why, gMic.hw.faults, gMic.hw.bad_reg, gMic.hw.bus_status, gMic.hw.version);
+            mic_unmap_regions();
+            mic_fail("hw-bringup", gMic.hw.why);
+            return;
+        }
+        printf("FUXI AUDIO MIC: hw ready passed=%u chip=%02x%02x port=%u lane=%u mic=%u adc1=%u dec0=%#x rb=%u p_lane=%#x p_ch=%#x\n",
+            gMic.hw.passed, gMic.hw.chip_id[2], gMic.hw.chip_id[3], gMic.hw.port, gMic.hw.lane, gMic.hw.mic,
+            (unsigned)gMic.hw.adc1_gain, (unsigned)gMic.hw.dec0_gain, gMic.hw.readback_ok,
+            gMic.hw.port_lane_rb, gMic.hw.port_ch_rb);
+        gMic.phase = FUXI_MIC_OPEN_MIC;
+    }
+
