+    {FUXI_MIC_VA,    0x1000u, 0, 0, 0},
+    {FUXI_MIC_TX,    0x1000u, 0, 0, 0},
+    {FUXI_MIC_SWR,   0x8000u, 0, 0, 0},
+    {FUXI_MIC_LPI,   0xf000u, 0, 0, 0},
