index 0000000..05b107d
--- /dev/null
+++ b/bsd/dev/fuxi_haptic_shape_v2.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* HAP525 觸感整形 v2（ADT /chosen fuxi,haptic=7；預設關，不改動既有的 mode 6）。
+ *
+ * 針對 2026-11-20 趟 36/37 實機問題改善：
+ * 1. mode 6 的 40 ms 吞掉期會吃掉快速計時器滾輪（每 20–30 ms 一格）的相鄰刻度；
+ *    改為 18 ms（略大於 15 ms 原廠 RTP 波形）與 4 ms 間隔，快速刻度可達 ~50 格/秒不漏拍。
+ * 2. VMAX 下限放寬到 90/256（~35%）到 100% base，讓輕點／中按／重按分級更明顯；
+ *    搭配 FuxiAudio.c 的 6 ms 起始峰值匯整，不再被 1 ms 起振邊緣的 level=4 誤觸弱震。 */
+#ifndef FUXI_HAPTIC_SHAPE_V2_H
+#define FUXI_HAPTIC_SHAPE_V2_H
+
+#include <stdint.h>
+#include "fuxi_haptic_shape.h"
+
+enum {
+    FUXI_SHAPE2_CLICK_MS = 22,
+    FUXI_SHAPE2_SWALLOW_MS = 18,
+    FUXI_SHAPE2_GAP_MS = 4,
+    FUXI_SHAPE2_FLOOR = 90, /* /256，約 35%，輕中重層次比 mode 6（45%）更清楚 */
+};
+
+static inline unsigned fuxi_shape2_classify(FuxiShapeBurst *burst, uint64_t now, unsigned ms)
+{
+    const uint64_t ms_ns = 1000000ull;
+    if (!burst) return FUXI_SHAPE_PASS;
+    int fresh = !burst->active || now < burst->start || now >= burst->end + FUXI_SHAPE2_GAP_MS * ms_ns;
+    int swallowing = !fresh && burst->clicked && now - burst->start < FUXI_SHAPE2_SWALLOW_MS * ms_ns;
+    if (!ms) {
+        if (swallowing) return FUXI_SHAPE_SWALLOW;
+        burst->clicked = 0;
+        if (burst->active && now < burst->end) burst->end = now;
+        return FUXI_SHAPE_PASS;
+    }
+    uint64_t end = now + (uint64_t)ms * ms_ns;
+    if (fresh) {
+        burst->active = 1;
+        burst->start = now;
+        burst->end = end;
+        burst->clicked = ms <= FUXI_SHAPE2_CLICK_MS;
+        return burst->clicked ? FUXI_SHAPE_CLICK : FUXI_SHAPE_PASS;
+    }
+    if (end > burst->end) burst->end = end;
+    if (swallowing) return FUXI_SHAPE_SWALLOW;
+    burst->clicked = 0;
+    return FUXI_SHAPE_PASS;
+}
+
+static inline uint32_t fuxi_shape2_vmax(unsigned level, uint32_t base)
+{
+    if (!level) level = FUXI_SHAPE_DEFAULT_LEVEL;
+    if (level > FUXI_SHAPE_MAX_LEVEL) level = FUXI_SHAPE_MAX_LEVEL;
+    if (base > 0xffu) return 0;
+    unsigned root = fuxi_shape_isqrt(level * 512u); /* 0..256 */
+    uint32_t vmax = (base * (FUXI_SHAPE2_FLOOR * 256u + (256u - FUXI_SHAPE2_FLOOR) * root) + 32768u) / 65536u;
+    return vmax || !base ? vmax : 1u;
+}
+
+#endif /* FUXI_HAPTIC_SHAPE_V2_H */
