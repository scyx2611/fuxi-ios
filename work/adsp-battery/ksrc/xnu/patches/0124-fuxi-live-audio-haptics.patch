+static void fuxi_audio_touch_active(void)
+{
+    __atomic_store_n(&fuxi_audio_last_nonzero_ns, spf_now_ns(), __ATOMIC_RELEASE);
+    if (!__atomic_load_n(&fuxi_amp_live_awake, __ATOMIC_ACQUIRE)) {
+        fuxi_amp_live_kick();
+    }
+}
