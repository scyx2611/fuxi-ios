+static uint32_t ampChosenU32(const char *name, uint32_t fallback)
+{
+    DTEntry chosen;
+    const void *prop;
+    unsigned bytes;
+    uint32_t value = fallback;
+    if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+        SecureDTGetProperty(chosen, name, &prop, &bytes) == kSuccess && bytes == sizeof(value))
+        memcpy(&value, prop, sizeof(value));
+    return value;
+}
