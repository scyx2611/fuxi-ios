+/* 即時喇叭串流（fuxi,audio-spf=6 搭配 fuxi,amp=8） */
+static LCK_GRP_DECLARE(gAudioStreamGrp, "fuxi-audio-stream");
+static LCK_MTX_DECLARE(gAudioCopyLock, &gAudioStreamGrp);
+static LCK_MTX_DECLARE(gAudioRingLock, &gAudioStreamGrp);
+static FuxiAudioRing gAudioRing;
