 _Static_assert(FUXI_TONE_AHEAD < FUXI_TONE_PERIODS, "the period being filled must not be in the DSP's hands");
 _Static_assert(FUXI_TONE_FRAMES % FUXI_TONE_PERIOD_FRAMES == 0, "the tone ends on a period boundary");
