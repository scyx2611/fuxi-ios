+static int fuxi_audio_write_allowed(void)
+{
+    if (kauth_cred_issuser(kauth_cred_get())) {
+        return 1;
+    }
+    char name[32] = {0};
+    proc_selfname(name, sizeof(name));
+    proc_t process = proc_self();
+    int platform = process && csproc_get_platform_binary(process) != 0;
+    if (process) {
+        proc_rele(process);
+    }
+    return platform && (strcmp(name, "mediaserverd") == 0 || strcmp(name, "SpringBoard") == 0 ||
+        strcmp(name, "audiomxd") == 0);
+}
+
+static int fuxi_audio_pcm_sysctl SYSCTL_HANDLER_ARGS
+{
+    (void)oidp;
+    (void)arg1;
+    (void)arg2;
+    if (!__atomic_load_n(&gAudioLiveEnabled, __ATOMIC_ACQUIRE)) return ENOTSUP;
+    if (!req->newptr || req->oldptr) return EINVAL;
+    if (!fuxi_audio_write_allowed()) return EPERM;
+    if (!__atomic_load_n(&gAudioLiveReady, __ATOMIC_ACQUIRE)) return EAGAIN;
+    size_t length = req->newlen;
+    if (length < 4 || length > sizeof(gAudioCopyBuf) || (length & 3u)) return EINVAL;
+    lck_mtx_lock(&gAudioCopyLock);
+    int error = SYSCTL_IN(req, gAudioCopyBuf, length);
+    int nonzero = 0;
+    uint32_t l_pk = 0u, r_pk = 0u;
+    uint32_t log_idx = 0u;
+    const uint32_t frames = (uint32_t)(length / 4u);
+    if (!error) {
+        const uint64_t prev_nz_ns = __atomic_load_n(&fuxi_audio_last_nonzero_ns, __ATOMIC_ACQUIRE);
+        const uint64_t now_ns = spf_now_ns();
+        lck_mtx_lock(&gAudioRingLock);
+        nonzero = fuxi_audio_ring_write(&gAudioRing, gAudioCopyBuf, frames);
+        lck_mtx_unlock(&gAudioRingLock);
+        if (nonzero && (gLivePeakLogs < 16u ||
+            (prev_nz_ns != 0ull && now_ns >= prev_nz_ns + 500000000ull && gLivePeakLogs < 32u))) {
+            fuxi_audio_pcm_peaks(gAudioCopyBuf, frames, &l_pk, &r_pk);
+            log_idx = ++gLivePeakLogs;
+        }
+    }
+    lck_mtx_unlock(&gAudioCopyLock);
+    if (!error && nonzero) {
+        const uint32_t was_awake = __atomic_load_n(&fuxi_amp_live_awake, __ATOMIC_ACQUIRE);
+        fuxi_audio_touch_active();
+        if (log_idx) {
+            printf("FUXI AUDIO LIVE: pcm_in #%u frames=%u l_pk=%u r_pk=%u awake=%u\n",
+                log_idx, frames, l_pk, r_pk, was_awake);
+        }
+    }
+    return error;
+}
