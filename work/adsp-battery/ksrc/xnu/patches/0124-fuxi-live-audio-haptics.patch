index 0000000..8f5dd8b
--- /dev/null
+++ b/bsd/dev/fuxi_audio_mic.h
@@ -0,0 +1,641 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* 小米 13 內建麥克風（WCD938x AMIC1/MICB1/ADC1 + LPASS TX/VA macro + SoundWire TX master）
+ * 與無鎖單調 PCM 環形緩衝。純 C11 標頭，便於在主機以 ASan/UBSan 針對假 LPASS／假 WCD938x 完整驗證。
+ *
+ * 硬體序列移植自同機已實測驗證之 shim/fuxi-probe/au_mic.h 與 xnu/fuxi-audio/fuxi_audio_dsp.c
+ * （亦對照 UniXNU-sheng package/AudioProbe.cpp 08cde20edc32 與 Linux 6.12 wcd938x/qcom/lpass-*-macro）：
+ * - L15B 已由 fuxi-wlan 維持開啟，此處不碰 apps RSC。
+ * - 所有 WCD938x 寫入皆經 fuxi_mic_allowed[] 白名單及 MICB1 VOUT <= 0x23 (2.75V) 上限保護，
+ *   不碰 efuse、不碰 HPH、僅動 MICB1 與 ADC1。
+ * - 小米 13 AMIC1 佈線：SoundWire TX master port=3, lane=1, TX macro SWR_MIC=5, CODEC_TX3 mask=1。
+ * - 參考 Linux v6.12 sound/soc/codecs/lpass-tx-macro.c tx_macro_tx_hpf_corner_freq_callback()（is_amic_enabled 分支）：
+ *   hpf_4hz 啟用時於 unmute 期間將 TX0 HPF 降至 4 Hz 並脈衝 CDC_TX0_TX_PATH_SEC2 (0x418) 0x02->0x01。
+ * - 0x3410 維持 0x03 (ADC_NORMAL)，因 SWR 時脈為 9.6 MHz（ADC_LP 0x05 需搭配 4.8 MHz，不任意單改 0x3410）。
+ */
+#ifndef FUXI_AUDIO_MIC_H
+#define FUXI_AUDIO_MIC_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define FUXI_MIC_VA         0x06d44000ull
+#define FUXI_MIC_TX         0x06ae0000ull
+#define FUXI_MIC_SWR        0x06d30000ull
+#define FUXI_MIC_LPI        0x06e80000ull
+#define FUXI_MIC_SLEW       0x0725a000ull
+#define FUXI_MIC_RESET      0x0f16c000ull /* TLMM gpio108 (active-low WCD938x reset) */
+#define FUXI_MIC_MICB1      0x3022u
+#define FUXI_MIC_VOUT_MAX   0x23u         /* 2.75 V: (mV - 1000) / 50 */
+#define FUXI_MIC_ADC1_MAX   20u           /* 0..20 (1.5 dB/step, stock 8 = +12 dB) */
+#define FUXI_MIC_DEC0_MAX   0x24u         /* TX0 digital gain 0..+36 dB, stock 0x12 (+18 dB) */
+#define FUXI_MIC_CLOCK_ID   0x30cu        /* PRM TX_CORE_MCLK */
+
+#define FUXI_MIC_DMA_OFFSET 0xf000u       /* 4 * 960 = 3840 B inside 0x10000 mapped DMA (speaker uses 0..0xefff) */
+#define FUXI_MIC_PERIOD     960u          /* 10 ms @ 48 kHz mono 16-bit */
+#define FUXI_MIC_SLOTS      4u
+#define FUXI_MIC_AHEAD      3u
+#define FUXI_MIC_RING_CAP   16384u        /* 341 ms @ 48 kHz, power of two */
+#define FUXI_MIC_RING_MASK  (FUXI_MIC_RING_CAP - 1u)
+
+enum {
+    FUXI_MIC_WHY_NONE = 0,
+    FUXI_MIC_WHY_ABORT = 1,
+    FUXI_MIC_WHY_RESET = 2,
+    FUXI_MIC_WHY_PADS = 3,
+    FUXI_MIC_WHY_GATES = 4,
+    FUXI_MIC_WHY_VERSION = 5,
+    FUXI_MIC_WHY_NO_FRAMES = 6,
+    FUXI_MIC_WHY_NO_DEVICE = 7,
+    FUXI_MIC_WHY_NOT_CODEC = 8,
+    FUXI_MIC_WHY_READ = 9,
+    FUXI_MIC_WHY_CHIP = 10,
+    FUXI_MIC_WHY_WRITE = 11,
+    FUXI_MIC_WHY_READBACK = 12,
+    FUXI_MIC_WHY_BUS = 13,
+};
+
+enum {
+    FUXI_MIC_DID_RESET = 1u,
+    FUXI_MIC_DID_PADS = 2u,
+    FUXI_MIC_DID_GATES = 4u,
+    FUXI_MIC_DID_TX = 8u,
+    FUXI_MIC_DID_MASTER = 16u,
+    FUXI_MIC_DID_BIAS = 32u,
+};
+
+typedef uint32_t (*FuxiMicRdFn)(void *ctx, uint64_t pa, uint32_t *faulted);
+typedef unsigned (*FuxiMicWrFn)(void *ctx, uint64_t pa, uint32_t value);
+typedef void (*FuxiMicDelayFn)(void *ctx, uint32_t us);
+
+typedef struct {
+    void *ctx;
+    FuxiMicRdFn rd;
+    FuxiMicWrFn wr;
+    FuxiMicDelayFn delay_us;
+} FuxiMicIo;
+
+typedef struct {
+    FuxiMicIo io;
+    uint32_t port, lane, mic;
+    uint8_t adc1_gain, dec0_gain;
+    uint8_t cmd_id;
+    uint32_t dev;
+    uint32_t did;
+    uint32_t passed;
+    uint32_t stop_step;
+    uint32_t why;
+    uint32_t faults;
+    uint32_t read_fails;
+    uint32_t version;
+    uint32_t bus_status;
+    uint32_t readback_ok;
+    uint32_t bad_reg;
+    uint32_t port_lane_rb;
+    uint32_t port_ch_rb;
+    uint8_t chip_id[4];
+    uint32_t found_pad[2];
+    uint32_t found_lpi[4];
+    uint32_t found_slew;
+    uint32_t found_va[3];
+    bool hpf_4hz;
+    bool going_down;
+    bool held;
+} FuxiMicHw;
+
+typedef struct {
+    int16_t pcm[FUXI_MIC_RING_CAP];
+    uint32_t head;
+    uint32_t tail;
+    uint32_t drops;
+    uint32_t pushes;
+    uint32_t pops;
+} FuxiAudioMicRing;
+
+static inline void fuxi_mic_decode_gain(uint32_t raw, uint8_t *adc1_out, uint8_t *dec0_out)
+{
+    uint32_t adc1 = 8u;
+    uint32_t dec0 = 0x12u;
+    if (raw != 0u) {
+        adc1 = raw & 0xffu;
+        dec0 = (raw >> 8) & 0xffu;
+        if (adc1 > FUXI_MIC_ADC1_MAX) adc1 = FUXI_MIC_ADC1_MAX;
+        if (dec0 > FUXI_MIC_DEC0_MAX) dec0 = FUXI_MIC_DEC0_MAX;
+    }
+    if (adc1_out) *adc1_out = (uint8_t)adc1;
+    if (dec0_out) *dec0_out = (uint8_t)dec0;
+}
+
+static inline void fuxi_mic_ring_reset(FuxiAudioMicRing *ring)
+{
+    if (!ring) return;
+    ring->head = 0;
+    ring->tail = 0;
+    ring->drops = 0;
+    ring->pushes = 0;
+    ring->pops = 0;
+}
+
+static inline uint32_t fuxi_mic_ring_push(FuxiAudioMicRing *ring, const int16_t *samples, uint32_t count)
+{
+    if (!ring || !samples || !count) return 0;
+    uint32_t written = 0;
+    for (uint32_t i = 0; i < count; i++) {
+        if ((uint32_t)(ring->head - ring->tail) >= FUXI_MIC_RING_CAP) {
+            ring->tail++;
+            ring->drops++;
+        }
+        ring->pcm[ring->head & FUXI_MIC_RING_MASK] = samples[i];
+        ring->head++;
+        written++;
+    }
+    ring->pushes++;
+    return written;
+}
+
+static inline uint32_t fuxi_mic_ring_pop(FuxiAudioMicRing *ring, int16_t *out, uint32_t max_count)
+{
+    if (!ring || !out || !max_count) return 0;
+    uint32_t avail = (uint32_t)(ring->head - ring->tail);
+    uint32_t take = avail < max_count ? avail : max_count;
+    for (uint32_t i = 0; i < take; i++) {
+        out[i] = ring->pcm[ring->tail & FUXI_MIC_RING_MASK];
+        ring->tail++;
+    }
+    if (take) ring->pops++;
+    return take;
+}
+
+static inline bool fuxi_mic_fail(FuxiMicHw *hw, uint32_t step, uint32_t why)
+{
+    if (hw->stop_step == 0u) {
+        hw->stop_step = step;
+        hw->why = why;
+    }
+    return false;
+}
+
+static inline uint32_t fuxi_mic_rd(FuxiMicHw *hw, uint64_t pa, bool *ok)
+{
+    uint32_t fault = 0;
+    uint32_t value = hw->io.rd(hw->io.ctx, pa, &fault);
+    if (fault != 0u) {
+        if (!hw->going_down) hw->faults++;
+        if (ok) *ok = false;
+        return 0;
+    }
+    if (ok) *ok = true;
+    return value;
+}
+
+static inline void fuxi_mic_wr(FuxiMicHw *hw, uint64_t pa, uint32_t value)
+{
+    if (hw->faults != 0u && !hw->going_down) return;
+    if (hw->io.wr(hw->io.ctx, pa, value) != 0u && !hw->going_down) hw->faults++;
+}
+
+static inline void fuxi_mic_set(FuxiMicHw *hw, uint64_t pa, uint32_t clear, uint32_t set)
+{
+    bool ok = false;
+    if (hw->faults != 0u && !hw->going_down) return;
+    uint32_t value = fuxi_mic_rd(hw, pa, &ok);
+    if (ok) fuxi_mic_wr(hw, pa, (value & ~clear) | set);
+}
+
+static inline uint32_t fuxi_mic_pack(uint8_t data, uint32_t dev, uint32_t id, uint32_t reg)
+{
+    return reg | (id << 16) | (dev << 20) | ((uint32_t)data << 24);
+}
+
+static inline uint32_t fuxi_mic_next_id(FuxiMicHw *hw)
+{
+    hw->cmd_id = hw->cmd_id < 14u ? (uint8_t)(hw->cmd_id + 1u) : 0u;
+    return hw->cmd_id;
+}
+
+static inline bool fuxi_mic_reg_allowed(uint32_t reg)
+{
+    static const uint16_t allowed[] = {
+        0x3001, 0x300e, 0x300f, 0x3022, 0x3029, 0x306b, 0x306e, 0x3071, 0x3074, 0x308f,
+        0x3103, 0x312a, 0x31df, 0x31e1, 0x3408, 0x3409, 0x3410, 0x3417, 0x3457, 0x345b,
+        0x34d0, 0x34d1, 0x34d2, 0x34d3, 0x34d4,
+        0x102, 0x103, 0x105, 0x120, 0x122, 0x123, 0x124, 0x125, 0x126, 0x128,
+        0x130, 0x132, 0x133, 0x134, 0x135, 0x136, 0x138,
+    };
+    for (unsigned i = 0; i < sizeof(allowed) / sizeof(allowed[0]); i++) {
+        if (allowed[i] == reg) return true;
+    }
+    return false;
+}
+
+static inline bool fuxi_mic_codec_read(FuxiMicHw *hw, uint32_t reg, uint32_t *value)
+{
+    uint32_t id = fuxi_mic_next_id(hw);
+    fuxi_mic_wr(hw, FUXI_MIC_SWR + 0x5024u, fuxi_mic_pack(1u, hw->dev, id, reg));
+    for (unsigned i = 0; i < 200u; i++) {
+        bool ok = false;
+        uint32_t st = fuxi_mic_rd(hw, FUXI_MIC_SWR + 0x5050u, &ok);
+        if (!ok) break;
+        if (((st >> 16) & 0x1fu) != 0u) {
+            uint32_t v = fuxi_mic_rd(hw, FUXI_MIC_SWR + 0x5040u, &ok);
+            if (ok && ((v >> 8) & 0xfu) == id) {
+                *value = v & 0xffu;
+                return true;
+            }
+            fuxi_mic_wr(hw, FUXI_MIC_SWR + 0x308u, 1u);
+            break;
+        }
+        hw->io.delay_us(hw->io.ctx, 50u);
+    }
+    hw->read_fails++;
+    return false;
+}
+
+static inline bool fuxi_mic_codec_write(FuxiMicHw *hw, uint32_t reg, uint32_t value)
+{
+    if (!fuxi_mic_reg_allowed(reg) || value > 0xffu ||
+        (reg == FUXI_MIC_MICB1 && (value & 0x3fu) > FUXI_MIC_VOUT_MAX)) {
+        return false;
+    }
+    for (unsigned i = 0; i < 100u; i++) {
+        bool ok = false;
+        uint32_t st = fuxi_mic_rd(hw, FUXI_MIC_SWR + 0x5050u, &ok);
+        if (!ok) return false;
+        if (((st >> 8) & 0x1fu) < 8u) break;
+        hw->io.delay_us(hw->io.ctx, 50u);
+    }
+    fuxi_mic_wr(hw, FUXI_MIC_SWR + 0x5020u,
+        fuxi_mic_pack((uint8_t)value, hw->dev, fuxi_mic_next_id(hw), reg));
+    return hw->faults == 0u || hw->going_down;
+}
+
+static inline bool fuxi_mic_codec_update(FuxiMicHw *hw, uint32_t reg, uint32_t mask, uint32_t value)
+{
+    uint32_t v = 0;
+    return fuxi_mic_codec_read(hw, reg, &v) &&
+           fuxi_mic_codec_write(hw, reg, (v & ~mask) | (value & mask));
+}
+
+static inline void fuxi_mic_hw_down(FuxiMicHw *hw)
+{
+    static const uint8_t lpi_pins[4] = {0, 1, 2, 14};
+    if (!hw) return;
+    hw->going_down = true;
+    hw->held = false;
+    if (hw->did & FUXI_MIC_DID_BIAS) {
+        (void)fuxi_mic_codec_update(hw, FUXI_MIC_MICB1, 0xc0u, 0u);
+    }
+    if (hw->did & FUXI_MIC_DID_MASTER) {
+        fuxi_mic_wr(hw, FUXI_MIC_SWR + 0x5004u, 0u);
+        fuxi_mic_wr(hw, FUXI_MIC_SWR + 0x008u, 1u);
+        hw->io.delay_us(hw->io.ctx, 1000u);
+    }
+    if (hw->did & FUXI_MIC_DID_RESET) {
+        fuxi_mic_wr(hw, FUXI_MIC_RESET + 4u, 0u);
+        hw->io.delay_us(hw->io.ctx, 1000u);
+        fuxi_mic_wr(hw, FUXI_MIC_RESET + 4u, hw->found_pad[1] & 2u);
+        fuxi_mic_wr(hw, FUXI_MIC_RESET, hw->found_pad[0]);
+    }
+    if (hw->did & FUXI_MIC_DID_TX) {
+        fuxi_mic_set(hw, FUXI_MIC_TX + 8u, 1u, 0u);
+        fuxi_mic_set(hw, FUXI_MIC_TX + 4u, 1u, 0u);
+        fuxi_mic_set(hw, FUXI_MIC_TX, 1u, 0u);
+    }
+    if (hw->did & FUXI_MIC_DID_GATES) {
+        fuxi_mic_set(hw, FUXI_MIC_VA + 8u, 1u, 0u);
+        fuxi_mic_set(hw, FUXI_MIC_VA, 1u, 0u);
+        fuxi_mic_set(hw, FUXI_MIC_VA + 4u, 1u, 0u);
+        fuxi_mic_set(hw, FUXI_MIC_VA + 0x80u, 2u, 0u);
+        for (unsigned i = 0; i < 3u; i++) {
+            fuxi_mic_wr(hw, FUXI_MIC_VA + 0xd0u + 4u * i, hw->found_va[i]);
+        }
+    }
+    if (hw->did & FUXI_MIC_DID_PADS) {
+        for (unsigned i = 0; i < 4u; i++) {
+            fuxi_mic_wr(hw, FUXI_MIC_LPI + 0x1000u * lpi_pins[i], hw->found_lpi[i]);
+        }
+        fuxi_mic_wr(hw, FUXI_MIC_SLEW, hw->found_slew);
+    }
+}
+
+static inline bool fuxi_mic_hw_unmute_tx(FuxiMicHw *hw)
+{
+    if (!hw || !hw->held) return false;
+    fuxi_mic_set(hw, FUXI_MIC_TX + 0x400u, 0x10u, 0u);
+    fuxi_mic_set(hw, FUXI_MIC_TX + 0x40cu, 0xffu, hw->dec0_gain);
+    if (hw->hpf_4hz) {
+        /* Linux lpass-tx-macro.c (is_amic_enabled): clear HPF_CUT_FREQ -> 4 Hz, pulse SEC2 0x02 -> 0x01 */
+        fuxi_mic_set(hw, FUXI_MIC_TX + 0x404u, 3u << 5, 0u);
+        fuxi_mic_set(hw, FUXI_MIC_TX + 0x418u, 3u, 2u);
+        fuxi_mic_set(hw, FUXI_MIC_TX + 0x418u, 3u, 1u);
+    }
+    return hw->faults == 0u;
+}
+
+static inline bool fuxi_mic_hw_bringup(FuxiMicHw *hw)
+{
+    static const uint8_t lpi_pins[4] = {0, 1, 2, 14};
+    static const struct { uint16_t reg; uint8_t mask, value; uint16_t wait_us; } writes[] = {
+        {0x3103, 0x0e, 0x0e, 0}, {0x3103, 0x80, 0x80, 1000}, {0x3103, 0x40, 0x40, 1000},
+        {0x312a, 0x10, 0x00, 0}, {0x3029, 0xf0, 0x80, 0}, {0x3001, 0x80, 0x80, 0},
+        {0x3001, 0x40, 0x40, 10000}, {0x3001, 0x40, 0x00, 0}, {0x345b, 0x02, 0x02, 0},
+        {0x31e1, 0xff, 0x14, 0}, {0x31df, 0x1f, 0x08, 0}, {0x34d0, 0xff, 0x55, 0},
+        {0x34d1, 0xff, 0x44, 0}, {0x34d2, 0xff, 0x11, 0}, {0x34d3, 0xff, 0x00, 0},
+        {0x34d4, 0xff, 0x00, 0}, {0x306b, 0xe0, 0xe0, 0}, {0x306e, 0xe0, 0xe0, 0},
+        {0x3071, 0xe0, 0xe0, 0}, {0x3074, 0xe0, 0xe0, 0}, {0x308f, 0x01, 0x00, 0},
+        {FUXI_MIC_MICB1, 0x3f, FUXI_MIC_VOUT_MAX, 0}, {0x3409, 0xf0, 0xf0, 0},
+        {0x3408, 0x10, 0x10, 0}, {0x3417, 0x01, 0x01, 0}, {FUXI_MIC_MICB1, 0xc0, 0x40, 0},
+        {0x3408, 0x18, 0x18, 0}, {0x3457, 0x03, 0x02, 0}, {0x300f, 0x40, 0x40, 0},
+        {0x3410, 0x0f, 0x03, 0}, {0x3409, 0x10, 0x10, 0}, {0x300f, 0x40, 0x00, 0},
+    };
+    static const struct { uint16_t reg; uint8_t mask, want; } check_regs[24] = {
+        {0x3103, 0xce, 0xce}, {0x312a, 0x10, 0x00}, {0x3029, 0xf0, 0x80},
+        {0x3001, 0xc0, 0x80}, {0x345b, 0x02, 0x02}, {0x31e1, 0xff, 0x14},
+        {0x31df, 0x1f, 0x08}, {0x34d0, 0xff, 0x55}, {0x34d1, 0xff, 0x44},
+        {0x34d2, 0xff, 0x11}, {0x34d3, 0xff, 0x00}, {0x34d4, 0xff, 0x00},
+        {0x306b, 0xe0, 0xe0}, {0x306e, 0xe0, 0xe0}, {0x3071, 0xe0, 0xe0},
+        {0x3074, 0xe0, 0xe0}, {0x308f, 0x01, 0x00}, {FUXI_MIC_MICB1, 0xff, 0x40u | FUXI_MIC_VOUT_MAX},
+        {0x3409, 0xf0, 0xf0}, {0x3408, 0x18, 0x18}, {0x3417, 0x01, 0x01},
+        {0x3457, 0x03, 0x02}, {0x300f, 0x40, 0x00}, {0x3410, 0x0f, 0x03},
+    };
+
+    if (!hw || !hw->io.rd || !hw->io.wr || !hw->io.delay_us || hw->port == 0u) return false;
+    if (hw->adc1_gain > FUXI_MIC_ADC1_MAX) hw->adc1_gain = FUXI_MIC_ADC1_MAX;
+    if (hw->dec0_gain > FUXI_MIC_DEC0_MAX) hw->dec0_gain = FUXI_MIC_DEC0_MAX;
+    hw->passed = 1u;
+    hw->stop_step = 0u;
+    hw->why = FUXI_MIC_WHY_NONE;
+    hw->faults = 0u;
+    hw->read_fails = 0u;
+    hw->readback_ok = 0u;
+    hw->going_down = false;
+    hw->held = false;
+
+    /* Step 2: VA macro reachable */
+    for (unsigned i = 0; i < 4u; i++) (void)fuxi_mic_rd(hw, FUXI_MIC_VA + 0xc0u + 4u * i, 0);
+    if (hw->faults != 0u) { (void)fuxi_mic_fail(hw, 2u, FUXI_MIC_WHY_ABORT); goto fail; }
+    hw->passed = 2u;
+
+    /* Step 3: gpio108 reset release, LPI pads + slew, VA/TX macro clocks & gates, SWR version */
+    {
+        uint32_t was = fuxi_mic_rd(hw, FUXI_MIC_RESET, 0);
+        uint32_t io = fuxi_mic_rd(hw, FUXI_MIC_RESET + 4u, 0);
+        uint32_t ctl = (7u << 6) | (1u << 9) | (was & (1u << 11)) | ((was & (1u << 11)) ? (1u << 12) : 0u);
+        if (hw->faults != 0u) { (void)fuxi_mic_fail(hw, 3u, FUXI_MIC_WHY_ABORT); goto fail; }
+        hw->found_pad[0] = was;
+        hw->found_pad[1] = io;
+        hw->did |= FUXI_MIC_DID_RESET;
+        fuxi_mic_wr(hw, FUXI_MIC_RESET + 4u, 0u);
+        fuxi_mic_wr(hw, FUXI_MIC_RESET, ctl);
+        hw->io.delay_us(hw->io.ctx, 20000u);
+        fuxi_mic_wr(hw, FUXI_MIC_RESET + 4u, 2u);
+        hw->io.delay_us(hw->io.ctx, 20000u);
+        uint32_t rb_ctl = fuxi_mic_rd(hw, FUXI_MIC_RESET, 0);
+        uint32_t rb_io = fuxi_mic_rd(hw, FUXI_MIC_RESET + 4u, 0);
+        if (hw->faults != 0u) { (void)fuxi_mic_fail(hw, 3u, FUXI_MIC_WHY_ABORT); goto fail; }
+        if ((rb_ctl & 0x3ffu) != (ctl & 0x3ffu) || (rb_io & 2u) == 0u) {
+            (void)fuxi_mic_fail(hw, 3u, FUXI_MIC_WHY_RESET);
+            goto fail;
+        }
+    }
+    {
+        for (unsigned i = 0; i < 4u; i++) {
+            hw->found_lpi[i] = fuxi_mic_rd(hw, FUXI_MIC_LPI + 0x1000u * lpi_pins[i], 0);
+        }
+        uint32_t slew = fuxi_mic_rd(hw, FUXI_MIC_SLEW, 0);
+        hw->found_slew = slew;
+        if (hw->faults != 0u) { (void)fuxi_mic_fail(hw, 3u, FUXI_MIC_WHY_ABORT); goto fail; }
+        hw->did |= FUXI_MIC_DID_PADS;
+        for (unsigned i = 0; i < 4u; i++) {
+            uint32_t want = (1u << 2) | (1u << 6) | (i != 0u ? 2u : 0u);
+            fuxi_mic_wr(hw, FUXI_MIC_LPI + 0x1000u * lpi_pins[i], want);
+            slew = (slew & ~(3u << (2u * i))) | (1u << (2u * i));
+        }
+        fuxi_mic_wr(hw, FUXI_MIC_SLEW, slew);
+        for (unsigned i = 0; i < 4u; i++) {
+            uint32_t want = (1u << 2) | (1u << 6) | (i != 0u ? 2u : 0u);
+            uint32_t rb = fuxi_mic_rd(hw, FUXI_MIC_LPI + 0x1000u * lpi_pins[i], 0);
+            if ((rb & 0x3ffu) != want) (void)fuxi_mic_fail(hw, 3u, FUXI_MIC_WHY_PADS);
+        }
+        uint32_t rb_slew = fuxi_mic_rd(hw, FUXI_MIC_SLEW, 0);
+        if (hw->faults != 0u) { hw->stop_step = 0u; (void)fuxi_mic_fail(hw, 3u, FUXI_MIC_WHY_ABORT); goto fail; }
+        if ((rb_slew & 0xffu) != (slew & 0xffu)) (void)fuxi_mic_fail(hw, 3u, FUXI_MIC_WHY_PADS);
+        if (hw->stop_step != 0u) goto fail;
+    }
+    {
+        static const struct { uint64_t pa; uint32_t bits; } gates[7] = {
+            {FUXI_MIC_VA, 1u}, {FUXI_MIC_VA + 4u, 1u}, {FUXI_MIC_VA + 8u, 1u}, {FUXI_MIC_VA + 0x80u, 2u},
+            {FUXI_MIC_TX, 1u}, {FUXI_MIC_TX + 4u, 1u}, {FUXI_MIC_TX + 8u, 1u},
+        };
+        for (unsigned i = 0; i < 3u; i++) hw->found_va[i] = fuxi_mic_rd(hw, FUXI_MIC_VA + 0xd0u + 4u * i, 0);
+        if (hw->faults != 0u) { (void)fuxi_mic_fail(hw, 3u, FUXI_MIC_WHY_ABORT); goto fail; }
+        hw->did |= FUXI_MIC_DID_GATES;
+        fuxi_mic_set(hw, FUXI_MIC_VA, 0u, 1u);
+        fuxi_mic_set(hw, FUXI_MIC_VA + 4u, 0u, 3u);
+        fuxi_mic_set(hw, FUXI_MIC_VA + 4u, 2u, 1u);
+        fuxi_mic_set(hw, FUXI_MIC_VA + 0x80u, 0u, 2u);
+        for (unsigned i = 0; i < 3u; i++) {
+            fuxi_mic_wr(hw, FUXI_MIC_VA + 0xd0u + 4u * i, (hw->found_va[i] & ~0xeeu) | 0xccu);
+        }
+        fuxi_mic_set(hw, FUXI_MIC_VA + 8u, 0u, 2u);
+        fuxi_mic_set(hw, FUXI_MIC_VA + 8u, 0u, 1u);
+        fuxi_mic_set(hw, FUXI_MIC_VA + 8u, 2u, 0u);
+        uint32_t va8 = fuxi_mic_rd(hw, FUXI_MIC_VA + 8u, 0);
+        if (hw->faults != 0u) { (void)fuxi_mic_fail(hw, 3u, FUXI_MIC_WHY_ABORT); goto fail; }
+        if ((va8 & 1u) == 0u) { (void)fuxi_mic_fail(hw, 3u, FUXI_MIC_WHY_GATES); goto fail; }
+        hw->did |= FUXI_MIC_DID_TX;
+        fuxi_mic_set(hw, FUXI_MIC_TX + 0x90u, 0u, 1u);
+        fuxi_mic_set(hw, FUXI_MIC_TX, 0u, 1u);
+        fuxi_mic_set(hw, FUXI_MIC_TX + 4u, 0u, 1u);
+        fuxi_mic_set(hw, FUXI_MIC_TX + 8u, 0u, 2u);
+        fuxi_mic_set(hw, FUXI_MIC_TX + 8u, 0u, 1u);
+        fuxi_mic_set(hw, FUXI_MIC_TX + 8u, 2u, 0u);
+        for (unsigned i = 0; i < 7u; i++) {
+            uint32_t rb = fuxi_mic_rd(hw, gates[i].pa, 0);
+            if ((rb & gates[i].bits) == 0u && hw->faults == 0u) {
+                (void)fuxi_mic_fail(hw, 3u, FUXI_MIC_WHY_GATES);
+            }
+        }
+        if (hw->faults != 0u) { hw->stop_step = 0u; (void)fuxi_mic_fail(hw, 3u, FUXI_MIC_WHY_ABORT); goto fail; }
+        if (hw->stop_step != 0u) goto fail;
+    }
+    hw->version = fuxi_mic_rd(hw, FUXI_MIC_SWR, 0);
+    if (hw->faults != 0u) { (void)fuxi_mic_fail(hw, 3u, FUXI_MIC_WHY_ABORT); goto fail; }
+    if ((hw->version >> 24) != 2u) { (void)fuxi_mic_fail(hw, 3u, FUXI_MIC_WHY_VERSION); goto fail; }
+    hw->passed = 3u;
+
+    /* Step 4: SoundWire TX master init + link up */
+    {
+        const uint64_t s = FUXI_MIC_SWR;
+        uint32_t link = 0;
+        hw->did |= FUXI_MIC_DID_MASTER;
+        fuxi_mic_wr(hw, s + 0x008u, 1u);
+        hw->io.delay_us(hw->io.ctx, 1000u);
+        fuxi_mic_wr(hw, s + 0x101cu, (1u << 3) | 7u);
+        fuxi_mic_wr(hw, s + 0x500u, 1u);
+        fuxi_mic_set(hw, s + 0x1048u, 0x1fu << 17, 0x1fu << 17);
+        fuxi_mic_wr(hw, s + 0x018u, 1u);
+        fuxi_mic_wr(hw, s + 0x5060u, 1u);
+        fuxi_mic_wr(hw, s + 0x314u, 7u | (1u << 31));
+        fuxi_mic_wr(hw, s + 0x004u, 1u);
+        fuxi_mic_wr(hw, s + 0x004u, 2u);
+        fuxi_mic_wr(hw, s + 0x5008u, ~0u);
+        fuxi_mic_wr(hw, s + 0x5004u, 0x1ffffu);
+        fuxi_mic_wr(hw, s + 0x004u, 3u);
+        for (unsigned ms = 0; ms < 500u && hw->faults == 0u; ms++) {
+            link = fuxi_mic_rd(hw, s + 0x5064u, 0);
+            if ((link & 1u) != 0u) break;
+            hw->io.delay_us(hw->io.ctx, 1000u);
+        }
+        if (hw->faults != 0u) { (void)fuxi_mic_fail(hw, 4u, FUXI_MIC_WHY_ABORT); goto fail; }
+        if ((link & 1u) == 0u) { (void)fuxi_mic_fail(hw, 4u, FUXI_MIC_WHY_NO_FRAMES); goto fail; }
+    }
+    hw->passed = 4u;
+
+    /* Step 5: WCD938x SoundWire enumeration & SCP ID check */
+    {
+        uint32_t slaves = 0, scp[6] = {0};
+        for (unsigned ms = 0; ms < 1000u && hw->faults == 0u; ms++) {
+            slaves = fuxi_mic_rd(hw, FUXI_MIC_SWR + 0x1090u, 0);
+            if ((slaves & 0x3fffcu) != 0u) break;
+            hw->io.delay_us(hw->io.ctx, 1000u);
+        }
+        if (hw->faults != 0u) { (void)fuxi_mic_fail(hw, 5u, FUXI_MIC_WHY_ABORT); goto fail; }
+        if ((slaves & 0x3fffcu) == 0u) { (void)fuxi_mic_fail(hw, 5u, FUXI_MIC_WHY_NO_DEVICE); goto fail; }
+        hw->dev = 1u;
+        while (hw->dev < 9u && ((slaves >> (2u * hw->dev)) & 3u) == 0u) hw->dev++;
+        for (unsigned i = 0; i < 6u; i++) {
+            if (!fuxi_mic_codec_read(hw, 0x50u + i, &scp[i])) {
+                (void)fuxi_mic_fail(hw, 5u, hw->faults ? FUXI_MIC_WHY_ABORT : FUXI_MIC_WHY_READ);
+                goto fail;
+            }
+        }
+        if (scp[1] != 0x02u || scp[2] != 0x17u || scp[3] != 0x01u || scp[4] != 0x0du) {
+            (void)fuxi_mic_fail(hw, 5u, FUXI_MIC_WHY_NOT_CODEC);
+            goto fail;
+        }
+    }
+    hw->passed = 5u;
+
+    /* Step 6: WCD938x chip ID 0x3401..0x3404 (expect 0x0d, 0x01) */
+    {
+        for (unsigned i = 0; i < 4u; i++) {
+            uint32_t v = 0;
+            if (!fuxi_mic_codec_read(hw, 0x3401u + i, &v)) {
+                (void)fuxi_mic_fail(hw, 6u, hw->faults ? FUXI_MIC_WHY_ABORT : FUXI_MIC_WHY_READ);
+                goto fail;
+            }
+            hw->chip_id[i] = (uint8_t)v;
+        }
+        if (hw->chip_id[2] != 0x0du || hw->chip_id[3] != 0x01u) {
+            (void)fuxi_mic_fail(hw, 6u, FUXI_MIC_WHY_CHIP);
+            goto fail;
+        }
+    }
+    hw->passed = 6u;
+
+    /* Step 7: WCD938x init + MICB1 2.75V + ADC1 gain + readback */
+    {
+        fuxi_mic_wr(hw, FUXI_MIC_SWR + 0x5008u, ~0u);
+        hw->did |= FUXI_MIC_DID_BIAS;
+        for (unsigned i = 0; i < sizeof(writes) / sizeof(writes[0]); i++) {
+            if (!fuxi_mic_codec_update(hw, writes[i].reg, writes[i].mask, writes[i].value)) {
+                hw->bad_reg = writes[i].reg;
+                (void)fuxi_mic_fail(hw, 7u, hw->faults ? FUXI_MIC_WHY_ABORT : FUXI_MIC_WHY_WRITE);
+                goto fail;
+            }
+            if (writes[i].wait_us) hw->io.delay_us(hw->io.ctx, writes[i].wait_us);
+        }
+        if (!fuxi_mic_codec_update(hw, 0x300eu, 0x1fu, hw->adc1_gain)) {
+            hw->bad_reg = 0x300eu;
+            (void)fuxi_mic_fail(hw, 7u, hw->faults ? FUXI_MIC_WHY_ABORT : FUXI_MIC_WHY_WRITE);
+            goto fail;
+        }
+        for (unsigned i = 0; i < 24u; i++) {
+            uint32_t v = 0;
+            if (!fuxi_mic_codec_read(hw, check_regs[i].reg, &v)) {
+                hw->bad_reg = check_regs[i].reg;
+                (void)fuxi_mic_fail(hw, 7u, hw->faults ? FUXI_MIC_WHY_ABORT : FUXI_MIC_WHY_READ);
+                goto fail;
+            }
+            if ((v & check_regs[i].mask) != check_regs[i].want) {
+                hw->bad_reg = check_regs[i].reg;
+                (void)fuxi_mic_fail(hw, 7u, FUXI_MIC_WHY_READBACK);
+                goto fail;
+            }
+            hw->readback_ok++;
+        }
+        {
+            uint32_t v = 0;
+            if (!fuxi_mic_codec_read(hw, 0x300eu, &v)) {
+                hw->bad_reg = 0x300eu;
+                (void)fuxi_mic_fail(hw, 7u, hw->faults ? FUXI_MIC_WHY_ABORT : FUXI_MIC_WHY_READ);
+                goto fail;
+            }
+            if ((v & 0x1fu) != hw->adc1_gain) {
+                hw->bad_reg = 0x300eu;
+                (void)fuxi_mic_fail(hw, 7u, FUXI_MIC_WHY_READBACK);
+                goto fail;
+            }
+            hw->readback_ok++;
+        }
+        hw->bus_status = fuxi_mic_rd(hw, FUXI_MIC_SWR + 0x5000u, 0);
+        if (hw->faults != 0u) { hw->stop_step = 0u; (void)fuxi_mic_fail(hw, 7u, FUXI_MIC_WHY_ABORT); goto fail; }
+        if ((hw->bus_status & ((1u << 3) | (1u << 7))) != 0u) {
+            (void)fuxi_mic_fail(hw, 7u, FUXI_MIC_WHY_BUS);
+            goto fail;
+        }
+    }
+    hw->passed = 7u;
+
+    /* Step 8: SoundWire data port (ADC1 ch0 -> master port 3 lane 1) + TX dec0 muted */
+    {
+        const uint64_t master = FUXI_MIC_SWR + 0x1124u + 0x100u * (hw->port - 1u);
+        bool ok = true;
+        uint32_t v = 0;
+        for (uint32_t bank = 0; bank <= 0x10u && ok; bank += 0x10u) {
+            ok = fuxi_mic_codec_write(hw, 0x122u + bank, 1u) &&
+                 fuxi_mic_codec_write(hw, 0x123u + bank, 0u) &&
+                 fuxi_mic_codec_write(hw, 0x124u + bank, 0u) &&
+                 fuxi_mic_codec_write(hw, 0x125u + bank, 0u) &&
+                 fuxi_mic_codec_write(hw, 0x126u + bank, 0xffu) &&
+                 fuxi_mic_codec_write(hw, 0x128u + bank, hw->lane);
+        }
+        ok = ok && fuxi_mic_codec_write(hw, 0x102u, 0u) &&
+             fuxi_mic_codec_write(hw, 0x103u, 0u) &&
+             fuxi_mic_codec_write(hw, 0x105u, 1u);
+        for (uint32_t bank = 0; bank <= 0x10u && ok; bank += 0x10u) {
+            ok = fuxi_mic_codec_write(hw, 0x120u + bank, 1u);
+        }
+        if (!ok) {
+            (void)fuxi_mic_fail(hw, 8u, hw->faults ? FUXI_MIC_WHY_ABORT : FUXI_MIC_WHY_WRITE);
+            goto fail;
+        }
+        for (uint32_t bank = 0; bank < 2u; bank++) {
+            fuxi_mic_wr(hw, master + 0x40u * bank, 1u | (hw->lane << 24));
+            fuxi_mic_wr(hw, master + 4u + 0x40u * bank, 1u);
+            fuxi_mic_wr(hw, master + 0x10u + 0x40u * bank, 0xf0u);
+        }
+        fuxi_mic_wr(hw, master + 8u, 0u);
+        fuxi_mic_set(hw, FUXI_MIC_TX + 0x100u, 0xfu, hw->mic);
+        fuxi_mic_set(hw, FUXI_MIC_TX + 0x104u, 3u, 1u);
+        fuxi_mic_set(hw, FUXI_MIC_TX + 0x404u, (1u << 7) | (3u << 5) | (3u << 1), 2u << 5);
+        fuxi_mic_set(hw, FUXI_MIC_TX + 0x400u, 0x3fu, 4u | 0x10u);
+        fuxi_mic_set(hw, FUXI_MIC_TX + 0x400u, 0u, 0x20u);
+        if (fuxi_mic_codec_read(hw, 0x128u, &v)) hw->port_lane_rb = v;
+        if (fuxi_mic_codec_read(hw, 0x120u, &v)) hw->port_ch_rb = v;
+        hw->bus_status = fuxi_mic_rd(hw, FUXI_MIC_SWR + 0x5000u, 0);
+        if (hw->faults != 0u) { (void)fuxi_mic_fail(hw, 8u, FUXI_MIC_WHY_ABORT); goto fail; }
+        if ((hw->bus_status & ((1u << 3) | (1u << 7))) != 0u) {
+            (void)fuxi_mic_fail(hw, 8u, FUXI_MIC_WHY_BUS);
+            goto fail;
+        }
+    }
+    hw->held = true;
+    return true;
+
+fail:
+    fuxi_mic_hw_down(hw);
+    return false;
+}
+
+#endif /* FUXI_AUDIO_MIC_H */
