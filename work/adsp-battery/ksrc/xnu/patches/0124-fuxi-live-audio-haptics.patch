+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* HAP525_HV LRA 主動阻尼濾波器與反向剎車尾段產生器（ADT /chosen fuxi,haptic-damp；預設 0＝關閉）。
+ *
+ * 針對小米 13 高 Q 值 AAC SLA0809 LRA（TLRA 實測 5710 us，f0≈175.1 Hz，ζ0≈0.033）：
+ * 直接送 Apple 原始 Taptic 波形會在波形結束後自由餘振 50–65 ms（彈簧感）。
+ * 本濾波器以二階物理觀測器估測實際馬達位移／速度 (x, y)（以限幅後實際輸出 q 驅動，
+ * 具備完整抗飽和 anti-windup），施加 -2*(ζd-ζ0)*y 速度負回授並於 FIFO 排空前補入
+ * 反向剎車尾段，將餘振壓縮至 10 ms 內。
+ *
+ * ADT /chosen fuxi,haptic-damp（uint32）：
+ *   bits 0..3 : 模式（0=關，1..4=速度負回授阻尼，5=TLRA 鎖定單峰主動剎車合成 Micro-2L/Mini-4L/Full-5L，
+ *               6=145->f_LRA 頻率重取樣＋無起振阻力＋終端死拍主動剎車，
+ *               7=逆模型參考系統即時追蹤：將 Q=15 LRA 等效重塑為寬頻阻尼 Taptic 系統 (ft, ζt)，全程含抗飽和尾段，
+ *               8=原生 1:1 頻率 D22 雙相逆模型：驅動期模擬 D22 150 Hz 飽滿體感 (ζd=0.28)，尾段 1 ms 平滑切入主動剎車 (ζb=0.56)，
+ *               9=無接縫軟拐點四檔自適應雙相逆模型：STD(0) 維持後台/鍵盤原味、UNI(1) 單極性開關柔化、LP(2) 長按臨界阻尼死拍收尾、SUS(3) 來電/長震 1:1 零斷流安全連續驅動）
+ *   bits 4..7 : 增益覆寫（mode 1..4: (8+n)*32 Q8；mode 5..6: (128+n*16) Q8；mode 7: (320+n*48) Q8；mode 8: (320+n*32) Q8；mode 9: (320+n*24) Q8）
+ *   bit  8    : 0x100 啟用 HAP525 硬體 BRAKE_EN（僅在 fuxi_vibrate_stock_brake 通過時生效）
+ *   bit  9    : 0x200 關閉軟體反向剎車尾段（A/B 對照）
+ *   bits 10..13: ζ0 覆寫（0=預設 0.033=1081 Q15；1..15 = n*328 Q15）
+ *   bit  14   : 0x4000 mode 7 關閉 145->f_LRA 頻率重取樣；mode 8 尾段改以原生 f0 剎車；mode 9 原生 1:1 時序檔（205 Hz, ζd=0.36->ζb=0.58, g=1.65x）
+ *   bit  15   : 0x8000 mode 7 高俐落檔（225 Hz, ζ=0.50）；mode 8 緊實檔（160 Hz, ζd=0.28->ζb=0.58, g=2.0625x）；mode 9 溫潤 1.10x 檔（195 Hz, ζd=0.34->ζb=0.58, g=1.68x）
+ */
+#ifndef FUXI_HAPTIC_DAMP_H
+#define FUXI_HAPTIC_DAMP_H
+
+#include <stdint.h>
+#include "fuxi_haptic_pulse.h"
+
+enum {
+    FUXI_DAMP_TLRA_DEFAULT_US = 5710u,
+    FUXI_DAMP_TLRA_MIN_US = 3000u,
+    FUXI_DAMP_TLRA_MAX_US = 10000u,
+    FUXI_DAMP_SCALE = 512,
+    FUXI_DAMP_STATE_LIMIT = 16000000,
+    FUXI_DAMP_PCM_LIMIT = 126,
+    FUXI_DAMP_TAIL_MAX = 192u,
+    FUXI_DAMP_SYNTH_MAX = 512u,
+    FUXI_DAMP_TAIL_ZERO_STOP = 16u,
+    FUXI_DAMP_TAIL_RAMP = 24u,
+    FUXI_DAMP_KICK_SAMPLES = 48u,
+    FUXI_DAMP_SOFT_KNEE_SPAN = 18,
+    FUXI_DAMP_CLIFF_PAD_MIN = 8u,
+    FUXI_DAMP_SEAM_RAMP = 16u,
+    FUXI_DAMP_SEAM_MIN_JUMP = 4,
+    FUXI_DAMP_SEAM_MAX_JUMP = 64,
+    FUXI_DAMP_TAIL_STOP_STATE = 1024,
+    FUXI_DAMP_TAIL_STOP_TIGHT = 512,
+    FUXI_DAMP_M9_PROF_STD = 0u,
+    FUXI_DAMP_M9_PROF_UNI = 1u,
+    FUXI_DAMP_M9_PROF_LP = 2u,
+    FUXI_DAMP_M9_PROF_SUS = 3u,
+    FUXI_DAMP_M9_UNI_SCALE_Q8 = 224,     /* 0.875x：單極性開關（MicroTap100Hz）落於 hap9c/hap9d 中位，保留圓潤手感 */
+    FUXI_DAMP_M9_UNI_MAX_STEP = 74711u,  /* 1.14x：略收緊至貼近後台切換，避免過輕或尖硬 */
+    FUXI_DAMP_M9_LP_ZD_Q15 = 29491,      /* 0.90：長按驅動近臨界阻尼，消除共振過衝與彈簧餘振（zc=3） */
+    FUXI_DAMP_M9_LP_ZB_Q15 = 36700,      /* 1.12：長按尾段臨界死拍剎車 */
+    FUXI_DAMP_M9_LP_KX_Q15 = 11469,      /* 0.35：尾段剛度補償加速收斂 */
+    FUXI_DAMP_M9_LP_GAIN_Q8 = 420,       /* 1.641x：加重長按單擊「棟」衝擊力（+19%），零 clip 零回彈 */
+    FUXI_DAMP_M9_LP_TAIL_RAMP = 8u,      /* 0.33 ms 快速切入死拍剎車 */
+    FUXI_DAMP_M9_SUS_GAIN_Q8 = 132,      /* 0.516x：來電／長震安全連續驅動（<=2.0 Vrms 熱保護） */
+    FUXI_DAMP_M9_SUS_ZETA_Q15 = 7537,    /* 0.23：閉迴路壓制 170-175 Hz 共振撞底異響 */
+    FUXI_DAMP_M9_SUS_LIMIT = 43,         /* ±43（~2.78 Vpk / <=1.98 Vrms 連續安全上限，軟拐點 37..43） */
+    FUXI_DAMP_M9_SUS_KNEE_SPAN = 6,
+    FUXI_DAMP_M9_SUS_RAMP = 96u,         /* 4 ms 平滑過渡至 1:1 連續模式，抑制 20 ms 起震前段共振過衝 */
+    FUXI_DAMP_M9_SUS_FALLBACK_IN = 864u, /* 36 ms：超過單次 FullTap(34ms) 之長震動在 FIFO 排空前自動切入 1:1 連續模式 */
+    FUXI_DAMP_M9_TAIL_REL_RAMP = 16u,    /* 0.67 ms：連續震動突停（如接聽來電）平滑淡出末值消爆音 */
+    FUXI_DAMP_M9_LP_REP_SHORT_MS = 150u, /* <=150 ms 短間隔連發強拍（斷音／交響樂／連擊）立即退讓 */
+    FUXI_DAMP_M9_LP_REP_STREAK_MS = 380u,/* <=380 ms 累計連發（保留 2 次手電筒雙擊全幅，第 3 次起退讓） */
+    FUXI_DAMP_M9_SUS_CHAIN_GAP_MS = 300u,/* <=300 ms 緊接長震後之強拍／續段直接繼承連續安全保護 */
+    FUXI_DAMP_M9_LP_REP2_GAIN_Q8 = 260,  /* 1.016x：連發第 2 級退讓增益 */
+    FUXI_DAMP_M9_LP_REP2_LIMIT = 72,     /* ±72：連發第 2 級軟拐點上限 */
+    FUXI_DAMP_M9_LP_REP3_GAIN_Q8 = 210,  /* 0.820x：高頻連發／SUS 夾擊強拍（ResCalibration）安全增益 */
+    FUXI_DAMP_M9_LP_REP3_LIMIT = 56,     /* ±56：高頻連發／SUS 夾擊強拍軟拐點上限 */
+    FUXI_DAMP_M9_REP_KNEE_SPAN = 10,     /* ±50..109 中檔軟拐點寬度 */
+    FUXI_DAMP_M9_ENV_KNEE_NORM_S = 244 * FUXI_DAMP_SCALE, /* 單發瞬態位移護欄起點（高於單次長按 243.1，單發零改動） */
+    FUXI_DAMP_M9_ENV_CEIL_NORM_S = 284 * FUXI_DAMP_SCALE, /* 單發瞬態位移護欄頂點（寬 40 單位平滑降驅動，杜絕撞底） */
+    FUXI_DAMP_M9_ENV_KNEE_SUS_S = 155 * FUXI_DAMP_SCALE,  /* 連續／連發位移護欄起點 */
+    FUXI_DAMP_M9_ENV_CEIL_SUS_S = 195 * FUXI_DAMP_SCALE,  /* 連續／連發位移護欄頂點 */
+    FUXI_DAMP_FLAG_HW_BRAKE = 0x100u,
+    FUXI_DAMP_FLAG_NO_TAIL = 0x200u,
+    FUXI_DAMP_FLAG_NO_PITCH = 0x4000u,
+    FUXI_DAMP_FLAG_CRISP_HIGH = 0x8000u,
+};
+
+typedef struct {
+    uint32_t cfg;
+    uint32_t tlra_us;
+    uint32_t mode;
+    int32_t alpha_q15;
+    int32_t two_z0_q15;
+    int32_t k_fb_q15;
+    int32_t gain_q8;
+    int32_t kick_q8;
+    int32_t c_r_q8;
+    int32_t c_x_q15;
+    int32_t c_y_q15;
+    int32_t c_x_tl_q15;
+    int32_t c_y_tl_q15;
+    int32_t m9_uni_cr_q8;
+    uint32_t m9_uni_step_q16;
+    int32_t m9_lp_cr_q8;
+    int32_t m9_lp_cy_q15;
+    int32_t m9_lp_cxt_q15;
+    int32_t m9_lp_cyt_q15;
+    int32_t m9_sus_cr_q8;
+    int32_t m9_sus_cy_q15;
+    uint32_t pitch_step_q16;
+    int no_tail;
+    int no_pitch;
+    int hw_brake_req;
+    int soft_knee;
+    int32_t x;
+    int32_t y;
+    int32_t prev_u;
+    int32_t last_sign;
+    uint32_t burst_samples;
+    uint32_t pitch_phase_q16;
+    uint32_t m9_burst_in;
+    uint16_t m9_sus_prog;
+    uint16_t m9_in_zc;
+    uint16_t m9_repeat_energy;
+    uint8_t m9_prof;
+    uint8_t m9_sus_active;
+    int8_t m9_last_r;
+    int8_t m9_in_sign;
+    uint8_t m9_repeat_level;
+    uint8_t m9_prev_prof;
+    uint8_t m9_prev_was_sus;
+    uint8_t m9_lp_streak;
+    uint8_t out_rem[4];
+    uint8_t out_rem_len;
+    int8_t prev_in;
+    int8_t prev_in2;
+    uint8_t has_prev_in;
+} FuxiHapticDamp;
+
+static inline uint32_t fuxi_damp_read_tlra(const FuxiHapticIo *io)
+{
+    uint8_t msb = 0, lsb = 0;
+    if (!io || fuxi_haptic_read_stable(io, 0xf05c, &msb) ||
+        fuxi_haptic_read_stable(io, 0xf05d, &lsb)) {
+        return FUXI_DAMP_TLRA_DEFAULT_US;
+    }
+    uint32_t tlra = ((((uint32_t)msb & 0x0fu) << 8) | (uint32_t)lsb) * 5u;
+    if (tlra < FUXI_DAMP_TLRA_MIN_US || tlra > FUXI_DAMP_TLRA_MAX_US) {
+        return FUXI_DAMP_TLRA_DEFAULT_US;
+    }
+    return tlra;
+}
+
+static inline void fuxi_damp_mode9_restart_burst(FuxiHapticDamp *damp)
+{
+    if (!damp) return;
+    damp->pitch_phase_q16 = 0;
+    damp->out_rem_len = 0;
+    damp->burst_samples = 0;
+    damp->has_prev_in = 0;
+    damp->prev_in = 0;
+    damp->prev_in2 = 0;
+    damp->m9_burst_in = 0;
+    damp->m9_sus_prog = 0;
+    damp->m9_in_zc = 0;
+    damp->m9_prof = FUXI_DAMP_M9_PROF_STD;
+    damp->m9_sus_active = 0;
+    damp->m9_last_r = 0;
+    damp->m9_in_sign = 0;
+}
+
+/* 新突發起播前依與前次結束之間隔指數衰減連發能量，更新 m9_repeat_level 並重設突發內狀態（不更動觀測器 x/y 以相容背靠背接續）。 */
+static inline void fuxi_damp_mode9_on_burst_start(FuxiHapticDamp *damp, uint64_t gap_ns)
+{
+    if (!damp) return;
+    fuxi_damp_mode9_restart_burst(damp);
+    if (damp->mode != 9u) return;
+    uint64_t gap_ms = gap_ns / 1000000ull;
+    if (gap_ms >= 1000ull) {
+        damp->m9_repeat_energy = 0;
+        damp->m9_lp_streak = 0;
+        damp->m9_prev_was_sus = 0;
+    } else {
+        unsigned steps = (unsigned)(gap_ms / 32ull);
+        uint32_t e = damp->m9_repeat_energy;
+        for (unsigned i = 0; i < steps && e > 0u; i++) {
+            e = (e * 226u) >> 8;
+        }
+        damp->m9_repeat_energy = (uint16_t)e;
+        if (gap_ms > FUXI_DAMP_M9_LP_REP_STREAK_MS) damp->m9_lp_streak = 0;
+        if (gap_ms > FUXI_DAMP_M9_SUS_CHAIN_GAP_MS) damp->m9_prev_was_sus = 0;
+    }
+    uint8_t lvl = 0;
+    if (damp->m9_prev_was_sus && gap_ms <= FUXI_DAMP_M9_SUS_CHAIN_GAP_MS) {
+        lvl = 3u;
+    } else if (damp->m9_lp_streak >= 1u && gap_ms <= FUXI_DAMP_M9_LP_REP_SHORT_MS) {
+        lvl = (damp->m9_lp_streak >= 2u || damp->m9_repeat_energy >= 380u) ? 3u : 2u;
+    } else if (damp->m9_lp_streak >= 2u && gap_ms <= FUXI_DAMP_M9_LP_REP_STREAK_MS) {
+        lvl = (damp->m9_lp_streak >= 3u || damp->m9_repeat_energy >= 420u) ? 3u : 2u;
+    }
+    damp->m9_repeat_level = lvl;
+}
+
+/* 突發結束（排空、停振或背靠背尾段切換）時累計長震／高能強拍歷史，避免交響樂／斷音與高頻連擊爆震撞底。 */
+static inline void fuxi_damp_mode9_on_burst_end(FuxiHapticDamp *damp, unsigned raw_pk, unsigned burst_bytes)
+{
+    if (!damp || damp->mode != 9u) return;
+    damp->m9_prev_prof = damp->m9_prof;
+    int was_sus = (damp->m9_prof == FUXI_DAMP_M9_PROF_SUS || damp->m9_sus_active) ? 1 : 0;
+    if (was_sus) {
+        damp->m9_prev_was_sus = 1;
+        uint32_t add = burst_bytes >= 2400u ? 512u : 384u;
+        uint32_t ne = (uint32_t)damp->m9_repeat_energy + add;
+        damp->m9_repeat_energy = (uint16_t)(ne > 1024u ? 1024u : ne);
+        if (damp->m9_lp_streak < 15u) damp->m9_lp_streak++;
+    } else if (damp->m9_prof == FUXI_DAMP_M9_PROF_LP ||
+               (damp->m9_prof == FUXI_DAMP_M9_PROF_STD && raw_pk >= 100u)) {
+        if (damp->m9_repeat_level < 3u) damp->m9_prev_was_sus = 0;
+        uint32_t ne = (uint32_t)damp->m9_repeat_energy + 256u;
+        damp->m9_repeat_energy = (uint16_t)(ne > 1024u ? 1024u : ne);
+        if (damp->m9_lp_streak < 15u) damp->m9_lp_streak++;
+    } else if (damp->m9_prof == FUXI_DAMP_M9_PROF_UNI || raw_pk < 80u) {
+        damp->m9_lp_streak = 0;
+        damp->m9_prev_was_sus = 0;
+    }
+}
+
+static inline void fuxi_damp_reset(FuxiHapticDamp *damp)
+{
+    if (!damp) return;
+    damp->x = 0;
+    damp->y = 0;
+    damp->prev_u = 0;
+    damp->last_sign = 0;
+    fuxi_damp_mode9_restart_burst(damp);
+}
+
+static inline void fuxi_damp_init(FuxiHapticDamp *damp, uint32_t cfg, uint32_t tlra_us)
+{
+    if (!damp) return;
+    *damp = (FuxiHapticDamp){0};
+    if (tlra_us < FUXI_DAMP_TLRA_MIN_US || tlra_us > FUXI_DAMP_TLRA_MAX_US) {
+        tlra_us = FUXI_DAMP_TLRA_DEFAULT_US;
+    }
+    damp->cfg = cfg;
+    damp->tlra_us = tlra_us;
+    damp->hw_brake_req = (cfg & FUXI_DAMP_FLAG_HW_BRAKE) != 0;
+    damp->no_tail = (cfg & FUXI_DAMP_FLAG_NO_TAIL) != 0;
+    damp->no_pitch = (cfg & FUXI_DAMP_FLAG_NO_PITCH) != 0;
+
+    uint32_t mode = cfg & 0x0fu;
+    if (mode > 9u) mode = 0u;
+    damp->mode = mode;
+    if (!mode) return;
+
+    int32_t zd_q15 = 21299; /* 0.65 */
+    int32_t zb_q15 = 18350; /* 0.56 */
+    int32_t gain_q8 = 410;  /* 1.60x */
+    int32_t kick_q8 = 0;
+    const int crisp_high = (cfg & FUXI_DAMP_FLAG_CRISP_HIGH) != 0;
+    const int tail_f0 = damp->no_pitch;
+    if (mode == 1u) {
+        zd_q15 = 14746;     /* 0.45 */
+        gain_q8 = 384;      /* 1.50x */
+    } else if (mode == 3u) {
+        zd_q15 = 27853;     /* 0.85 */
+        gain_q8 = 448;      /* 1.75x */
+    } else if (mode == 4u) {
+        zd_q15 = 21299;     /* 0.65 */
+        gain_q8 = 410;      /* 1.60x */
+        kick_q8 = 90;       /* ~0.35x 2 ms onset derivative kick */
+    } else if (mode == 5u) {
+        zd_q15 = 0;
+        gain_q8 = 256;      /* 1.00x */
+    } else if (mode == 6u) {
+        zd_q15 = 0;
+        gain_q8 = 288;      /* 1.125x */
+    } else if (mode == 7u) {
+        zd_q15 = crisp_high ? 16384 : 14418; /* 0.50 vs 0.44 */
+        gain_q8 = crisp_high ? 592 : 608;    /* 2.3125x vs 2.375x */
+    } else if (mode == 8u) {
+        zd_q15 = 9175;                        /* 0.28：保留 D22 低頻飽滿體感 */
+        zb_q15 = crisp_high ? 19005 : 18350;  /* 0.58 vs 0.56：尾段平滑剎車收尾 */
+        gain_q8 = crisp_high ? 528 : 512;     /* 2.0625x vs 2.00x */
+        damp->no_pitch = 1;                   /* 原生 1:1 頻率與時長，不做升頻壓縮 */
+    } else if (mode == 9u) {
+        damp->soft_knee = 1;
+        zb_q15 = 19005;                       /* 0.58：尾段 1 ms 斜坡切入原生 f0 主動剎車 */
+        if (damp->no_pitch) {
+            zd_q15 = 11796;                   /* 0.36：1:1 原生時序檔 */
+            gain_q8 = 422;                    /* 1.648x */
+        } else if (crisp_high) {
+            zd_q15 = 11141;                   /* 0.34：溫潤 1.10x 檔 */
+            gain_q8 = 430;                    /* 1.680x */
+        } else {
+            zd_q15 = 12452;                   /* 0.38：預設 1.208x 俐落檔（鍵盤／切換器／長按全段零削波） */
+            gain_q8 = 456;                    /* 1.781x */
+        }
+    }
+
+    uint32_t gain_nibble = (cfg >> 4) & 0x0fu;
+    if (gain_nibble != 0u) {
+        if (mode == 7u) {
+            gain_q8 = (int32_t)(320u + gain_nibble * 48u);
+        } else if (mode == 8u) {
+            gain_q8 = (int32_t)(320u + gain_nibble * 32u);
+        } else if (mode == 9u) {
+            gain_q8 = (int32_t)(320u + gain_nibble * 24u);
+        } else if (mode >= 5u) {
+            gain_q8 = (int32_t)(128u + gain_nibble * 16u);
+        } else {
+            gain_q8 = (int32_t)((8u + gain_nibble) * 32u);
+        }
+    }
+    uint32_t z0_field = (cfg >> 10) & 0x0fu;
+    int32_t z0_q15 = z0_field ? (int32_t)(z0_field * 328u) : 1081; /* default 0.033 */
+
+    int32_t diff = zd_q15 - z0_q15;
+    if (diff < 0) diff = 0;
+    /* alpha = 2*pi / (24000 * tlra_us * 1e-6); alpha_q15 = 8578642 / tlra_us */
+    damp->alpha_q15 = (int32_t)(8578642u / tlra_us);
+    damp->two_z0_q15 = 2 * z0_q15;
+    damp->k_fb_q15 = 2 * diff;
+    damp->gain_q8 = gain_q8;
+    damp->kick_q8 = kick_q8;
+    if (mode == 7u) {
+        const int64_t ft_hz = crisp_high ? 225 : 210;
+        const int64_t zt_q15 = zd_q15;
+        const int64_t rho_q15 = (ft_hz * (int64_t)tlra_us * 32768 + 500000) / 1000000;
+        const int64_t rho2_q15 = (rho_q15 * rho_q15 + 16384) / 32768;
+        damp->c_r_q8 = (int32_t)((rho2_q15 * (int64_t)gain_q8 + 16384) / 32768);
+        damp->c_x_q15 = (int32_t)(32768 - rho2_q15);
+        damp->c_y_q15 = (int32_t)(2 * (int64_t)z0_q15 - 2 * ((rho_q15 * zt_q15 + 16384) / 32768));
+    } else if (mode == 8u) {
+        const int64_t ft_hz = crisp_high ? 160 : 150;
+        const int64_t rho_q15 = (ft_hz * (int64_t)tlra_us * 32768 + 500000) / 1000000;
+        const int64_t rho2_q15 = (rho_q15 * rho_q15 + 16384) / 32768;
+        damp->c_r_q8 = (int32_t)((rho2_q15 * (int64_t)gain_q8 + 16384) / 32768);
+        damp->c_x_q15 = (int32_t)(32768 - rho2_q15);
+        damp->c_y_q15 = (int32_t)(2 * (int64_t)z0_q15 - 2 * ((rho_q15 * (int64_t)zd_q15 + 16384) / 32768));
+        if (tail_f0) {
+            damp->c_x_tl_q15 = 0;
+            damp->c_y_tl_q15 = (int32_t)(2 * (int64_t)z0_q15 - 2 * (int64_t)zb_q15);
+        } else {
+            damp->c_x_tl_q15 = damp->c_x_q15;
+            damp->c_y_tl_q15 = (int32_t)(2 * (int64_t)z0_q15 - 2 * ((rho_q15 * (int64_t)zb_q15 + 16384) / 32768));
+        }
+    } else if (mode == 9u) {
+        const int64_t ft_hz = damp->no_pitch ? 205 : (crisp_high ? 195 : 210);
+        const int64_t rho_q15 = (ft_hz * (int64_t)tlra_us * 32768 + 500000) / 1000000;
+        const int64_t rho2_q15 = (rho_q15 * rho_q15 + 16384) / 32768;
+        damp->c_r_q8 = (int32_t)((rho2_q15 * (int64_t)gain_q8 + 16384) / 32768);
+        damp->c_x_q15 = (int32_t)(32768 - rho2_q15);
+        damp->c_y_q15 = (int32_t)(2 * (int64_t)z0_q15 - 2 * ((rho_q15 * (int64_t)zd_q15 + 16384) / 32768));
+        damp->c_x_tl_q15 = 0;
+        damp->c_y_tl_q15 = (int32_t)(2 * (int64_t)z0_q15 - 2 * (int64_t)zb_q15);
+        /* UNI(1)：單極性開關柔化 */
+        const int64_t uni_gain = ((int64_t)gain_q8 * FUXI_DAMP_M9_UNI_SCALE_Q8 + 128) / 256;
+        damp->m9_uni_cr_q8 = (int32_t)((rho2_q15 * uni_gain + 16384) / 32768);
+        /* LP(2)：長按／手電筒重按臨界阻尼驅動＋快速死拍收尾 */
+        const int64_t lp_gain = ((int64_t)gain_q8 * FUXI_DAMP_M9_LP_GAIN_Q8 + 128) / 256;
+        damp->m9_lp_cr_q8 = (int32_t)((rho2_q15 * lp_gain + 16384) / 32768);
+        damp->m9_lp_cy_q15 = (int32_t)(2 * (int64_t)z0_q15 - 2 * ((rho_q15 * (int64_t)FUXI_DAMP_M9_LP_ZD_Q15 + 16384) / 32768));
+        damp->m9_lp_cxt_q15 = -(int32_t)FUXI_DAMP_M9_LP_KX_Q15;
+        damp->m9_lp_cyt_q15 = (int32_t)(2 * (int64_t)z0_q15 - 2 * (int64_t)FUXI_DAMP_M9_LP_ZB_Q15);
+        /* SUS(3)：來電鈴聲／長震動 1:1 零斷流安全連續閉迴路驅動 */
+        damp->m9_sus_cr_q8 = FUXI_DAMP_M9_SUS_GAIN_Q8;
+        damp->m9_sus_cy_q15 = (int32_t)(2 * (int64_t)z0_q15 - 2 * (int64_t)FUXI_DAMP_M9_SUS_ZETA_Q15);
+    }
+    /* pitch_step = (f_LRA / base_hz) in Q16；mode 9 溫潤檔以 159 Hz 為基準（約 1.10x），其餘以 145 Hz（約 1.208x）。 */
+    uint64_t pitch_base_hz = (mode == 9u && crisp_high && !damp->no_pitch) ? 159ull : 145ull;
+    uint64_t denom = pitch_base_hz * (uint64_t)tlra_us;
+    uint32_t step = (mode == 9u && damp->no_pitch) ? 65536u :
+        (uint32_t)((65536000000ull + denom / 2ull) / denom);
+    if (step < 32768u) step = 32768u;
+    if (step > 131072u) step = 131072u;
+    damp->pitch_step_q16 = step;
+    if (mode == 9u) {
+        damp->m9_uni_step_q16 = step > FUXI_DAMP_M9_UNI_MAX_STEP ? FUXI_DAMP_M9_UNI_MAX_STEP : step;
+    }
+}
+
+static inline int32_t fuxi_damp_clamp(int64_t val, int32_t lo, int32_t hi)
+{
+    if (val < (int64_t)lo) return lo;
+    if (val > (int64_t)hi) return hi;
+    return (int32_t)val;
+}
+
+static inline void fuxi_damp_observe(FuxiHapticDamp *damp, int8_t out, unsigned *zc_out)
+{
+    int64_t q_s = (int64_t)out * FUXI_DAMP_SCALE;
+    int64_t damp_term = ((int64_t)damp->two_z0_q15 * (int64_t)damp->y) / 32768;
+    int64_t err = q_s - (int64_t)damp->x - damp_term;
+    int64_t y_next = (int64_t)damp->y + ((int64_t)damp->alpha_q15 * err) / 32768;
+    int64_t x_next = (int64_t)damp->x + ((int64_t)damp->alpha_q15 * y_next) / 32768;
+    damp->y = fuxi_damp_clamp(y_next, -FUXI_DAMP_STATE_LIMIT, FUXI_DAMP_STATE_LIMIT);
+    damp->x = fuxi_damp_clamp(x_next, -FUXI_DAMP_STATE_LIMIT, FUXI_DAMP_STATE_LIMIT);
+
+    int32_t sign = out > 0 ? 1 : (out < 0 ? -1 : 0);
+    if (sign) {
+        if (damp->last_sign && sign != damp->last_sign && zc_out) (*zc_out)++;
+        damp->last_sign = sign;
+    }
+}
+
+static inline int8_t fuxi_damp_step(FuxiHapticDamp *damp, int8_t raw, unsigned *zc_out)
+{
+    int64_t u_s = (int64_t)raw * (int64_t)damp->gain_q8 * 2; /* Q8 * 512 / 256 = * 2 */
+    if (damp->kick_q8 && damp->burst_samples < FUXI_DAMP_KICK_SAMPLES) {
+        int64_t du = (int64_t)raw - (int64_t)damp->prev_u;
+        u_s += du * (int64_t)damp->kick_q8 * 2;
+    }
+    damp->prev_u = raw;
+    if (damp->burst_samples < FUXI_DAMP_KICK_SAMPLES) damp->burst_samples++;
+
+    int64_t fb_s = ((int64_t)damp->k_fb_q15 * (int64_t)damp->y) / 32768;
+    int64_t cmd_s = u_s - fb_s;
+    int64_t rounded = cmd_s >= 0 ? (cmd_s + 256) / 512 : -((-cmd_s + 256) / 512);
+    int8_t out = (int8_t)fuxi_damp_clamp(rounded, -FUXI_DAMP_PCM_LIMIT, FUXI_DAMP_PCM_LIMIT);
+
+    /* Anti-windup observer driven by actual post-clamp output q * 512 */
+    fuxi_damp_observe(damp, out, zc_out);
+    return out;
+}
+
+static inline int8_t fuxi_damp_deadbeat_step(FuxiHapticDamp *damp, unsigned tail_limit, unsigned *zc_out)
+{
+    /* u = clamp(-2.0 * y - 0.3 * x, -lim, +lim)；依驅動峰值比例限幅，避免輕觸尾段反打 ±126 爆震 */
+    int32_t lim = (tail_limit > 0u && tail_limit <= FUXI_DAMP_PCM_LIMIT) ?
+        (int32_t)tail_limit : FUXI_DAMP_PCM_LIMIT;
+    int64_t cmd_s = -((2048ll * (int64_t)damp->y + 307ll * (int64_t)damp->x) / 1024ll);
+    int64_t rounded = cmd_s >= 0 ? (cmd_s + 256) / 512 : -((-cmd_s + 256) / 512);
+    int8_t out = (int8_t)fuxi_damp_clamp(rounded, -lim, lim);
+    fuxi_damp_observe(damp, out, zc_out);
+    return out;
+}
+
+/* Mode 5：依輸入突發的幅度／過零／有效長度分類為 Micro-2L、Mini-4L 或 Full-5L，
+ * 以實測 TLRA（0xf05c/0xf05d）鎖定半週期合成單峰無雙振主動剎車波，保留原始起振極性與強度層次。 */
+static inline unsigned fuxi_damp_synth_transient(FuxiHapticDamp *damp, const uint8_t *in, unsigned in_len,
+    uint8_t *out, unsigned max_out, unsigned *out_peak, unsigned *zc_out, unsigned *profile_out)
+{
+    static const int16_t sin_q14[65] = {
+            0,   804,  1606,  2404,  3196,  3981,  4756,  5520,
+         6270,  7005,  7723,  8423,  9102,  9760, 10394, 11003,
+        11585, 12140, 12665, 13160, 13623, 14053, 14449, 14811,
+        15137, 15426, 15679, 15893, 16069, 16207, 16305, 16364,
+        16384, 16364, 16305, 16207, 16069, 15893, 15679, 15426,
+        15137, 14811, 14449, 14053, 13623, 13160, 12665, 12140,
+        11585, 11003, 10394,  9760,  9102,  8423,  7723,  7005,
+         6270,  5520,  4756,  3981,  3196,  2404,  1606,   804,
+            0
+    };
+    static const int8_t micro_lobes[2] = { 126, 113 };
+    static const int8_t mini_lobes[4]  = { 126, -126, -126, 73 };
+    static const int8_t full_lobes[5]  = { 96, -126, 96, 126, -111 };
+
+    if (!damp || !in || !in_len || !out || max_out < 4u) return 0;
+    unsigned raw_peak = 0, first_nz = in_len, last_nz = 0, in_zc = 0;
+    int last_s = 0;
+    for (unsigned i = 0; i < in_len; i++) {
+        int v = (int8_t)in[i];
+        unsigned m = (unsigned)(v < 0 ? -v : v);
+        if (m > raw_peak) raw_peak = m;
+        if (m >= 4u) {
+            if (first_nz == in_len) first_nz = i;
+            last_nz = i;
+            int s = v > 0 ? 1 : -1;
+            if (last_s && s != last_s) in_zc++;
+            last_s = s;
+        }
+    }
+    if (!raw_peak) return 0;
+    unsigned active_len = first_nz < in_len ? (last_nz - first_nz + 1u) : 0u;
+    unsigned pol_thresh = raw_peak / 4u;
+    if (pol_thresh < 4u) pol_thresh = 4u;
+    int pol = 1;
+    for (unsigned i = 0; i < in_len; i++) {
+        int v = (int8_t)in[i];
+        unsigned m = (unsigned)(v < 0 ? -v : v);
+        if (m >= pol_thresh) {
+            pol = v < 0 ? -1 : 1;
+            break;
+        }
+    }
+
+    unsigned profile = 2u;
+    const int8_t *lobes = mini_lobes;
+    unsigned lobe_count = 4u;
+    int32_t amp_q8 = 256;
+    if (raw_peak >= 104u || (raw_peak >= 94u && (in_zc >= 4u || active_len >= 280u))) {
+        profile = 3u;
+        lobes = full_lobes;
+        lobe_count = 5u;
+        unsigned above = raw_peak > 104u ? (raw_peak - 104u) : 0u;
+        amp_q8 = 216 + (int32_t)((above * 40u) / 22u);
+        if (amp_q8 > 256) amp_q8 = 256;
+    } else if (raw_peak < 72u) {
+        profile = 1u;
+        lobes = micro_lobes;
+        lobe_count = 2u;
+        amp_q8 = 96 + (int32_t)((raw_peak * 136u) / 72u);
+        if (amp_q8 > 232) amp_q8 = 232;
+    } else {
+        unsigned above = raw_peak > 72u ? (raw_peak - 72u) : 0u;
+        amp_q8 = 148 + (int32_t)((above * 76u) / 32u);
+        if (amp_q8 > 228) amp_q8 = 228;
+    }
+
+    int64_t scale_q8 = ((int64_t)amp_q8 * (int64_t)damp->gain_q8 + 128) / 256;
+    if (scale_q8 < 64) scale_q8 = 64;
+    if (scale_q8 > 512) scale_q8 = 512;
+
+    uint64_t half_den = (uint64_t)damp->tlra_us * 12ull;
+    unsigned n = (unsigned)(((uint64_t)lobe_count * half_den + 500ull) / 1000ull);
+    unsigned n4 = (n + 3u) & ~3u;
+    unsigned cap = max_out & ~3u;
+    if (n4 > cap) n4 = cap;
+    if (n4 < 4u) return 0;
+
+    unsigned peak = 0;
+    for (unsigned s = 0; s < n4; s++) {
+        int8_t sample = 0;
+        if (s < n) {
+            uint64_t pos_q16 = ((uint64_t)s * 65536000ull) / half_den;
+            unsigned lobe = (unsigned)(pos_q16 >> 16);
+            if (lobe < lobe_count) {
+                uint32_t frac = (uint32_t)(pos_q16 & 0xffffu);
+                unsigned idx = frac >> 10;
+                uint32_t sub = frac & 0x3ffu;
+                int32_t sv = sin_q14[idx] + (((sin_q14[idx + 1u] - sin_q14[idx]) * (int32_t)sub) >> 10);
+                int64_t prod = (int64_t)pol * (int64_t)lobes[lobe] * (int64_t)sv * scale_q8;
+                int64_t rounded = prod >= 0 ? (prod + 2097152ll) / 4194304ll : -((-prod + 2097152ll) / 4194304ll);
+                sample = (int8_t)fuxi_damp_clamp(rounded, -FUXI_DAMP_PCM_LIMIT, FUXI_DAMP_PCM_LIMIT);
+            }
+        }
+        out[s] = (uint8_t)sample;
+        fuxi_damp_observe(damp, sample, zc_out);
+        unsigned mag = (unsigned)(sample < 0 ? -(int)sample : (int)sample);
+        if (mag > peak) peak = mag;
+    }
+    if (out_peak) *out_peak = peak;
+    if (profile_out) *profile_out = profile;
+    return n4;
+}
+
+/* Mode 6（及 Mode 5 超過 36 ms 的連續模式接手）：將 Apple 145 Hz 基準波重取樣對齊至 LRA 共振頻率，
+ * 起振過程零速度阻力以維持爆發力，同時持續更新 (x, y) 物理觀測器供終端死拍剎車使用。 */
+static inline unsigned fuxi_damp_process_pitch(FuxiHapticDamp *damp, const uint8_t *in, unsigned in_len,
+    uint8_t *out, unsigned max_out, unsigned *out_peak, unsigned *zc_out)
+{
+    if (!damp || !in || !in_len || !out || max_out < 4u) return 0;
+    unsigned cap = max_out & ~3u;
+    unsigned out_n = 0, peak = 0;
+    uint32_t phase = damp->pitch_phase_q16;
+    uint32_t step = damp->pitch_step_q16 ? damp->pitch_step_q16 : 65536u;
+    while ((phase >> 16) < in_len && out_n < cap) {
+        unsigned idx = phase >> 16;
+        uint32_t frac = phase & 0xffffu;
+        int32_t s0 = (int8_t)in[idx];
+        int32_t s1 = (idx + 1u < in_len) ? (int8_t)in[idx + 1u] : s0;
+        int32_t interp = s0 + (((s1 - s0) * (int32_t)frac) >> 16);
+        int64_t scaled = (int64_t)interp * (int64_t)damp->gain_q8;
+        int64_t rounded = scaled >= 0 ? (scaled + 128) / 256 : -((-scaled + 128) / 256);
+        int8_t sample = (int8_t)fuxi_damp_clamp(rounded, -FUXI_DAMP_PCM_LIMIT, FUXI_DAMP_PCM_LIMIT);
+        out[out_n++] = (uint8_t)sample;
+        fuxi_damp_observe(damp, sample, zc_out);
+        unsigned mag = (unsigned)(sample < 0 ? -(int)sample : (int)sample);
+        if (mag > peak) peak = mag;
+        phase += step;
+    }
+    if ((phase >> 16) >= in_len) {
+        damp->pitch_phase_q16 = phase - (in_len << 16);
+    } else {
+        damp->pitch_phase_q16 = 0;
+    }
+    if (!out_n) return 0;
+    unsigned padded = (out_n + 3u) & ~3u;
+    if (padded > cap) padded = cap;
+    for (unsigned i = out_n; i < padded; i++) {
+        out[i] = 0;
+        fuxi_damp_observe(damp, 0, zc_out);
+    }
+    if (out_peak) *out_peak = peak;
+    return padded;
+}
+
+/* mode 7 單步逆模型參考追蹤：u = ρ²*g*r + (1-ρ²)*x + 2*(ζ0 - ρ*ζt)*y，限幅後回灌觀測器防積分飽和。 */
+static inline int8_t fuxi_damp_mode7_step(FuxiHapticDamp *damp, int8_t raw, unsigned limit, unsigned *zc_out)
+{
+    int32_t lim = (int32_t)(limit > FUXI_DAMP_PCM_LIMIT ? FUXI_DAMP_PCM_LIMIT : limit);
+    int64_t fb = ((int64_t)damp->c_x_q15 * (int64_t)damp->x +
+        (int64_t)damp->c_y_q15 * (int64_t)damp->y) / 32768;
+    int64_t cmd_s = (int64_t)raw * (int64_t)damp->c_r_q8 * 2 + fb;
+    int64_t rounded = cmd_s >= 0 ? (cmd_s + FUXI_DAMP_SCALE / 2) / FUXI_DAMP_SCALE
+        : -((-cmd_s + FUXI_DAMP_SCALE / 2) / FUXI_DAMP_SCALE);
+    int8_t out = (int8_t)fuxi_damp_clamp(rounded, -lim, lim);
+    fuxi_damp_observe(damp, out, zc_out);
+    return out;
+}
+
+/* mode 8 尾段剎車單步：前 24 樣本 (1 ms) 由驅動阻尼線性斜坡切入剎車阻尼，消除交界階躍雜訊。 */
+static inline int8_t fuxi_damp_mode8_tail_step(FuxiHapticDamp *damp, unsigned step_idx,
+    unsigned limit, unsigned *zc_out)
+{
+    int32_t lim = (int32_t)(limit > FUXI_DAMP_PCM_LIMIT ? FUXI_DAMP_PCM_LIMIT : limit);
+    int32_t cx = damp->c_x_tl_q15;
+    int32_t cy = damp->c_y_tl_q15;
+    if (step_idx < FUXI_DAMP_TAIL_RAMP) {
+        int64_t k = (int64_t)(step_idx + 1u);
+        cx = damp->c_x_q15 + (int32_t)(((int64_t)(damp->c_x_tl_q15 - damp->c_x_q15) * k) / FUXI_DAMP_TAIL_RAMP);
+        cy = damp->c_y_q15 + (int32_t)(((int64_t)(damp->c_y_tl_q15 - damp->c_y_q15) * k) / FUXI_DAMP_TAIL_RAMP);
+    }
+    int64_t fb = ((int64_t)cx * (int64_t)damp->x + (int64_t)cy * (int64_t)damp->y) / 32768;
+    int64_t rounded = fb >= 0 ? (fb + FUXI_DAMP_SCALE / 2) / FUXI_DAMP_SCALE
+        : -((-fb + FUXI_DAMP_SCALE / 2) / FUXI_DAMP_SCALE);
+    int8_t out = (int8_t)fuxi_damp_clamp(rounded, -lim, lim);
+    fuxi_damp_observe(damp, out, zc_out);
+    return out;
+}
+
+/* mode 7：可選 145->f_LRA 頻率重取樣，經逆模型參考追蹤轉出 4B 對齊 24 kHz PCM。 */
+static inline unsigned fuxi_damp_process_mode7(FuxiHapticDamp *damp, const uint8_t *in, unsigned in_len,
+    uint8_t *out, unsigned max_len, unsigned *out_peak, unsigned *zc_out)
+{
+    if (!damp || !in || !in_len || !out || max_len < 4u) return 0;
+    const unsigned cap = max_len & ~3u;
+    unsigned out_n = 0, peak = 0;
+    if (damp->no_pitch) {
+        unsigned n = in_len < cap ? in_len : cap;
+        for (unsigned i = 0; i < n; i++) {
+            int8_t sample = fuxi_damp_mode7_step(damp, (int8_t)in[i], FUXI_DAMP_PCM_LIMIT, zc_out);
+            out[out_n++] = (uint8_t)sample;
+            unsigned mag = (unsigned)(sample < 0 ? -(int)sample : (int)sample);
+            if (mag > peak) peak = mag;
+        }
+    } else {
+        uint32_t phase = damp->pitch_phase_q16;
+        uint32_t step = damp->pitch_step_q16 ? damp->pitch_step_q16 : 65536u;
+        while ((phase >> 16) < in_len && out_n < cap) {
+            unsigned idx = phase >> 16;
+            uint32_t frac = phase & 0xffffu;
+            int32_t s0 = (int8_t)in[idx];
+            int32_t s1 = (idx + 1u < in_len) ? (int8_t)in[idx + 1u] : s0;
+            int32_t interp = s0 + (((s1 - s0) * (int32_t)frac) >> 16);
+            int8_t sample = fuxi_damp_mode7_step(damp, (int8_t)interp, FUXI_DAMP_PCM_LIMIT, zc_out);
+            out[out_n++] = (uint8_t)sample;
+            unsigned mag = (unsigned)(sample < 0 ? -(int)sample : (int)sample);
+            if (mag > peak) peak = mag;
+            phase += step;
+        }
+        if ((phase >> 16) >= in_len) {
+            damp->pitch_phase_q16 = phase - (in_len << 16);
+        } else {
+            damp->pitch_phase_q16 = 0;
+        }
+    }
+    if (!out_n) return 0;
+    unsigned padded = (out_n + 3u) & ~3u;
+    if (padded > cap) padded = cap;
+    for (unsigned i = out_n; i < padded; i++) {
+        int8_t sample = fuxi_damp_mode7_step(damp, 0, FUXI_DAMP_PCM_LIMIT, zc_out);
+        out[i] = (uint8_t)sample;
+        unsigned mag = (unsigned)(sample < 0 ? -(int)sample : (int)sample);
+        if (mag > peak) peak = mag;
+    }
+    if (out_peak) *out_peak = peak;
+    return padded;
+}
+
+/* 軟拐點壓限：短按 ±108..126、連發退讓 ±50..109、連續安全模式 ±37..43 皆以有理曲線平滑逼近，避免平頂諧波雜訊。 */
+static inline int32_t fuxi_damp_soft_clamp(int64_t val, int32_t lim)
+{
+    int64_t span = 0;
+    if (lim >= 110) span = FUXI_DAMP_SOFT_KNEE_SPAN;
+    else if (lim >= 50) span = FUXI_DAMP_M9_REP_KNEE_SPAN;
+    else if (lim >= 36) span = FUXI_DAMP_M9_SUS_KNEE_SPAN;
+    if (span > 0) {
+        int64_t knee = (int64_t)lim - span;
+        int64_t av = val < 0 ? -val : val;
+        if (av > knee) {
+            int64_t ex = av - knee;
+            int64_t den = span + ex;
+            int64_t out = knee + (span * ex + den / 2) / den;
+            if (out > (int64_t)lim) out = (int64_t)lim;
+            return (int32_t)(val < 0 ? -out : out);
+        }
+    }
+    return fuxi_damp_clamp(val, -lim, lim);
+}
+
+/* 辨識並剔除 FuxiAudio.driver 為湊 4B 對齊而在活躍波段後插入之 1..3 筆補零毛刺（24 kHz 帶限觸感波自然收尾不會自 >=8 驟降至 0）。 */
+static inline unsigned fuxi_damp_trim_chunk_pad(const uint8_t *in, unsigned in_len)
+{
+    if (!in || in_len < 4u) return in_len;
+    unsigned tz = 0;
+    while (tz < 3u && tz + 1u < in_len && in[in_len - 1u - tz] == 0u) {
+        tz++;
+    }
+    if (tz > 0u) {
+        int prev = (int)(int8_t)in[in_len - 1u - tz];
+        unsigned mag = (unsigned)(prev < 0 ? -prev : prev);
+        if (mag >= FUXI_DAMP_CLIFF_PAD_MIN) {
+            return in_len - tz;
+        }
+    }
+    return in_len;
+}
+
+static inline void fuxi_damp_mode9_base_coeffs(const FuxiHapticDamp *damp,
+    int32_t *cr_out, int32_t *cx_out, int32_t *cy_out, uint32_t *step_out)
+{
+    uint32_t base_step = damp->no_pitch ? 65536u : (damp->pitch_step_q16 ? damp->pitch_step_q16 : 65536u);
+    if (damp->m9_prof == FUXI_DAMP_M9_PROF_UNI) {
+        *cr_out = damp->m9_uni_cr_q8;
+        *cx_out = damp->c_x_q15;
+        *cy_out = damp->c_y_q15;
+        *step_out = damp->m9_uni_step_q16 ? damp->m9_uni_step_q16 : base_step;
+    } else if (damp->m9_prof == FUXI_DAMP_M9_PROF_LP) {
+        *cr_out = damp->m9_lp_cr_q8;
+        *cx_out = damp->c_x_q15;
+        *cy_out = damp->m9_lp_cy_q15;
+        *step_out = base_step;
+    } else {
+        *cr_out = damp->c_r_q8;
+        *cx_out = damp->c_x_q15;
+        *cy_out = damp->c_y_q15;
+        *step_out = base_step;
+    }
+}
+
+static inline void fuxi_damp_mode9_eval_coeffs(const FuxiHapticDamp *damp,
+    int32_t *cr_out, int32_t *cx_out, int32_t *cy_out, uint32_t *step_out, int32_t *lim_out,
+    int32_t *knee_out, int32_t *ceil_out)
+{
+    int32_t b_cr = 0, b_cx = 0, b_cy = 0, b_lim = FUXI_DAMP_PCM_LIMIT;
+    uint32_t b_step = 65536u;
+    int32_t b_knee = FUXI_DAMP_M9_ENV_KNEE_NORM_S, b_ceil = FUXI_DAMP_M9_ENV_CEIL_NORM_S;
+    fuxi_damp_mode9_base_coeffs(damp, &b_cr, &b_cx, &b_cy, &b_step);
+    if (damp->m9_prof == FUXI_DAMP_M9_PROF_LP && damp->m9_repeat_level >= 2u) {
+        const int64_t rep_g = (damp->m9_repeat_level >= 3u) ?
+            FUXI_DAMP_M9_LP_REP3_GAIN_Q8 : FUXI_DAMP_M9_LP_REP2_GAIN_Q8;
+        b_cr = (int32_t)(((int64_t)damp->m9_lp_cr_q8 * rep_g + FUXI_DAMP_M9_LP_GAIN_Q8 / 2) /
+            FUXI_DAMP_M9_LP_GAIN_Q8);
+        b_lim = (damp->m9_repeat_level >= 3u) ? FUXI_DAMP_M9_LP_REP3_LIMIT : FUXI_DAMP_M9_LP_REP2_LIMIT;
+        b_step = 65536u;
+        b_cx = 0;
+        b_knee = FUXI_DAMP_M9_ENV_KNEE_SUS_S;
+        b_ceil = FUXI_DAMP_M9_ENV_CEIL_SUS_S;
+    }
+    if (damp->m9_sus_prog > 0u) {
+        int64_t p = (int64_t)damp->m9_sus_prog;
+        const int64_t r = (int64_t)FUXI_DAMP_M9_SUS_RAMP;
+        if (p > r) p = r;
+        *cr_out = b_cr + (int32_t)(((int64_t)(damp->m9_sus_cr_q8 - b_cr) * p) / r);
+        *cx_out = b_cx + (int32_t)(((int64_t)(0 - b_cx) * p) / r);
+        *cy_out = b_cy + (int32_t)(((int64_t)(damp->m9_sus_cy_q15 - b_cy) * p) / r);
+        *step_out = (uint32_t)((int64_t)b_step + (((int64_t)65536 - (int64_t)b_step) * p) / r);
+        *lim_out = b_lim + (int32_t)(((int64_t)(FUXI_DAMP_M9_SUS_LIMIT - b_lim) * p) / r);
+        *knee_out = b_knee + (int32_t)(((int64_t)(FUXI_DAMP_M9_ENV_KNEE_SUS_S - b_knee) * p) / r);
+        *ceil_out = b_ceil + (int32_t)(((int64_t)(FUXI_DAMP_M9_ENV_CEIL_SUS_S - b_ceil) * p) / r);
+    } else {
+        *cr_out = b_cr;
+        *cx_out = b_cx;
+        *cy_out = b_cy;
+        *step_out = b_step;
+        *lim_out = b_lim;
+        *knee_out = b_knee;
+        *ceil_out = b_ceil;
+    }
+}
+
+static inline void fuxi_damp_mode9_classify_chunk(FuxiHapticDamp *damp, const uint8_t *in, unsigned eff_len)
+{
+    unsigned pos_pk = 0, neg_pk = 0, chunk_zc = 0;
+    int8_t sg = damp->m9_in_sign;
+    for (unsigned i = 0; i < eff_len; i++) {
+        int v = (int)(int8_t)in[i];
+        if (v > 0 && (unsigned)v > pos_pk) pos_pk = (unsigned)v;
+        else if (v < 0 && (unsigned)(-v) > neg_pk) neg_pk = (unsigned)(-v);
+        if (v >= 6) {
+            if (sg < 0) chunk_zc++;
+            sg = 1;
+        } else if (v <= -6) {
+            if (sg > 0) chunk_zc++;
+            sg = -1;
+        }
+    }
+    damp->m9_in_sign = sg;
+    if (damp->m9_in_zc < 60000u) damp->m9_in_zc = (uint16_t)(damp->m9_in_zc + chunk_zc);
+
+    unsigned raw_pk = pos_pk > neg_pk ? pos_pk : neg_pk;
+    unsigned minor_pk = pos_pk < neg_pk ? pos_pk : neg_pk;
+    unsigned tail_start = eff_len > 12u ? (eff_len - 12u) : 0u;
+    int ends_quiet = 1;
+    for (unsigned i = tail_start; i < eff_len; i++) {
+        int v = (int)(int8_t)in[i];
+        unsigned mag = (unsigned)(v < 0 ? -v : v);
+        if (mag > 6u) {
+            ends_quiet = 0;
+            break;
+        }
+    }
+    if (damp->m9_burst_in == 0u) {
+        if (!ends_quiet && (raw_pk >= 112u || (raw_pk >= 84u && chunk_zc >= 3u) ||
+            (damp->m9_prev_was_sus && damp->m9_repeat_level >= 3u && raw_pk >= 48u))) {
+            damp->m9_prof = FUXI_DAMP_M9_PROF_SUS;
+            damp->m9_sus_active = 1;
+            damp->m9_sus_prog = (uint16_t)FUXI_DAMP_M9_SUS_RAMP;
+        } else if (raw_pk >= 60u && minor_pk <= raw_pk / 8u) {
+            damp->m9_prof = FUXI_DAMP_M9_PROF_UNI;
+        } else if (raw_pk >= 100u && ends_quiet) {
+            damp->m9_prof = FUXI_DAMP_M9_PROF_LP;
+        } else {
+            damp->m9_prof = FUXI_DAMP_M9_PROF_STD;
+        }
+    } else if (!damp->m9_sus_active && !ends_quiet &&
+               (raw_pk >= 112u || (raw_pk >= 76u && damp->m9_in_zc >= 4u))) {
+        damp->m9_sus_active = 1;
+        damp->m9_prof = FUXI_DAMP_M9_PROF_SUS;
+    }
+}
+
+static inline int8_t fuxi_damp_mode9_step_ex(FuxiHapticDamp *damp, int8_t raw,
+    int32_t cr, int32_t cx, int32_t cy, int32_t lim, int32_t env_knee, int32_t env_ceil, unsigned *zc_out)
+{
+    if (lim > FUXI_DAMP_PCM_LIMIT) lim = FUXI_DAMP_PCM_LIMIT;
+    int64_t fb = ((int64_t)cx * (int64_t)damp->x + (int64_t)cy * (int64_t)damp->y) / 32768;
+    int64_t cmd_s = (int64_t)raw * (int64_t)cr * 2 + fb;
+    int32_t ax = damp->x < 0 ? -damp->x : damp->x;
+    int32_t ay = damp->y < 0 ? -damp->y : damp->y;
+    int32_t hi = ax > ay ? ax : ay;
+    int32_t lo = ax > ay ? ay : ax;
+    int32_t env_s = (int32_t)(((int64_t)hi * 31 + (int64_t)lo * 13) >> 5);
+    if (env_s > env_knee && env_ceil > env_knee &&
+        ((cmd_s > 0 && damp->y > 0) || (cmd_s < 0 && damp->y < 0))) {
+        if (env_s >= env_ceil) {
+            cmd_s = 0;
+        } else {
+            cmd_s = (cmd_s * (int64_t)(env_ceil - env_s)) / (int64_t)(env_ceil - env_knee);
+        }
+    }
+    int64_t rounded = cmd_s >= 0 ? (cmd_s + FUXI_DAMP_SCALE / 2) / FUXI_DAMP_SCALE
+        : -((-cmd_s + FUXI_DAMP_SCALE / 2) / FUXI_DAMP_SCALE);
+    int8_t out = (int8_t)(damp->soft_knee ? fuxi_damp_soft_clamp(rounded, lim) : fuxi_damp_clamp(rounded, -lim, lim));
+    fuxi_damp_observe(damp, out, zc_out);
+    return out;
+}
+
+static inline int8_t fuxi_damp_mode9_tail_step(FuxiHapticDamp *damp, unsigned step_idx,
+    unsigned limit, unsigned *zc_out)
+{
+    int32_t cr0 = 0, cx0 = 0, cy0 = 0, tlim = FUXI_DAMP_PCM_LIMIT;
+    int32_t unused_knee = 0, unused_ceil = 0;
+    uint32_t unused_step = 0;
+    fuxi_damp_mode9_eval_coeffs(damp, &cr0, &cx0, &cy0, &unused_step, &tlim, &unused_knee, &unused_ceil);
+    if ((int32_t)limit < tlim) tlim = (int32_t)limit;
+    if (tlim > FUXI_DAMP_PCM_LIMIT) tlim = FUXI_DAMP_PCM_LIMIT;
+
+    const int is_lp = (damp->m9_prof == FUXI_DAMP_M9_PROF_LP && damp->m9_sus_prog == 0u);
+    const int32_t cxt = is_lp ? (damp->m9_repeat_level >= 2u ? 0 : damp->m9_lp_cxt_q15) : damp->c_x_tl_q15;
+    const int32_t cyt = is_lp ? damp->m9_lp_cyt_q15 : damp->c_y_tl_q15;
+    const unsigned tramp = is_lp ? FUXI_DAMP_M9_LP_TAIL_RAMP : FUXI_DAMP_TAIL_RAMP;
+
+    int32_t cx = cxt;
+    int32_t cy = cyt;
+    if (step_idx < tramp) {
+        int64_t k = (int64_t)(step_idx + 1u);
+        cx = cx0 + (int32_t)(((int64_t)(cxt - cx0) * k) / (int64_t)tramp);
+        cy = cy0 + (int32_t)(((int64_t)(cyt - cy0) * k) / (int64_t)tramp);
+    }
+    int64_t r_term = 0;
+    int32_t lr = (int32_t)damp->m9_last_r;
+    if ((lr > 12 || lr < -12) && step_idx < FUXI_DAMP_M9_TAIL_REL_RAMP) {
+        int64_t r_fade = ((int64_t)lr * (int64_t)(FUXI_DAMP_M9_TAIL_REL_RAMP - 1u - step_idx)) /
+            (int64_t)FUXI_DAMP_M9_TAIL_REL_RAMP;
+        r_term = r_fade * (int64_t)cr0 * 2;
+    }
+    int64_t fb = r_term + ((int64_t)cx * (int64_t)damp->x + (int64_t)cy * (int64_t)damp->y) / 32768;
+    int64_t rounded = fb >= 0 ? (fb + FUXI_DAMP_SCALE / 2) / FUXI_DAMP_SCALE
+        : -((-fb + FUXI_DAMP_SCALE / 2) / FUXI_DAMP_SCALE);
+    int8_t out = (int8_t)(damp->soft_knee ? fuxi_damp_soft_clamp(rounded, tlim) : fuxi_damp_clamp(rounded, -tlim, tlim));
+    fuxi_damp_observe(damp, out, zc_out);
+    return out;
+}
+
+static inline int8_t fuxi_damp_seam_sample(const uint8_t *in, unsigned idx, int32_t seam_jump)
+{
+    int32_t v = (int32_t)(int8_t)in[idx];
+    if (seam_jump != 0 && idx < FUXI_DAMP_SEAM_RAMP) {
+        int32_t bias = (seam_jump * (int32_t)(FUXI_DAMP_SEAM_RAMP - idx)) / (int32_t)FUXI_DAMP_SEAM_RAMP;
+        v = fuxi_damp_clamp((int64_t)v + (int64_t)bias, -FUXI_DAMP_PCM_LIMIT, FUXI_DAMP_PCM_LIMIT);
+    }
+    return (int8_t)v;
+}
+
+/* mode 9 四檔自適應無接縫處理：自動分類 STD(後台/鍵盤原味)/UNI(開關柔化)/LP(長按臨界死拍)/SUS(來電 1:1 零斷流安全連續)，
+ * 剔除中段補零、以 0.67 ms 一階預測消除跨段動態增益階躍、接續前段 1..3B 餘量並以 4B 對齊輸出。 */
+static inline unsigned fuxi_damp_process_mode9(FuxiHapticDamp *damp, const uint8_t *in, unsigned in_len,
+    uint8_t *out, unsigned max_len, int flush_short, unsigned *out_peak, unsigned *zc_out)
+{
+    if (!damp || !in || !in_len || !out || max_len < 4u) return 0;
+    const unsigned eff_len = fuxi_damp_trim_chunk_pad(in, in_len);
+    fuxi_damp_mode9_classify_chunk(damp, in, eff_len);
+    int32_t seam_jump = 0;
+    if (damp->has_prev_in && eff_len > 0u) {
+        int32_t pred = (int32_t)damp->prev_in + ((int32_t)damp->prev_in - (int32_t)damp->prev_in2);
+        int32_t diff = pred - (int32_t)(int8_t)in[0];
+        if (diff >= FUXI_DAMP_SEAM_MIN_JUMP || diff <= -FUXI_DAMP_SEAM_MIN_JUMP) {
+            seam_jump = fuxi_damp_clamp(diff, -FUXI_DAMP_SEAM_MAX_JUMP, FUXI_DAMP_SEAM_MAX_JUMP);
+        }
+    }
+    unsigned out_n = 0, peak = 0;
+    if (damp->out_rem_len > 0u) {
+        unsigned rem_in = damp->out_rem_len > 3u ? 3u : (unsigned)damp->out_rem_len;
+        for (unsigned i = 0; i < rem_in && out_n < max_len; i++) {
+            out[out_n++] = damp->out_rem[i];
+        }
+        damp->out_rem_len = 0;
+    }
+    uint32_t phase = damp->pitch_phase_q16;
+    while ((phase >> 16) < eff_len && out_n < max_len) {
+        unsigned idx = phase >> 16;
+        uint32_t frac = phase & 0xffffu;
+        int32_t s0 = fuxi_damp_seam_sample(in, idx, seam_jump);
+        int32_t s1 = (idx + 1u < eff_len) ? (int32_t)fuxi_damp_seam_sample(in, idx + 1u, seam_jump) : s0;
+        int32_t interp = s0 + (((s1 - s0) * (int32_t)frac) >> 16);
+        damp->m9_last_r = (int8_t)interp;
+        if (!damp->m9_sus_active && (damp->m9_burst_in + idx) >= FUXI_DAMP_M9_SUS_FALLBACK_IN) {
+            damp->m9_sus_active = 1;
+            damp->m9_prof = FUXI_DAMP_M9_PROF_SUS;
+        }
+        if (damp->m9_sus_active && damp->m9_sus_prog < FUXI_DAMP_M9_SUS_RAMP) {
+            damp->m9_sus_prog++;
+        }
+        int32_t cr = 0, cx = 0, cy = 0, lim = FUXI_DAMP_PCM_LIMIT;
+        int32_t env_knee = 0, env_ceil = 0;
+        uint32_t cur_step = 65536u;
+        fuxi_damp_mode9_eval_coeffs(damp, &cr, &cx, &cy, &cur_step, &lim, &env_knee, &env_ceil);
+        int8_t sample = fuxi_damp_mode9_step_ex(damp, (int8_t)interp, cr, cx, cy, lim, env_knee, env_ceil, zc_out);
+        out[out_n++] = (uint8_t)sample;
+        phase += cur_step;
+    }
+    if ((phase >> 16) >= eff_len) {
+        damp->pitch_phase_q16 = phase - (eff_len << 16);
+    } else {
+        damp->pitch_phase_q16 = 0;
+    }
+    damp->m9_burst_in += eff_len;
+    if (eff_len >= 2u) {
+        damp->prev_in2 = fuxi_damp_seam_sample(in, eff_len - 2u, seam_jump);
+        damp->prev_in = fuxi_damp_seam_sample(in, eff_len - 1u, seam_jump);
+        damp->has_prev_in = 1;
+    } else if (eff_len == 1u) {
+        damp->prev_in2 = damp->has_prev_in ? damp->prev_in : 0;
+        damp->prev_in = fuxi_damp_seam_sample(in, 0u, seam_jump);
+        damp->has_prev_in = 1;
+    }
+    if (!out_n) return 0;
+    if (flush_short && out_n < 4u) {
+        int32_t cr = 0, cx = 0, cy = 0, lim = FUXI_DAMP_PCM_LIMIT;
+        int32_t env_knee = 0, env_ceil = 0;
+        uint32_t unused_step = 65536u;
+        fuxi_damp_mode9_eval_coeffs(damp, &cr, &cx, &cy, &unused_step, &lim, &env_knee, &env_ceil);
+        while (out_n < 4u && out_n < max_len) {
+            int8_t sample = fuxi_damp_mode9_step_ex(damp, 0, cr, cx, cy, lim, env_knee, env_ceil, zc_out);
+            out[out_n++] = (uint8_t)sample;
+        }
+    }
+    unsigned emit_n = out_n & ~3u;
+    unsigned rem_n = out_n - emit_n;
+    for (unsigned i = 0; i < rem_n && i < 3u; i++) {
+        damp->out_rem[i] = out[emit_n + i];
+    }
+    damp->out_rem_len = (uint8_t)(rem_n > 3u ? 3u : rem_n);
+    for (unsigned i = 0; i < emit_n; i++) {
+        int v = (int)(int8_t)out[i];
+        unsigned mag = (unsigned)(v < 0 ? -v : v);
+        if (mag > peak) peak = mag;
+    }
+    if (out_peak) *out_peak = peak;
+    return emit_n;
+}
+
+static inline void fuxi_damp_process(FuxiHapticDamp *damp, const uint8_t *in, uint8_t *out,
+    unsigned length, unsigned *out_peak, unsigned *zc_out)
+{
+    unsigned peak = 0;
+    for (unsigned i = 0; i < length; i++) {
+        int8_t sample = (int8_t)in[i];
+        int8_t shaped = damp && damp->mode ? fuxi_damp_step(damp, sample, zc_out) : sample;
+        if (!damp || !damp->mode) {
+            int32_t sign = shaped > 0 ? 1 : (shaped < 0 ? -1 : 0);
+            if (damp && sign) {
+                if (damp->last_sign && sign != damp->last_sign && zc_out) (*zc_out)++;
+                damp->last_sign = sign;
+            }
+        }
+        out[i] = (uint8_t)shaped;
+        unsigned mag = (unsigned)(shaped < 0 ? -(int)shaped : (int)shaped);
+        if (mag > peak) peak = mag;
+    }
+    if (out_peak) *out_peak = peak;
+}
+
+/* 以 raw=0 產生 4B 對齊之反向剎車尾段（可指定尾段最大振幅）；若觀測器能量已歸零則回傳 0。 */
+static inline unsigned fuxi_damp_tail_limited(FuxiHapticDamp *damp, uint8_t *out, unsigned max_len,
+    unsigned tail_limit, unsigned *out_peak, unsigned *zc_out)
+{
+    if (!damp || !damp->mode || damp->no_tail || !out || max_len < 4u) return 0;
+    unsigned limit = max_len > FUXI_DAMP_TAIL_MAX ? FUXI_DAMP_TAIL_MAX : (max_len & ~3u);
+    unsigned zeros = 0, last_nz = 0, produced = 0, peak = 0, rem_n = 0;
+    if (damp->mode == 9u && damp->out_rem_len > 0u) {
+        rem_n = damp->out_rem_len > 3u ? 3u : (unsigned)damp->out_rem_len;
+        if (rem_n > limit) rem_n = limit;
+        for (unsigned r = 0; r < rem_n; r++) {
+            int8_t sample = (int8_t)damp->out_rem[r];
+            out[r] = (uint8_t)sample;
+            produced = r + 1u;
+            if (sample) {
+                unsigned mag = (unsigned)(sample < 0 ? -(int)sample : (int)sample);
+                if (mag > peak) peak = mag;
+                last_nz = produced;
+                zeros = 0;
+            } else {
+                zeros++;
+            }
+        }
+        damp->out_rem_len = 0;
+    }
+    const int32_t stop_state = (damp->mode == 9u) ? FUXI_DAMP_TAIL_STOP_TIGHT : FUXI_DAMP_TAIL_STOP_STATE;
+    for (unsigned i = 0; rem_n + i < limit; i++) {
+        int8_t sample = damp->mode == 9u ?
+            fuxi_damp_mode9_tail_step(damp, i, tail_limit, zc_out) :
+            damp->mode == 8u ?
+            fuxi_damp_mode8_tail_step(damp, i, tail_limit, zc_out) :
+            damp->mode == 7u ?
+            fuxi_damp_mode7_step(damp, 0, tail_limit, zc_out) :
+            damp->mode >= 5u ?
+            fuxi_damp_deadbeat_step(damp, tail_limit, zc_out) :
+            fuxi_damp_step(damp, 0, zc_out);
+        out[rem_n + i] = (uint8_t)sample;
+        produced = rem_n + i + 1u;
+        if (sample) {
+            unsigned mag = (unsigned)(sample < 0 ? -(int)sample : (int)sample);
+            if (mag > peak) peak = mag;
+            last_nz = produced;
+            zeros = 0;
+        } else {
+            zeros++;
+            if (zeros >= FUXI_DAMP_TAIL_ZERO_STOP) {
+                int32_t ax = damp->x < 0 ? -damp->x : damp->x;
+                int32_t ay = damp->y < 0 ? -damp->y : damp->y;
+                if (ax < stop_state && ay < stop_state) break;
+            }
+        }
+    }
+    if (!last_nz) return 0;
+    unsigned len = (last_nz + 4u + 3u) & ~3u; /* 保留至少 4B 結尾零點 */
+    if (len > limit) len = limit;
+    for (unsigned i = produced; i < len; i++) out[i] = 0;
+    if (out_peak) *out_peak = peak;
+    return len;
+}
+
+static inline unsigned fuxi_damp_tail(FuxiHapticDamp *damp, uint8_t *out, unsigned max_len,
+    unsigned *out_peak, unsigned *zc_out)
+{
+    return fuxi_damp_tail_limited(damp, out, max_len, FUXI_DAMP_PCM_LIMIT, out_peak, zc_out);
+}
+
+#endif /* FUXI_HAPTIC_DAMP_H */
