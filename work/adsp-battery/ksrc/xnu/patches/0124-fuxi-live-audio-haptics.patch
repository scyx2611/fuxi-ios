index 0000000..48a1e40
--- /dev/null
+++ b/bsd/dev/fuxi_haptic_stream.h
@@ -0,0 +1,617 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* HAP525_HV 連續低延遲 24 kHz 有號 PCM FIFO 串流引擎（ADT /chosen fuxi,haptic=9；預設關）。
+ *
+ * 參考上游 Linux qcom-hv-haptics（ref-linux/qcom-hv-haptics-9671bc.c）與同機小米 13 Android
+ * SPMI 實測紀錄（android-haptic-spmi-1118-2353/{click,tick,switch-on,long-press}.trace）：
+ * - 同機 Android 所有 UI 觸感皆以 24 kHz（0xf124=0x0a）、VMAX=0xa3（8150 mV）、有號峰值 ±126
+ *   直接寫入 2048B 硬體 FIFO（0xf120）。
+ * - 舊版 fuxi_rtp_click 每段 5.33 ms PCM 皆重做開關／停等／還原 8 組暫存器，造成單段 12 ms 斷裂。
+ * - 本引擎於單次突發內持續把新到達的 4B 對齊 PCM 直接補寫進 FIFO（零中斷 gap），
+ *   播完後保留設定 warm 2000 ms 以壓低連續打字／滾輪起振延遲，逾時或切換 DIRECT_PLAY／錯誤時
+ *   完整還原全部暫存器、VMAX 與 0xf04c=FUXI_VIBRATE_IDLE。 */
+#ifndef FUXI_HAPTIC_STREAM_H
+#define FUXI_HAPTIC_STREAM_H
+
+#include <stdint.h>
+#include "fuxi_haptic_rtp.h"
+#include "fuxi_haptic_damp.h"
+
+enum {
+    FUXI_STREAM_PCM_LIMIT = 126,
+    FUXI_STREAM_MAX_CHUNK = FUXI_RTP_BYTES,
+    FUXI_STREAM_FIFO_CAP = 2048,
+    FUXI_STREAM_FIFO_WATERMARK = 1536,
+    FUXI_STREAM_STOP_POLLS = 80,
+    FUXI_STREAM_STOP_STEP_US = 500,
+    FUXI_STREAM_MAX_DRAIN_POLLS = 400,
+    FUXI_STREAM_TAIL_THRESHOLD = 14,
+    FUXI_STREAM_TAIL_THRESHOLD_PITCH = 48,
+    FUXI_STREAM_FAST_POLL_WATERMARK = 96,
+    FUXI_STREAM_TAIL_QUIET_NS = 6000000ull,     /* 最後一段輸入後至少靜默 6 ms 才補剎車尾段，杜絕突發中段誤補 */
+    FUXI_STREAM_TAIL_MARGIN_NS = 500000ull,
+    FUXI_STREAM_IDLE_WAIT_POLLS = 20,
+    FUXI_STREAM_IDLE_WAIT_STEP_US = 500,
+    FUXI_STREAM_QUIET_END_SAMPLES = 12,
+    FUXI_STREAM_QUIET_END_MAX_AMP = 6,
+    FUXI_STREAM_TAIL_LIMIT_MIN = 32,
+    FUXI_STREAM_SYNTH_GAP_NS = 8000000ull,      /* 超過前段輸入尾端 +8 ms 視為全新點擊，不吸收 */
+    FUXI_STREAM_SYNTH_MAX_IN = 864u,            /* 單次點擊吸收上限 36 ms（864 samples，完整涵蓋 5–6 段離散觸感）；超過即接手連續模式 */
+};
+#define FUXI_STREAM_IDLE_CLOSE_NS 4000000000ull
+
+typedef struct {
+    uint8_t saved[9];
+    uint8_t saved_vmax;
+    uint8_t active_vmax;
+    uint8_t hw_brake;
+    FuxiHapticDamp damp;
+    unsigned prepared;
+    unsigned drain_polls;
+    int configured;
+    int playing;
+    int owns_fifo;
+    int changed_vmax;
+    int attempted_play;
+    int play_armed;
+    int warm_burst;
+    int tail_emitted;
+    int last_input_quiet;
+    int synth_active;
+    int synth_continuous;
+    unsigned synth_input_samples;
+    uint64_t synth_input_end_ns;
+    uint64_t last_push_ns;
+    unsigned last_push_fill;
+    uint64_t idle_since_ns;
+    uint64_t last_burst_end_ns;
+    uint64_t burst_start_ns;
+    uint64_t burst_open_us;
+    uint64_t burst_queue_us;
+    unsigned burst_chunks;
+    unsigned burst_bytes;
+    unsigned burst_peak;
+    unsigned burst_raw_peak;
+    unsigned burst_drive_peak;
+    unsigned burst_out_peak;
+    unsigned burst_zc;
+    unsigned burst_tail_bytes;
+    unsigned burst_tails;
+    unsigned burst_refills;
+    unsigned burst_underruns;
+    unsigned burst_profile;
+    unsigned burst_repeat_level;
+    unsigned burst_gap_ms;
+    unsigned burst_absorbed;
+    unsigned burst_clips;
+    unsigned burst_max_step;
+    int8_t burst_prev_sample;
+    uint8_t burst_has_prev;
+    uint8_t last_vmax_pre;
+    uint8_t last_hbst_pre;
+} FuxiHapticStream;
+
+/* 跨段與驅動->尾段接縫追蹤實際寫入 FIFO 的硬削波筆數（|v|>=126）與最大相鄰樣本跳變。 */
+static inline void fuxi_stream_record_samples(FuxiHapticStream *st, const uint8_t *buf, unsigned len)
+{
+    if (!st || !buf) return;
+    for (unsigned i = 0; i < len; i++) {
+        int v = (int)(int8_t)buf[i];
+        if (v >= FUXI_STREAM_PCM_LIMIT || v <= -FUXI_STREAM_PCM_LIMIT) st->burst_clips++;
+        if (st->burst_has_prev) {
+            int d = v - (int)st->burst_prev_sample;
+            unsigned ad = (unsigned)(d < 0 ? -d : d);
+            if (ad > st->burst_max_step) st->burst_max_step = ad;
+        }
+        st->burst_prev_sample = (int8_t)v;
+        st->burst_has_prev = 1;
+    }
+}
+
+static inline int fuxi_stream_validate_pcm(const uint8_t *samples, unsigned length, unsigned *peak_out)
+{
+    if (!samples || length < 4 || length > FUXI_STREAM_MAX_CHUNK || (length & 3u)) return -1;
+    unsigned peak = 0;
+    for (unsigned i = 0; i < length; i++) {
+        int sample = (int8_t)samples[i];
+        if (sample < -FUXI_STREAM_PCM_LIMIT || sample > FUXI_STREAM_PCM_LIMIT) return -1;
+        unsigned mag = (unsigned)(sample < 0 ? -sample : sample);
+        if (mag > peak) peak = mag;
+    }
+    if (peak_out) *peak_out = peak;
+    return 0;
+}
+
+/* 先立即讀一次 HPWR_INTF（FIFO 播完時通常已回到 DISABLED），仍忙時才以 500 us 步進等待。 */
+static inline int fuxi_stream_wait_disabled(const FuxiHapticIo *io)
+{
+    uint8_t hpwr = 0;
+    if (!io->read(io->context, 0xf00b, &hpwr) && !(hpwr & 3u)) return FUXI_HAPTIC_OK;
+    for (unsigned poll = 0; poll < FUXI_STREAM_STOP_POLLS; poll++) {
+        io->wait_us(io->context, FUXI_STREAM_STOP_STEP_US);
+        if (!io->read(io->context, 0xf00b, &hpwr) && !(hpwr & 3u)) return FUXI_HAPTIC_OK;
+    }
+    return FUXI_HAPTIC_TIMEOUT;
+}
+
+/* 短時間連按時 hBoost / HPWR 狀態可能尚有數毫秒收斂期，遇到暫時 BUSY 時等待最多 10 ms，不直接毒化 fp_rtp_ready。 */
+static inline int fuxi_stream_wait_idle(const FuxiHapticIo *io)
+{
+    for (unsigned poll = 0; poll <= FUXI_STREAM_IDLE_WAIT_POLLS; poll++) {
+        int rc = fuxi_haptic_idle(io);
+        if (rc != FUXI_HAPTIC_BUSY) return rc;
+        if (poll < FUXI_STREAM_IDLE_WAIT_POLLS) io->wait_us(io->context, FUXI_STREAM_IDLE_WAIT_STEP_US);
+    }
+    return FUXI_HAPTIC_BUSY;
+}
+
+static inline int fuxi_stream_input_ended_quiet(const uint8_t *samples, unsigned length)
+{
+    if (!samples || !length) return 1;
+    unsigned start = length > FUXI_STREAM_QUIET_END_SAMPLES ?
+        (length - FUXI_STREAM_QUIET_END_SAMPLES) : 0u;
+    for (unsigned i = start; i < length; i++) {
+        int v = (int8_t)samples[i];
+        unsigned mag = (unsigned)(v < 0 ? -v : v);
+        if (mag > FUXI_STREAM_QUIET_END_MAX_AMP) return 0;
+    }
+    return 1;
+}
+
+static const struct { unsigned addr; uint8_t mask, value; } fuxi_stream_config[9] = {
+    {0xf063, 0x80, 0},
+    {0xf071, 0xff, 0x80}, {0xf070, 0xff, 5}, {0xf124, 15, 10},
+    {0xf05e, 0xff, 2}, {0xf05f, 0xff, 0x44}, {0xf072, 0x0c, 8},
+    {0xf12a, 15, 0}, {0xf04a, 4, 0}
+};
+
+static inline int fuxi_stream_stop_play(const FuxiHapticIo *io, FuxiRtpWrite write, FuxiHapticStream *st)
+{
+    int restore_error = 0;
+    if (st->playing && st->damp.mode == 9u) {
+        fuxi_damp_mode9_on_burst_end(&st->damp, st->burst_raw_peak, st->burst_bytes);
+    }
+    if (st->playing) {
+        if (fuxi_rtp_register(write, io, 0xf04c, st->hw_brake)) restore_error = 1;
+        if (fuxi_stream_wait_disabled(io)) restore_error = 1;
+        if (st->hw_brake && fuxi_rtp_register(write, io, 0xf04c, 0)) restore_error = 1;
+        st->playing = 0;
+    }
+    if (st->owns_fifo) {
+        uint8_t flush = 1;
+        if (write(0xf12d, &flush, 1) || fuxi_rtp_register(write, io, 0xf12d, 0)) restore_error = 1;
+        st->owns_fifo = 0;
+    }
+    /* 對照原機 Android click.trace:144-145 與 qcom-hv-haptics.c:2641-2658：
+     * 每段 FIFO 停止後皆還原 0xf124（T_LRA）與 0xf072（AUTO RC_CAL），消除 warm=1 狀態漂移。 */
+    if (st->configured && st->play_armed && st->prepared >= 7u) {
+        if (((st->saved[3] ^ fuxi_stream_config[3].value) & fuxi_stream_config[3].mask) &&
+            fuxi_rtp_register(write, io, fuxi_stream_config[3].addr, st->saved[3])) restore_error = 1;
+        if (((st->saved[6] ^ fuxi_stream_config[6].value) & fuxi_stream_config[6].mask) &&
+            fuxi_rtp_register(write, io, fuxi_stream_config[6].addr, st->saved[6])) restore_error = 1;
+        st->play_armed = 0;
+    }
+    st->drain_polls = 0;
+    st->tail_emitted = 0;
+    st->last_push_fill = 0;
+    st->last_input_quiet = 0;
+    st->burst_has_prev = 0;
+    st->burst_prev_sample = 0;
+    fuxi_damp_reset(&st->damp);
+    return restore_error ? -2 : 0;
+}
+
+static inline int fuxi_stream_will_absorb(const FuxiHapticStream *st, unsigned length, uint64_t now_ns)
+{
+    if (!st || st->damp.mode != 5u || !st->synth_active) return 0;
+    if (now_ns > st->synth_input_end_ns + FUXI_STREAM_SYNTH_GAP_NS) return 0;
+    return (st->synth_input_samples + length) <= FUXI_STREAM_SYNTH_MAX_IN;
+}
+
+static inline int fuxi_stream_close(const FuxiHapticIo *io, FuxiRtpWrite write, FuxiHapticStream *st)
+{
+    int was_playing = st->playing;
+    int restore_error = fuxi_stream_stop_play(io, write, st) ? 1 : 0;
+    if (was_playing && st->last_push_ns > st->last_burst_end_ns) {
+        st->last_burst_end_ns = st->last_push_ns;
+    }
+    while (st->prepared) {
+        unsigned i = --st->prepared;
+        if (fuxi_stream_config[i].addr == 0xf05f && i > 0) {
+            st->prepared--;
+            if ((((st->saved[i - 1] ^ fuxi_stream_config[i - 1].value) & fuxi_stream_config[i - 1].mask) ||
+                 ((st->saved[i] ^ fuxi_stream_config[i].value) & fuxi_stream_config[i].mask)) &&
+                fuxi_rtp_write_rc_cal(write, io, st->saved[i - 1], st->saved[i])) restore_error = 1;
+            continue;
+        }
+        if (((st->saved[i] ^ fuxi_stream_config[i].value) & fuxi_stream_config[i].mask) &&
+            fuxi_rtp_register(write, io, fuxi_stream_config[i].addr, st->saved[i])) restore_error = 1;
+    }
+    if (st->changed_vmax) {
+        if (fuxi_rtp_register(write, io, 0xf048, st->saved_vmax) || fuxi_rtp_wait_hpwr(io)) restore_error = 1;
+        st->changed_vmax = 0;
+        st->active_vmax = 0;
+    }
+    if (st->attempted_play || st->configured) {
+        if (fuxi_rtp_register(write, io, 0xf04c, FUXI_VIBRATE_IDLE)) restore_error = 1;
+    }
+    st->configured = 0;
+    st->attempted_play = 0;
+    st->play_armed = 0;
+    st->idle_since_ns = 0;
+    st->synth_active = 0;
+    st->synth_continuous = 0;
+    st->synth_input_samples = 0;
+    st->synth_input_end_ns = 0;
+    st->last_push_ns = 0;
+    st->last_push_fill = 0;
+    st->last_input_quiet = 0;
+    return restore_error ? -2 : 0;
+}
+
+static inline int fuxi_stream_configure(const FuxiHapticIo *io, FuxiRtpWrite write,
+    FuxiRtpReadStatus read_status, FuxiHapticStream *st, unsigned vmax, unsigned *autores_cleared)
+{
+    uint8_t fault = 0, size_code = 0, memop = 0;
+    unsigned fill = 0;
+    if (vmax > FUXI_RTP_TEST_VMAX_LIMIT) return -1;
+    if (io->read(io->context, 0xf00c, &fault) ||
+        fuxi_vibrate_clear_autores(io, &fault, autores_cleared) ||
+        fuxi_stream_wait_idle(io) ||
+        fuxi_haptic_read_stable(io, 0xf1a0, &size_code) || (size_code & 15) != 15 ||
+        fuxi_haptic_read_stable(io, 0xf12d, &memop) || memop) return -1;
+    st->prepared = 0;
+    st->changed_vmax = 0;
+    st->owns_fifo = 0;
+    st->attempted_play = 0;
+    st->play_armed = 0;
+    for (unsigned i = 0; i < 9; i++) {
+        if (fuxi_stream_config[i].addr == 0xf05e) {
+            if (fuxi_haptic_read_stable(io, fuxi_stream_config[i].addr, &st->saved[i]) ||
+                fuxi_haptic_read_stable(io, fuxi_stream_config[i + 1].addr, &st->saved[i + 1])) goto fail;
+            uint8_t msb = (st->saved[i] & ~fuxi_stream_config[i].mask) | fuxi_stream_config[i].value;
+            uint8_t lsb = (st->saved[i + 1] & ~fuxi_stream_config[i + 1].mask) | fuxi_stream_config[i + 1].value;
+            st->prepared += 2;
+            if (fuxi_rtp_write_rc_cal(write, io, msb, lsb)) goto fail;
+            i++;
+            continue;
+        }
+        if (fuxi_haptic_read_stable(io, fuxi_stream_config[i].addr, &st->saved[i])) goto fail;
+        uint8_t value = (st->saved[i] & ~fuxi_stream_config[i].mask) | fuxi_stream_config[i].value;
+        st->prepared++;
+        if (value != st->saved[i] && fuxi_rtp_register(write, io, fuxi_stream_config[i].addr, value)) goto fail;
+    }
+    if (fuxi_rtp_fill(write, read_status, &fill) || fill) goto fail;
+    if (vmax) {
+        if (fuxi_haptic_read_stable(io, 0xf048, &st->saved_vmax) ||
+            !st->saved_vmax || st->saved_vmax > FUXI_VIBRATE_VMAX_LIMIT) goto fail;
+        st->changed_vmax = 1;
+        st->active_vmax = (uint8_t)vmax;
+        st->last_vmax_pre = st->saved_vmax;
+        (void)io->read(io->context, 0xf20b, &st->last_hbst_pre);
+        if (fuxi_rtp_register(write, io, 0xf048, (uint8_t)vmax) || fuxi_rtp_wait_hpwr(io) || fuxi_stream_wait_idle(io))
+            goto fail;
+    }
+    st->configured = 1;
+    st->play_armed = 1;
+    return 0;
+fail:
+    return fuxi_stream_close(io, write, st) ? -2 : -1;
+}
+
+/* 對照原機 Android click.trace:13-16：warm=1 每次起播前皆重寫 0xf048/0xf124/0xf05e-5f/0xf072，
+ * 同時讀回 pre-rearm 的 0xf048/0xf20b 供診斷驗證，確保連按第二次與首次硬體條件完全一致。 */
+static inline int fuxi_stream_rearm(const FuxiHapticIo *io, FuxiRtpWrite write, FuxiHapticStream *st)
+{
+    if (fuxi_stream_wait_idle(io)) return -1;
+    if (io->read(io->context, 0xf048, &st->last_vmax_pre) ||
+        io->read(io->context, 0xf20b, &st->last_hbst_pre)) return -1;
+    if (st->changed_vmax && st->active_vmax) {
+        if (fuxi_rtp_register(write, io, 0xf048, st->active_vmax) || fuxi_rtp_wait_hpwr(io)) return -1;
+    }
+    uint8_t rate_val = (st->saved[3] & ~fuxi_stream_config[3].mask) | fuxi_stream_config[3].value;
+    if (rate_val != st->saved[3] && fuxi_rtp_register(write, io, fuxi_stream_config[3].addr, rate_val)) return -1;
+    uint8_t msb = (st->saved[4] & ~fuxi_stream_config[4].mask) | fuxi_stream_config[4].value;
+    uint8_t lsb = (st->saved[5] & ~fuxi_stream_config[5].mask) | fuxi_stream_config[5].value;
+    if (fuxi_rtp_write_rc_cal(write, io, msb, lsb)) return -1;
+    uint8_t cal_val = (st->saved[6] & ~fuxi_stream_config[6].mask) | fuxi_stream_config[6].value;
+    if (cal_val != st->saved[6] && fuxi_rtp_register(write, io, fuxi_stream_config[6].addr, cal_val)) return -1;
+    if (fuxi_stream_wait_idle(io)) return -1;
+    st->play_armed = 1;
+    return 0;
+}
+
+static inline int fuxi_stream_push(const FuxiHapticIo *io, FuxiRtpWrite write,
+    FuxiRtpReadStatus read_status, FuxiHapticStream *st, const uint8_t *samples, unsigned length,
+    unsigned vmax, unsigned peak, uint64_t now_ns, unsigned *autores_cleared)
+{
+    uint8_t fault = 0;
+    uint8_t shaped[FUXI_DAMP_SYNTH_MAX];
+    unsigned out_peak = 0;
+    unsigned out_len = length;
+    unsigned fill = 0;
+    int mode5_fresh_synth = 0;
+    if (!samples || length < 4 || length > FUXI_STREAM_MAX_CHUNK || (length & 3u)) return -1;
+
+    int input_quiet = fuxi_stream_input_ended_quiet(samples, length);
+    uint64_t chunk_dur_ns = ((uint64_t)length * 1000000ull) / 24u;
+    if (st->damp.mode == 5u) {
+        if (st->synth_active) {
+            if (now_ns <= st->synth_input_end_ns + FUXI_STREAM_SYNTH_GAP_NS) {
+                if (st->synth_input_samples + length <= FUXI_STREAM_SYNTH_MAX_IN) {
+                    st->synth_input_samples += length;
+                    uint64_t base = now_ns > st->synth_input_end_ns ? now_ns : st->synth_input_end_ns;
+                    st->synth_input_end_ns = base + chunk_dur_ns;
+                    st->last_push_ns = now_ns;
+                    st->burst_absorbed++;
+                    if (peak > st->burst_raw_peak) st->burst_raw_peak = peak;
+                    return 1;
+                }
+                /* 連續超過 36 ms：接手為 pitch-matched 連續震動串流 */
+                st->synth_active = 0;
+                st->synth_continuous = 1;
+                st->damp.pitch_phase_q16 = 0;
+            } else {
+                st->synth_active = 0;
+                st->synth_continuous = 0;
+                mode5_fresh_synth = 1;
+            }
+        } else if (st->synth_continuous && st->playing &&
+            now_ns <= st->synth_input_end_ns + FUXI_STREAM_SYNTH_GAP_NS) {
+            /* 維持連續串流 */
+        } else {
+            st->synth_continuous = 0;
+            mode5_fresh_synth = 1;
+        }
+    }
+
+    if (st->playing) {
+        if (io->read(io->context, 0xf00c, &fault) || (fault & (uint8_t)~FUXI_VIBRATE_FAULT_AUTORES)) goto fail;
+        if (fuxi_rtp_fill(write, read_status, &fill)) goto fail;
+        if (fill > 0) {
+            if (mode5_fresh_synth) {
+                unsigned profile = 0;
+                fuxi_damp_reset(&st->damp);
+                out_len = fuxi_damp_synth_transient(&st->damp, samples, length, shaped, sizeof(shaped),
+                    &out_peak, &st->burst_zc, &profile);
+                if (!out_len) return 0;
+                st->synth_active = 1;
+                st->synth_input_samples = length;
+                st->synth_input_end_ns = now_ns + chunk_dur_ns;
+                st->burst_profile = profile;
+            } else if (st->damp.mode == 9u) {
+                if (st->tail_emitted) {
+                    fuxi_damp_mode9_on_burst_end(&st->damp, st->burst_raw_peak, st->burst_bytes);
+                    uint64_t b2b_gap = now_ns > st->synth_input_end_ns ? (now_ns - st->synth_input_end_ns) : 0ull;
+                    uint64_t b2b_ms = b2b_gap / 1000000ull;
+                    st->burst_gap_ms = (unsigned)(b2b_ms > 99999u ? 99999u : b2b_ms);
+                    fuxi_damp_mode9_on_burst_start(&st->damp, b2b_gap);
+                    st->burst_repeat_level = st->damp.m9_repeat_level;
+                }
+                out_len = fuxi_damp_process_mode9(&st->damp, samples, length, shaped, sizeof(shaped),
+                    0, &out_peak, &st->burst_zc);
+                st->burst_profile = st->damp.m9_prof;
+                if (!out_len) {
+                    if (st->damp.out_rem_len) {
+                        st->last_push_ns = now_ns;
+                        st->last_input_quiet = input_quiet;
+                        st->tail_emitted = 0;
+                        st->drain_polls = 0;
+                        uint64_t base = now_ns > st->synth_input_end_ns ? now_ns : st->synth_input_end_ns;
+                        st->synth_input_end_ns = base + chunk_dur_ns;
+                    }
+                    return 0;
+                }
+                uint64_t base = now_ns > st->synth_input_end_ns ? now_ns : st->synth_input_end_ns;
+                st->synth_input_end_ns = base + chunk_dur_ns;
+            } else if (st->damp.mode == 7u || st->damp.mode == 8u) {
+                out_len = fuxi_damp_process_mode7(&st->damp, samples, length, shaped, sizeof(shaped),
+                    &out_peak, &st->burst_zc);
+                if (!out_len) return 0;
+                uint64_t base = now_ns > st->synth_input_end_ns ? now_ns : st->synth_input_end_ns;
+                st->synth_input_end_ns = base + chunk_dur_ns;
+            } else if (st->damp.mode >= 5u) {
+                out_len = fuxi_damp_process_pitch(&st->damp, samples, length, shaped, sizeof(shaped),
+                    &out_peak, &st->burst_zc);
+                if (!out_len) return 0;
+                uint64_t base = now_ns > st->synth_input_end_ns ? now_ns : st->synth_input_end_ns;
+                st->synth_input_end_ns = base + chunk_dur_ns;
+            } else {
+                fuxi_damp_process(&st->damp, samples, shaped, length, &out_peak, &st->burst_zc);
+                out_len = length;
+            }
+            for (unsigned wait = 0; wait < 20 && fill + out_len > FUXI_STREAM_FIFO_WATERMARK; wait++) {
+                io->wait_us(io->context, 500);
+                if (io->read(io->context, 0xf00c, &fault) || (fault & (uint8_t)~FUXI_VIBRATE_FAULT_AUTORES)) goto fail;
+                if (fuxi_rtp_fill(write, read_status, &fill)) goto fail;
+                if (!fill) break;
+            }
+            if (fill > 0 && fill + out_len <= FUXI_STREAM_FIFO_CAP) {
+                for (unsigned off = 0; off < out_len; off += 4) {
+                    if (write(0xf120, shaped + off, 4)) goto fail;
+                }
+                fuxi_stream_record_samples(st, shaped, out_len);
+                st->last_push_ns = now_ns;
+                st->last_push_fill = fill + out_len;
+                st->last_input_quiet = input_quiet;
+                st->tail_emitted = 0;
+                st->drain_polls = 0;
+                st->burst_chunks++;
+                st->burst_refills++;
+                st->burst_bytes += out_len;
+                if (peak > st->burst_raw_peak) st->burst_raw_peak = peak;
+                if (out_peak > st->burst_drive_peak) st->burst_drive_peak = out_peak;
+                if (out_peak > st->burst_out_peak) st->burst_out_peak = out_peak;
+                if (out_peak > st->burst_peak) st->burst_peak = out_peak;
+                return 0;
+            }
+            if (fill > 0) goto fail;
+        }
+        /* FIFO 在新段到達前已排空：收乾淨後原地 warm 起播 */
+        if (fuxi_stream_stop_play(io, write, st)) {
+            (void)fuxi_stream_close(io, write, st);
+            return -2;
+        }
+        st->last_burst_end_ns = now_ns;
+        st->burst_underruns++;
+    }
+
+    if (!st->configured) {
+        int rc = fuxi_stream_configure(io, write, read_status, st, vmax, autores_cleared);
+        if (rc) return rc;
+    } else {
+        if (io->read(io->context, 0xf00c, &fault) ||
+            fuxi_vibrate_clear_autores(io, &fault, autores_cleared) ||
+            fuxi_stream_rearm(io, write, st)) goto fail;
+    }
+
+    uint8_t flush = 1;
+    st->owns_fifo = 1;
+    if (write(0xf12d, &flush, 1) || fuxi_rtp_register(write, io, 0xf12d, 0)) goto fail;
+    fuxi_damp_reset(&st->damp);
+    if (st->damp.mode == 9u) {
+        uint64_t gap_ns = st->last_burst_end_ns ?
+            (now_ns > st->last_burst_end_ns ? (now_ns - st->last_burst_end_ns) : 0ull) :
+            10000000000ull;
+        uint64_t gap_ms = st->last_burst_end_ns ? (gap_ns / 1000000ull) : 0ull;
+        st->burst_gap_ms = (unsigned)(gap_ms > 99999u ? 99999u : gap_ms);
+        fuxi_damp_mode9_on_burst_start(&st->damp, gap_ns);
+        st->burst_repeat_level = st->damp.m9_repeat_level;
+    }
+    if (mode5_fresh_synth) {
+        unsigned profile = 0;
+        out_len = fuxi_damp_synth_transient(&st->damp, samples, length, shaped, sizeof(shaped),
+            &out_peak, &st->burst_zc, &profile);
+        if (!out_len) {
+            st->owns_fifo = 0;
+            return 0;
+        }
+        st->synth_active = 1;
+        st->synth_continuous = 0;
+        st->synth_input_samples = length;
+        st->synth_input_end_ns = now_ns + chunk_dur_ns;
+        st->burst_profile = profile;
+        st->burst_absorbed = 0;
+    } else if (st->damp.mode == 9u) {
+        out_len = fuxi_damp_process_mode9(&st->damp, samples, length, shaped, sizeof(shaped),
+            1, &out_peak, &st->burst_zc);
+        st->burst_profile = st->damp.m9_prof;
+        if (!out_len) {
+            st->owns_fifo = 0;
+            return 0;
+        }
+        st->synth_input_end_ns = now_ns + chunk_dur_ns;
+    } else if (st->damp.mode == 7u || st->damp.mode == 8u) {
+        out_len = fuxi_damp_process_mode7(&st->damp, samples, length, shaped, sizeof(shaped),
+            &out_peak, &st->burst_zc);
+        if (!out_len) {
+            st->owns_fifo = 0;
+            return 0;
+        }
+        st->synth_input_end_ns = now_ns + chunk_dur_ns;
+    } else if (st->damp.mode >= 5u) {
+        out_len = fuxi_damp_process_pitch(&st->damp, samples, length, shaped, sizeof(shaped),
+            &out_peak, &st->burst_zc);
+        if (!out_len) {
+            st->owns_fifo = 0;
+            return 0;
+        }
+        st->synth_input_end_ns = now_ns + chunk_dur_ns;
+    } else {
+        fuxi_damp_process(&st->damp, samples, shaped, length, &out_peak, &st->burst_zc);
+        out_len = length;
+    }
+    for (unsigned off = 0; off < out_len; off += 4) {
+        if (write(0xf120, shaped + off, 4)) goto fail;
+    }
+    if (!st->burst_chunks) {
+        st->burst_has_prev = 0;
+        st->burst_prev_sample = 0;
+    }
+    fuxi_stream_record_samples(st, shaped, out_len);
+    if (fuxi_rtp_fill(write, read_status, &fill) || fill != out_len) goto fail;
+    st->attempted_play = 1;
+    /* 對照同機 Android click.trace:108，確認無故障後清除 FAULT_CLR (0xf066=0x07) 再寫 0xf04c 起振 */
+    if (io->write(io->context, 0xf066, 0x07)) goto fail;
+    if (fuxi_rtp_register(write, io, 0xf04c, (uint8_t)(0x80u | st->hw_brake))) goto fail;
+    st->playing = 1;
+    st->last_push_ns = now_ns;
+    st->last_push_fill = out_len;
+    st->last_input_quiet = input_quiet;
+    st->drain_polls = 0;
+    st->tail_emitted = 0;
+    st->burst_chunks++;
+    st->burst_bytes += out_len;
+    if (peak > st->burst_raw_peak) st->burst_raw_peak = peak;
+    if (out_peak > st->burst_drive_peak) st->burst_drive_peak = out_peak;
+    if (out_peak > st->burst_out_peak) st->burst_out_peak = out_peak;
+    if (out_peak > st->burst_peak) st->burst_peak = out_peak;
+    return 0;
+fail:
+    return fuxi_stream_close(io, write, st) ? -2 : -1;
+}
+
+/* 回傳 2 表示低水位（<=96B）需 250 us 快速輪詢，1 表示仍在排空，
+ * 0 表示本段突發已正常結束（保持 warm），負值表示錯誤（已關閉還原）。 */
+static inline int fuxi_stream_poll_drain(const FuxiHapticIo *io, FuxiRtpWrite write,
+    FuxiRtpReadStatus read_status, FuxiHapticStream *st, uint64_t now_ns)
+{
+    uint8_t fault = 0;
+    unsigned fill = 0;
+    if (!st->playing) return 0;
+    if (io->read(io->context, 0xf00c, &fault) || (fault & (uint8_t)~FUXI_VIBRATE_FAULT_AUTORES)) goto fail;
+    if (fuxi_rtp_fill(write, read_status, &fill)) goto fail;
+    if (fill > 0) {
+        const unsigned tail_thresh = st->damp.mode >= 5u ?
+            FUXI_STREAM_TAIL_THRESHOLD_PITCH : FUXI_STREAM_TAIL_THRESHOLD;
+        uint64_t quiet_ns = FUXI_STREAM_TAIL_QUIET_NS;
+        if (st->damp.mode >= 5u && st->last_input_quiet) {
+            uint64_t drain_ns = st->last_push_fill > tail_thresh ?
+                ((uint64_t)(st->last_push_fill - tail_thresh) * 1000000ull) / 24u : 0ull;
+            uint64_t adaptive = drain_ns > FUXI_STREAM_TAIL_MARGIN_NS ?
+                drain_ns - FUXI_STREAM_TAIL_MARGIN_NS : 0ull;
+            if (adaptive < quiet_ns) quiet_ns = adaptive;
+        }
+        const int allow_tail = st->damp.mode && !st->damp.no_tail &&
+            !(st->damp.mode == 5u && st->synth_active) &&
+            now_ns >= st->last_push_ns + quiet_ns;
+        if (!st->tail_emitted && fill <= tail_thresh && allow_tail) {
+            uint8_t tail[FUXI_DAMP_TAIL_MAX];
+            unsigned tail_peak = 0;
+            unsigned tail_lim = FUXI_DAMP_PCM_LIMIT;
+            if ((st->damp.mode == 5u || st->damp.mode == 6u) && st->burst_drive_peak > 0u) {
+                unsigned scaled = (st->burst_drive_peak * 9u) / 8u;
+                if (scaled < FUXI_STREAM_TAIL_LIMIT_MIN) scaled = FUXI_STREAM_TAIL_LIMIT_MIN;
+                if (scaled > FUXI_DAMP_PCM_LIMIT) scaled = FUXI_DAMP_PCM_LIMIT;
+                tail_lim = scaled;
+            }
+            unsigned tail_len = fuxi_damp_tail_limited(&st->damp, tail, sizeof(tail), tail_lim, &tail_peak, &st->burst_zc);
+            st->tail_emitted = 1;
+            if (tail_len > 0 && fill + tail_len <= FUXI_STREAM_FIFO_CAP) {
+                for (unsigned off = 0; off < tail_len; off += 4) {
+                    if (write(0xf120, tail + off, 4)) goto fail;
+                }
+                fuxi_stream_record_samples(st, tail, tail_len);
+                st->burst_tails++;
+                st->burst_tail_bytes += tail_len;
+                st->burst_bytes += tail_len;
+                if (tail_peak > st->burst_out_peak) st->burst_out_peak = tail_peak;
+                if (tail_peak > st->burst_peak) st->burst_peak = tail_peak;
+                st->drain_polls = 0;
+                return (fill + tail_len) <= FUXI_STREAM_FAST_POLL_WATERMARK ? 2 : 1;
+            }
+        }
+        if (++st->drain_polls > FUXI_STREAM_MAX_DRAIN_POLLS) goto fail;
+        return fill <= FUXI_STREAM_FAST_POLL_WATERMARK ? 2 : 1;
+    }
+    if (fuxi_stream_stop_play(io, write, st)) {
+        (void)fuxi_stream_close(io, write, st);
+        return -2;
+    }
+    st->last_burst_end_ns = now_ns;
+    st->idle_since_ns = now_ns;
+    return 0;
+fail:
+    return fuxi_stream_close(io, write, st) ? -2 : -1;
+}
+
+#endif /* FUXI_HAPTIC_STREAM_H */
