+void fuxi_amp_live_kick(void)
+{
+    __atomic_fetch_add(&fuxi_amp_live_kick_seq, 1u, __ATOMIC_RELEASE);
+    thread_wakeup((event_t)&fuxi_amp_live_kick_seq);
+}
+
+static void ampLiveSleep(unsigned ms, uint32_t seen)
+{
+    uint64_t deadline = 0;
+    clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+    assert_wait_deadline((event_t)&fuxi_amp_live_kick_seq, THREAD_UNINT, deadline);
+    if (__atomic_load_n(&fuxi_amp_live_kick_seq, __ATOMIC_ACQUIRE) != seen) {
+        clear_wait(current_thread(), THREAD_AWAKENED);
+        return;
+    }
+    thread_block(THREAD_CONTINUE_NULL);
+}
+
+static uint64_t ampNowNs(void)
+{
+    uint64_t absolute = 0, nanoseconds = 0;
+    clock_get_uptime(&absolute);
+    absolutetime_to_nanoseconds(absolute, &nanoseconds);
+    return nanoseconds;
+}
