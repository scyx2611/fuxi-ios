+/* mode 8：下方喇叭即時播音（搭配 fuxi,audio-spf=6 與 FuxiAudio.driver）。
+ * 沿用 mode 7 已驗證的保護韌體檢核、升壓限制、PLL 上電與故障輪詢；
+ * 類比增益與數位上限硬夾在安全範圍內，無音訊超過 2 秒自動切回靜音；
+ * 啟用 fuxi,audio-idle-pdn 時，靜音後進一步執行 ampToneDown 待機下電，消除重開機／關機爆音。 */
+static int ampLive(uint8_t address)
+{
+    uint32_t status[4] = {0}, status3 = 0, state = FUXI_TONE_PENDING;
+    unsigned waited = 0, pup = 0, checks = 0, stage = 1;
+    int ok = 0, touched = 0, hw_on = 0, quiet = 1;
+    const uint32_t gain = fuxi_audio_clamp_gain(ampChosenU32("fuxi,audio-gain", FUXI_AUDIO_GAIN_DEFAULT));
+    int32_t max_db = (int32_t)ampChosenU32("fuxi,audio-max-db", (uint32_t)(int32_t)FUXI_AUDIO_MAX_DB_DEFAULT);
+    if (max_db > 0) max_db = 0;
+    if (max_db < -36) max_db = -36;
+    const int max_db_x8 = max_db * 8;
+    const uint32_t chime = ampChosenU32("fuxi,audio-chime", 1u);
+    const uint32_t idle_pdn_ms = fuxi_audio_clamp_idle_pdn_ms(ampChosenU32("fuxi,audio-idle-pdn", 0u));
+    uint32_t cur_vol = FUXI_AUDIO_DIG_VOL_MUTE;
+    FuxiAmpPowerState pwr = {0};
+
+    if (!fuxi_amp_tone_move(FUXI_TONE_PENDING, FUXI_TONE_READY)) {
+        printf("FUXI AMP: live refused, PCM side already gave up (state %u)\n", fuxi_amp_tone_get());
+        return 0;
+    }
+    printf("FUXI AMP: live ready, bottom amplifier muted, waiting for the TDM clock\n");
+    while ((state = fuxi_amp_tone_get()) == FUXI_TONE_READY && waited < FM_TONE_READY_MS) {
+        IOSleep(5);
+        waited += 5;
+    }
+    if (state == FUXI_TONE_READY && !fuxi_amp_tone_move(FUXI_TONE_READY, FUXI_TONE_FAILED)) state = fuxi_amp_tone_get();
+    if (state != FUXI_TONE_CLOCKED) goto out;
+    stage = 2;
+    touched = 1;
+    hw_on = 1;
+    if (!ampTonePrepare(address)) goto out;
+    if (!ampSet(address, FM_AMP_GAIN, (gain << 5) | FM_AMP_GAIN_ZC)) goto out;
+    IOSleep(100);
+    stage = 3;
+    if (!ampTonePowerUp(address, &pup, &status3)) goto out;
+    IOSleep(200);
+    stage = 4;
+    if (!ampToneCheck(address, status)) goto out;
+    stage = 5;
+    cur_vol = chime ? fuxi_audio_volume_to_reg(500u, max_db_x8) : FUXI_AUDIO_DIG_VOL_MUTE;
+    if (!ampSet(address, FM_DIG_VOL, cur_vol)) goto out;
+    stage = 6;
+    if (!fuxi_amp_tone_move(FUXI_TONE_CLOCKED, FUXI_TONE_ON)) goto out;
+    printf("FUXI AMP: live on gain=%u max_db=%d reg=%#x after %u ms, pup %u ms, pll %#x, irq1=%#x/%#x/%#x/%#x idle-pdn=%u\n",
+        gain, max_db, cur_vol, waited, pup, status3, status[0], status[1], status[2], status[3], idle_pdn_ms);
+    stage = 7;
+    const uint64_t start_ns = ampNowNs();
+    const uint32_t init_packed = __atomic_load_n(&fuxi_audio_vol_packed, __ATOMIC_ACQUIRE);
+    const uint64_t init_nz = __atomic_load_n(&fuxi_audio_last_nonzero_ns, __ATOMIC_ACQUIRE);
+    fuxi_amp_power_init(&pwr, start_ns, fuxi_audio_vol_active(init_packed), init_nz,
+        cur_vol == FUXI_AUDIO_DIG_VOL_MUTE);
+    __atomic_store_n(&fuxi_amp_live_awake, cur_vol != FUXI_AUDIO_DIG_VOL_MUTE ? 1u : 0u, __ATOMIC_RELEASE);
+    unsigned ticks = 0;
+    while ((state = fuxi_amp_tone_get()) == FUXI_TONE_ON) {
+        const uint32_t kick_seen = __atomic_load_n(&fuxi_amp_live_kick_seq, __ATOMIC_ACQUIRE);
+        const uint64_t now_ns = ampNowNs();
+        const uint32_t packed = __atomic_load_n(&fuxi_audio_vol_packed, __ATOMIC_ACQUIRE);
+        const uint64_t last_nz = __atomic_load_n(&fuxi_audio_last_nonzero_ns, __ATOMIC_ACQUIRE);
+        const int in_chime = chime && now_ns >= start_ns && (now_ns - start_ns) < 700000000ull;
+        int want_unmute = 0;
+        const enum fuxi_amp_power_action action = fuxi_amp_power_step(&pwr, now_ns, in_chime,
+            fuxi_audio_vol_active(packed), last_nz, idle_pdn_ms, &want_unmute);
+        const uint32_t want_reg = in_chime ? fuxi_audio_volume_to_reg(500u, max_db_x8) :
+            want_unmute ? fuxi_audio_volume_to_reg(fuxi_audio_vol_milli(packed), max_db_x8) :
+            FUXI_AUDIO_DIG_VOL_MUTE;
+        if (action == FUXI_AMP_ACT_STANDBY) {
+            __atomic_store_n(&fuxi_amp_live_awake, 0u, __ATOMIC_RELEASE);
+            if (cur_vol != FUXI_AUDIO_DIG_VOL_MUTE) {
+                if (!ampWrite32(address, FM_DIG_VOL, FUXI_AUDIO_DIG_VOL_MUTE)) {
+                    printf("FUXI AMP: live standby mute write failed\n");
+                    break;
+                }
+                cur_vol = FUXI_AUDIO_DIG_VOL_MUTE;
+                IOSleep(FUXI_AUDIO_IDLE_PDN_RAMP_MS);
+            }
+            if (!ampToneDownEx(address, 1)) {
+                printf("FUXI AMP: live standby #%u failed (PDN_DONE missing)\n", pwr.pdn_count + 1u);
+                break;
+            }
+            pwr.powered = 0;
+            hw_on = 0;
+            pwr.pdn_count++;
+            if (pwr.pdn_count <= 24u) {
+                const uint64_t silent_ms = now_ns >= pwr.last_activity_ns ? (now_ns - pwr.last_activity_ns) / 1000000ull : 0ull;
+                printf("FUXI AMP: live standby #%u after %llu ms silent bst_off=1\n", pwr.pdn_count, (unsigned long long)silent_ms);
+            }
+            continue;
+        }
+        if (action == FUXI_AMP_ACT_WAKE) {
+            unsigned wake_pup = 0;
+            uint32_t wake_st3 = 0;
+            hw_on = 1;
+            if (!ampLiveWake(address, gain, &wake_pup, &wake_st3, status) ||
+                !ampWrite32(address, FM_DIG_VOL, want_reg)) {
+                printf("FUXI AMP: live wake #%u failed\n", pwr.wake_count + 1u);
+                break;
+            }
+            pwr.powered = 1;
+            pwr.wake_count++;
+            cur_vol = want_reg;
+            ticks = 0;
+            __atomic_store_n(&fuxi_amp_live_awake, 1u, __ATOMIC_RELEASE);
+            if (pwr.wake_count <= 24u) {
+                printf("FUXI AMP: live wake #%u pup=%u ms pll=%#x\n", pwr.wake_count, wake_pup, wake_st3);
+            }
+            ampLiveSleep(20, kick_seen);
+            continue;
+        }
+        if (!pwr.powered) {
+            ampLiveSleep(5, kick_seen);
+            continue;
+        }
+        ticks++;
+        if (want_reg != cur_vol) {
+            if (!want_unmute) {
+                __atomic_store_n(&fuxi_amp_live_awake, 0u, __ATOMIC_RELEASE);
+            }
+            if (!ampWrite32(address, FM_DIG_VOL, want_reg)) {
+                printf("FUXI AMP: live volume write failed reg=%#x\n", want_reg);
+                break;
+            }
+            cur_vol = want_reg;
+            if (want_unmute) {
+                __atomic_store_n(&fuxi_amp_live_awake, 1u, __ATOMIC_RELEASE);
+            }
+        } else if (want_unmute) {
+            __atomic_store_n(&fuxi_amp_live_awake, 1u, __ATOMIC_RELEASE);
+        }
+        if (ticks % 10u == 0) {
+            checks++;
+            if (!ampToneCheck(address, status)) {
+                printf("FUXI AMP: live fault irq1=%#x/%#x/%#x/%#x\n", status[0], status[1], status[2], status[3]);
+                break;
+            }
+            if (status[2] & FM_TONE_PLL_UNLOCK) {
+                printf("FUXI AMP: live PLL unlock irq1_status3=%#x\n", status[2]);
+                break;
+            }
+        }
+        ampLiveSleep(20, kick_seen);
+    }
+    ok = state == FUXI_TONE_DRAIN || state == FUXI_TONE_OFF;
+out:
+    __atomic_store_n(&fuxi_amp_live_awake, 0u, __ATOMIC_RELEASE);
+    if (!ok && !fuxi_amp_tone_move(FUXI_TONE_DRAIN, FUXI_TONE_FAILED)) fuxi_amp_tone_abandon();
+    if (hw_on) {
+        if (stage >= 6 && cur_vol != FUXI_AUDIO_DIG_VOL_MUTE) {
+            (void)ampWrite32(address, FM_DIG_VOL, FUXI_AUDIO_DIG_VOL_MUTE);
+            IOSleep(FUXI_AUDIO_IDLE_PDN_RAMP_MS);
+        }
+        quiet = ampToneDownEx(address, 1);
+    }
+    printf("FUXI AMP: live stopped stage=%u waited=%u ms checks=%u pdns=%u wakes=%u irq1=%#x/%#x/%#x/%#x down %s state=%u\n",
+        stage, waited, checks, pwr.pdn_count, pwr.wake_count, status[0], status[1], status[2], status[3],
+        touched ? (quiet ? "ok" : "incomplete") : "not needed", fuxi_amp_tone_get());
+    return ok;
+}
