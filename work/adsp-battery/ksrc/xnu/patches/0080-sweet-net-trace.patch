  * If called directly from within the networking stack (as opposed to via
  * pru_control), the socket parameter may be NULL.
  */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+static int sweet_in_logged;
+
+static uint32_t
+fuxi_net_trace_filter_in(void)
+{
+	static int cached = -1;
+	int cur = __atomic_load_n(&cached, __ATOMIC_ACQUIRE);
+	if (cur >= 0) {
+		return (uint32_t)cur;
+	}
+	uint32_t val = 0u;
+	if (!PE_parse_boot_argn("sweetnettrace", &val, sizeof(val))) {
+		DTEntry chosen = NULL;
+		const void *prop = NULL;
+		unsigned int bytes = 0;
+		if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+		    SecureDTGetProperty(chosen, "fuxi,net-trace-filter", &prop, &bytes) == kSuccess &&
+		    prop != NULL && bytes == sizeof(uint32_t)) {
+			memcpy(&val, prop, sizeof(val));
+		}
+	}
+	if (val > 2u) {
+		val = 0u;
+	}
+	__atomic_store_n(&cached, (int)val, __ATOMIC_RELEASE);
+	return val;
+}
+
+static void
+fuxi_net_trace_log_in(u_long cmd, caddr_t data, struct ifnet *ifp, struct proc *p)
+{
+	if (__atomic_load_n(&sweet_in_logged, __ATOMIC_RELAXED) < 100 &&
+	    __atomic_fetch_add(&sweet_in_logged, 1, __ATOMIC_RELAXED) < 100) {
+		const uint8_t *a = (cmd == SIOCAIFADDR)
+		    ? (const uint8_t *)&((struct in_aliasreq *)(void *)data)->ifra_addr.sin_addr
+		    : (const uint8_t *)&((const struct sockaddr_in *)(const void *)&((struct ifreq *)(void *)data)->ifr_addr)->sin_addr;
+		char pname[20];
+		proc_name(proc_pid(p), pname, sizeof(pname));
+		printf("SWEET NET: %s %s %s %u.%u.%u.%u\n", pname, if_name(ifp),
+		    cmd == SIOCAIFADDR ? "add address" : "delete address", a[0], a[1], a[2], a[3]);
+	}
+}
+#endif
 int
