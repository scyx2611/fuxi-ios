+static int c4LoadTabForMode(uint32_t sensor_id, uint32_t mode, const uint8_t **tab_out, struct fc_tab_header *hdr_out)
+{
+    const struct fc_sensor_hw *hw = fc_sensor_hw_for(sensor_id);
