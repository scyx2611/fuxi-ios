+    if (gain > FC_OV13B10_GAIN_MAX) gain = FC_OV13B10_GAIN_MAX;
+    if (gain < 0x0200u) return gain & ~0x0fu;
+    if (gain < 0x0400u) return gain & ~0x1fu;
+    if (gain < 0x0800u) return gain & ~0x3fu;
+    return gain & ~0x7fu;
