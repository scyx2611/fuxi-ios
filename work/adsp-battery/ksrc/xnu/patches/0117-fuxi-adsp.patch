+#define FM_OTPID 0x10u
+#define FM_TEST_KEY 0x40u
+#define FM_OTP_MEM0 0x400u
+#define FM_PLL_CLK_CTRL 0x2c04u
+#define FM_DSP_CLK_CTRL 0x2c08u
