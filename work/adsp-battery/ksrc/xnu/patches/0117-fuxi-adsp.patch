+#define FM_OTP_BOOT_DONE 0x02u
+#define FM_OTP_BOOT_ERR 0x80000000u
+#define FM_PWR_CTRL1 0x2014u
+#define FM_PWR_CTRL2 0x2018u
+#define FM_CCM_CORE_CTRL 0x02bc1000u
