+static uint64_t fuxi_bt_now_us(void *context)
+{
+    uint64_t absolute, nanoseconds;
+    (void)context;
+    clock_get_uptime(&absolute);
+    absolutetime_to_nanoseconds(absolute, &nanoseconds);
+    return nanoseconds / 1000u;
+}
