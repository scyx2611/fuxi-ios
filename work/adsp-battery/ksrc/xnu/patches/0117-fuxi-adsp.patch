+static void fuxi_bt_file_release(void *context, struct fuxi_bt_blob *blob)
+{
+    (void)context;
+    if (blob->data) {
+        kmem_free(kernel_map, (vm_offset_t)blob->data, round_page((vm_size_t)blob->size));
+    }
+    blob->data = NULL;
+    blob->size = 0;
+}
