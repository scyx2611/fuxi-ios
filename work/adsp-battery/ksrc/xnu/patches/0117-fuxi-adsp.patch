+    if (!fuxi_vibrate_wait_disabled(io, polls)) {
+        if (!result && brake) result = fuxi_haptic_write_checked(io, 0xf04c, FUXI_VIBRATE_IDLE);
+        return result;
+    }
+    *toggled = 1;
