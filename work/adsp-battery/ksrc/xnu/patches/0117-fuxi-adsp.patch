+/* 停止；*toggled 表示有沒有走關開模組的退路。回傳非 0 就要鎖死執行期。 */
+static inline int fuxi_vibrate_stop(const FuxiHapticIo *io, unsigned brake, unsigned *polls, unsigned *toggled)
