+#define FM_SCL_COUNTERS (5u << 20 | 11u << 10 | 22u) /* 400 kHz from 19.2 MHz (i2c-qcom-geni.c): high 5, low 11, cycle 22 */
+#define FM_CLK_CFG (2u << 4 | 1u)                     /* divider 2, enable */
