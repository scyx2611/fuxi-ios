+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <pexpert/device_tree.h>
+#include "fuxi_exec_inject.h"
+/*
+ * Boot-arg fxinj, else ADT /chosen u32 "fuxi,inject" (the daily loader's boot-args field is full), read once:
+ * neither changes after boot, and two first readers agree.
+ */
+static unsigned
+fuxi_inject_mode(void)
+{
+	static volatile SInt32 cached = -1;
+	unsigned mode = 0;
+	DTEntry chosen;
+	void const *prop;
+	unsigned int bytes;
+
+	if (cached >= 0) {
+		return (unsigned)cached;
+	}
+	if (!PE_parse_boot_argn("fxinj", &mode, sizeof(mode))) {
+		mode = 0;
+		if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+		    SecureDTGetProperty(chosen, "fuxi,inject", &prop, &bytes) == kSuccess && bytes == sizeof(uint32_t)) {
+			memcpy(&mode, prop, sizeof(mode));
+		}
+	}
+	mode &= FUXI_INJECT_ALL;
+	cached = (SInt32)mode;
+	return mode;
+}
+
+/* The mode once, then the first programs that get a library. */
+static void
+fuxi_inject_said(unsigned mode, const char *name, const char *library)
+{
+	static volatile SInt32 said;
+	SInt32 n = OSIncrementAtomic(&said);
+
+	if (n == 0) {
+		printf("FUXI INJECT: fxinj=%u:%s%s%s%s%s%s%s%s%s%s\n", mode,
+		    (mode & FUXI_INJECT_APPS) ? " applications get " FUXI_INJECT_APP_LIB ";" : "",
+		    (mode & FUXI_INJECT_SPRINGBOARD) ? " SpringBoard gets " FUXI_INJECT_SB_LIB ";" : "",
+		    (mode & FUXI_INJECT_MEDIASERVER) ? " mediaserverd gets " FUXI_INJECT_SB_LIB : "",
+		    (mode & FUXI_INJECT_WIFI_AUDIT) ? " wifid gets " FUXI_INJECT_SB_LIB : "",
+		    (mode & FUXI_INJECT_WIFI_PROMPT) ? " Preferences gets " FUXI_INJECT_SB_LIB : "",
+		    (mode & FUXI_INJECT_BLUETOOL) ? " BlueTool gets " FUXI_INJECT_SB_LIB : "",
+		    (mode & FUXI_INJECT_BLUETOOTHD) ? " bluetoothd gets " FUXI_INJECT_SB_LIB : "",
+		    (mode & FUXI_INJECT_VOICEMEMOS) ? " VoiceMemos/voicememod gets " FUXI_INJECT_SB_LIB : "",
+		    (mode & FUXI_INJECT_TIMED) ? " timed gets " FUXI_INJECT_SB_LIB : "",
+		    (mode & FUXI_INJECT_DICTATION) ? " dictation gets " FUXI_INJECT_SB_LIB : "");
+	}
+	if (n < FUXI_INJECT_SAID) {
+		printf("FUXI INJECT: %s <- %s\n", name, library);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
