+  else if (fate == 3) { IOLockLock(fLock); fFifoQueued++; IOLockUnlock(fLock); } /* bit 4: this copy queued behind the waiting frame */
+  else if (fate == 4) { IOLockLock(fLock); fFifoQueued++; fFifoStarted++; IOLockUnlock(fLock); presentStats(fPublicationTime); } /* queued, and the offer STARTed the waiting frame */
