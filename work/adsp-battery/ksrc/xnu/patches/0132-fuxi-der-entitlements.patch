diff --git a/iokit/Kernel/arm/fuxi_der_entitlements.h b/iokit/Kernel/arm/fuxi_der_entitlements.h
new file mode 100644
index 0000000..fca3c09
--- /dev/null
+++ b/iokit/Kernel/arm/fuxi_der_entitlements.h
@@ -0,0 +1,368 @@
+/*
+ * Pure C11/C++ DER entitlements parser for SWEET/FUXI (Slot 7, 0xfade7172).
+ *
+ * Supports:
+ *   - CoreEntitlements v1: 0x70 [APP 16 CONSTRUCTED] { 0x02 INT(1), 0xb0|0x31|0x30 dict }
+ *   - CoreEntitlements v0 / ldid: 0x31 SET (or tolerant top-level 0x30 key/value SEQUENCE)
+ *   - Value types: Bool (0x01), Integer (0x02, 1..8B signed BE), Data (0x04),
+ *     UTF8String (0x0c, no NUL), Array (0x30), nested Dict (0xb0 / 0x31)
+ */
+#ifndef FUXI_DER_ENTITLEMENTS_H
+#define FUXI_DER_ENTITLEMENTS_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define FUXI_DER_MAGIC       0xfade7172u
+#define FUXI_DER_MAX_BLOB    1048576u
+#define FUXI_DER_MAX_DEPTH   16u
+#define FUXI_DER_MAX_STRING  262142u
+#define FUXI_DER_MAX_KEY     4096u
+
+struct fuxi_der_ops {
+	void *(*make_bool)(void *ctx, bool value);
+	void *(*make_number)(void *ctx, uint64_t value, unsigned int bits);
+	void *(*make_data)(void *ctx, const uint8_t *bytes, size_t len);
+	void *(*make_string)(void *ctx, const char *str, size_t len);
+	void *(*make_array)(void *ctx, unsigned int capacity);
+	bool (*array_append)(void *ctx, void *arr, void *elem);
+	void *(*make_dict)(void *ctx, unsigned int capacity);
+	bool (*dict_set)(void *ctx, void *dict, const char *key, size_t key_len, void *val);
+	void (*release)(void *ctx, void *obj);
+};
+
+static inline uint32_t
+fuxi_der_be32(const uint8_t *p)
+{
+	return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+	       ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
+
+static inline bool
+fuxi_der_has_nul(const uint8_t *p, size_t len)
+{
+	for (size_t i = 0; i < len; i++) {
+		if (p[i] == '\0') {
+			return true;
+		}
+	}
+	return false;
+}
+
+static inline bool
+fuxi_der_read_tlv(const uint8_t *p, const uint8_t *end,
+    uint8_t *tag_out, const uint8_t **val_out, size_t *len_out, const uint8_t **next_out)
+{
+	if (p == NULL || end == NULL || p >= end) {
+		return false;
+	}
+	uint8_t tag = *p++;
+	if ((tag & 0x1fu) == 0x1fu) {
+		return false; /* high-tag-number form not supported */
+	}
+	if (p >= end) {
+		return false;
+	}
+	uint8_t lb = *p++;
+	size_t len = 0;
+	if ((lb & 0x80u) == 0) {
+		len = lb;
+	} else {
+		uint8_t nbytes = lb & 0x7fu;
+		if (lb == 0x80u || lb == 0xffu || nbytes == 0 || nbytes > 4) {
+			return false;
+		}
+		if ((size_t)(end - p) < nbytes) {
+			return false;
+		}
+		if (p[0] == 0x00u) {
+			return false; /* non-minimal DER length */
+		}
+		for (uint8_t i = 0; i < nbytes; i++) {
+			len = (len << 8) | (size_t)p[i];
+		}
+		if (len < 128u) {
+			return false; /* non-minimal DER length */
+		}
+		p += nbytes;
+	}
+	if (len > (size_t)(end - p)) {
+		return false;
+	}
+	*tag_out = tag;
+	*val_out = p;
+	*len_out = len;
+	*next_out = p + len;
+	return true;
+}
+
+static inline bool
+fuxi_der_parse_int64(const uint8_t *val, size_t len, uint64_t *out)
+{
+	if (len == 0 || len > 8) {
+		return false;
+	}
+	uint64_t u = (val[0] & 0x80u) ? ~0ULL : 0ULL;
+	for (size_t i = 0; i < len; i++) {
+		u = (u << 8) | (uint64_t)val[i];
+	}
+	*out = u;
+	return true;
+}
+
+static inline bool
+fuxi_der_count_items(const uint8_t *p, const uint8_t *end, unsigned int *count_out)
+{
+	unsigned int count = 0;
+	while (p < end) {
+		uint8_t tag = 0;
+		const uint8_t *val = NULL;
+		size_t len = 0;
+		const uint8_t *next = NULL;
+		if (!fuxi_der_read_tlv(p, end, &tag, &val, &len, &next)) {
+			return false;
+		}
+		(void)tag;
+		(void)val;
+		(void)len;
+		if (count == ~0u) {
+			return false;
+		}
+		count++;
+		p = next;
+	}
+	*count_out = count;
+	return p == end;
+}
+
+static void *fuxi_der_parse_dict(const uint8_t *p, const uint8_t *end,
+    const struct fuxi_der_ops *ops, void *ctx, unsigned int depth);
+
+static void *
+fuxi_der_parse_value(const uint8_t *p, const uint8_t *end, const uint8_t **next_out,
+    const struct fuxi_der_ops *ops, void *ctx, unsigned int depth)
+{
+	if (depth > FUXI_DER_MAX_DEPTH) {
+		return NULL;
+	}
+	uint8_t tag = 0;
+	const uint8_t *val = NULL;
+	size_t len = 0;
+	const uint8_t *next = NULL;
+	if (!fuxi_der_read_tlv(p, end, &tag, &val, &len, &next)) {
+		return NULL;
+	}
+	void *obj = NULL;
+	switch (tag) {
+	case 0x01: /* BOOLEAN */
+		if (len != 1) {
+			return NULL;
+		}
+		obj = ops->make_bool(ctx, val[0] != 0);
+		break;
+	case 0x02: { /* INTEGER */
+		uint64_t u = 0;
+		if (!fuxi_der_parse_int64(val, len, &u)) {
+			return NULL;
+		}
+		obj = ops->make_number(ctx, u, 64u);
+		break;
+	}
+	case 0x04: /* OCTET STRING */
+		obj = ops->make_data(ctx, len ? val : (const uint8_t *)"", len);
+		break;
+	case 0x0c: /* UTF8String */
+		if (len >= FUXI_DER_MAX_STRING || fuxi_der_has_nul(val, len)) {
+			return NULL;
+		}
+		obj = ops->make_string(ctx, len ? (const char *)val : "", len);
+		break;
+	case 0x30: { /* SEQUENCE -> Array */
+		if (depth >= FUXI_DER_MAX_DEPTH) {
+			return NULL;
+		}
+		unsigned int count = 0;
+		if (!fuxi_der_count_items(val, next, &count)) {
+			return NULL;
+		}
+		void *arr = ops->make_array(ctx, count);
+		if (arr == NULL) {
+			return NULL;
+		}
+		const uint8_t *cur = val;
+		while (cur < next) {
+			const uint8_t *elem_next = NULL;
+			void *elem = fuxi_der_parse_value(cur, next, &elem_next, ops, ctx, depth + 1u);
+			if (elem == NULL) {
+				ops->release(ctx, arr);
+				return NULL;
+			}
+			bool ok = ops->array_append(ctx, arr, elem);
+			ops->release(ctx, elem);
+			if (!ok) {
+				ops->release(ctx, arr);
+				return NULL;
+			}
+			cur = elem_next;
+		}
+		if (cur != next) {
+			ops->release(ctx, arr);
+			return NULL;
+		}
+		obj = arr;
+		break;
+	}
+	case 0xb0: /* CE v1 Dictionary */
+	case 0x31: /* CE v0 / ldid Dictionary */
+		obj = fuxi_der_parse_dict(val, next, ops, ctx, depth);
+		break;
+	default:
+		return NULL;
+	}
+	if (obj == NULL) {
+		return NULL;
+	}
+	*next_out = next;
+	return obj;
+}
+
+static void *
+fuxi_der_parse_dict(const uint8_t *p, const uint8_t *end,
+    const struct fuxi_der_ops *ops, void *ctx, unsigned int depth)
+{
+	if (depth >= FUXI_DER_MAX_DEPTH) {
+		return NULL;
+	}
+	unsigned int count = 0;
+	if (!fuxi_der_count_items(p, end, &count)) {
+		return NULL;
+	}
+	void *dict = ops->make_dict(ctx, count);
+	if (dict == NULL) {
+		return NULL;
+	}
+	const uint8_t *cur = p;
+	while (cur < end) {
+		uint8_t item_tag = 0;
+		const uint8_t *item_val = NULL;
+		size_t item_len = 0;
+		const uint8_t *item_next = NULL;
+		if (!fuxi_der_read_tlv(cur, end, &item_tag, &item_val, &item_len, &item_next) ||
+		    item_tag != 0x30) {
+			ops->release(ctx, dict);
+			return NULL;
+		}
+		const uint8_t *item_end = item_next;
+
+		uint8_t key_tag = 0;
+		const uint8_t *key_val = NULL;
+		size_t key_len = 0;
+		const uint8_t *val_start = NULL;
+		if (!fuxi_der_read_tlv(item_val, item_end, &key_tag, &key_val, &key_len, &val_start) ||
+		    key_tag != 0x0c || key_len == 0 || key_len > FUXI_DER_MAX_KEY ||
+		    key_len >= FUXI_DER_MAX_STRING || fuxi_der_has_nul(key_val, key_len)) {
+			ops->release(ctx, dict);
+			return NULL;
+		}
+
+		const uint8_t *val_end = NULL;
+		void *val_obj = fuxi_der_parse_value(val_start, item_end, &val_end, ops, ctx, depth + 1u);
+		if (val_obj == NULL || val_end != item_end) {
+			if (val_obj != NULL) {
+				ops->release(ctx, val_obj);
+			}
+			ops->release(ctx, dict);
+			return NULL;
+		}
+
+		bool ok = ops->dict_set(ctx, dict, (const char *)key_val, key_len, val_obj);
+		ops->release(ctx, val_obj);
+		if (!ok) {
+			ops->release(ctx, dict);
+			return NULL;
+		}
+		cur = item_next;
+	}
+	if (cur != end) {
+		ops->release(ctx, dict);
+		return NULL;
+	}
+	return dict;
+}
+
+static inline void *
+fuxi_der_parse_blob(const uint8_t *blob, size_t blob_len,
+    const struct fuxi_der_ops *ops, void *ctx)
+{
+	if (blob == NULL || ops == NULL ||
+	    ops->make_bool == NULL || ops->make_number == NULL ||
+	    ops->make_data == NULL || ops->make_string == NULL ||
+	    ops->make_array == NULL || ops->array_append == NULL ||
+	    ops->make_dict == NULL || ops->dict_set == NULL || ops->release == NULL) {
+		return NULL;
+	}
+	if (blob_len < 8u || blob_len > FUXI_DER_MAX_BLOB) {
+		return NULL;
+	}
+	uint32_t magic = fuxi_der_be32(blob);
+	uint32_t total_len = fuxi_der_be32(blob + 4);
+	if (magic != FUXI_DER_MAGIC || total_len != blob_len) {
+		return NULL;
+	}
+	const uint8_t *payload = blob + 8;
+	size_t payload_len = blob_len - 8u;
+	if (payload_len == 0) {
+		return NULL;
+	}
+	if (payload_len >= 5 && payload[0] == '<' && payload[1] == '?' &&
+	    payload[2] == 'x' && payload[3] == 'm' && payload[4] == 'l') {
+		return NULL;
+	}
+	const uint8_t *payload_end = payload + payload_len;
+
+	uint8_t root_tag = 0;
+	const uint8_t *root_val = NULL;
+	size_t root_len = 0;
+	const uint8_t *root_next = NULL;
+	if (!fuxi_der_read_tlv(payload, payload_end, &root_tag, &root_val, &root_len, &root_next) ||
+	    root_next != payload_end) {
+		return NULL;
+	}
+
+	if (root_tag == 0x70) {
+		const uint8_t *root_end = root_val + root_len;
+		uint8_t ver_tag = 0;
+		const uint8_t *ver_val = NULL;
+		size_t ver_len = 0;
+		const uint8_t *dict_start = NULL;
+		uint64_t ver = 0;
+		if (!fuxi_der_read_tlv(root_val, root_end, &ver_tag, &ver_val, &ver_len, &dict_start) ||
+		    ver_tag != 0x02 || !fuxi_der_parse_int64(ver_val, ver_len, &ver) || ver != 1ULL) {
+			return NULL;
+		}
+		uint8_t dtag = 0;
+		const uint8_t *dval = NULL;
+		size_t dlen = 0;
+		const uint8_t *dnext = NULL;
+		if (!fuxi_der_read_tlv(dict_start, root_end, &dtag, &dval, &dlen, &dnext) ||
+		    dnext != root_end || (dtag != 0xb0 && dtag != 0x31 && dtag != 0x30)) {
+			return NULL;
+		}
+		return fuxi_der_parse_dict(dval, dnext, ops, ctx, 0u);
+	}
+	if (root_tag == 0x31 || root_tag == 0x30) {
+		return fuxi_der_parse_dict(root_val, root_next, ops, ctx, 0u);
+	}
+	return NULL;
+}
