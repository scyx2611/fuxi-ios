+++ b/bsd/dev/fuxi_haptic_shape.h
@@ -0,0 +1,94 @@
+#ifndef FUXI_HAPTIC_SHAPE_H
+#define FUXI_HAPTIC_SHAPE_H
+/*
+ * HAP525 觸感整形（ADT /chosen fuxi,haptic=6；預設關，需同時帶 fuxi,haptic-rtp 原廠點按波形）。
+ *
+ * 2026-11-20 使用者回報 iOS 震動「有些地方有震有些沒有，震感很爛，不是 iOS 的震動」。
+ * iOS HAL（FuxiAudio Actuator）每 10 ms 視窗依 PCM 峰值送一次 DIRECT_PLAY 請求（level<<16 | ms，
+ * level 0..128）。U-021 實機：SpringBoard 的輕觸只有一個 6 ms、level 17 的視窗（amp=0x11），
+ * LRA 約 5.7 ms 一週期，還沒起振就停，感覺不到；重的則是共振頻率的嗡聲加拖尾。
+ * 同機 Android 所有 UI 點按都以 FIFO 24 kHz 播 376 bytes 的 0_click_P_RTP.bin（約 16 ms，含起振與煞車，
+ * U-021 Android 基準）。11-19 mode 5 以固定 VMAX 播同一波形，使用者覺得所有場景強弱相近。
+ *
+ * 整形規則（只看請求的時間、毫秒與 level，不改 HAL）：
+ * - 間隔 ≥ FUXI_SHAPE_GAP_MS 才算新的一段觸感；
+ * - 新的一段若第一個請求 ≤ FUXI_SHAPE_CLICK_MS，改播原廠點按波形，VMAX 依該請求的 level
+ *   取平方根曲線，落在 Android VMAX 的 FUXI_SHAPE_FLOOR/256（約 45%）到 100%（強弱可分，最強不超過
+ *   Android 自己用的強度）；
+ * - 同一段在開始後 FUXI_SHAPE_SWALLOW_MS 內的後續視窗（含停止）屬於同一個 transient，吞掉；
+ * - 超過吞掉期間仍在送，就是連續觸感，交回原本的 DIRECT_PLAY（各視窗 level 照用）。
+ * 第一個請求 > FUXI_SHAPE_CLICK_MS 的（VibePattern 鈴聲、充電 400 ms）整段照舊。
+ */
+#include <stdint.h>
+
+enum {
+    FUXI_SHAPE_CLICK_MS = 20,
+    FUXI_SHAPE_SWALLOW_MS = 40,     /* 點按波形約 16 ms；iOS 較重的 transient 也在 30 ms 內 */
+    FUXI_SHAPE_GAP_MS = 8,
+    FUXI_SHAPE_DEFAULT_LEVEL = 96,  /* level 0（沿用暫存器振幅）的使用端當作中強 */
+    FUXI_SHAPE_MAX_LEVEL = 128,     /* HAL 的 ACTUATOR_MAX_LEVEL */
+    FUXI_SHAPE_FLOOR = 115          /* /256，最弱約 45% */
+};
+enum { FUXI_SHAPE_PASS = 0, FUXI_SHAPE_CLICK = 1, FUXI_SHAPE_SWALLOW = 2 };
+
+typedef struct {
+    uint64_t start, end;  /* 奈秒；end 為這段目前預計的結束時間 */
+    unsigned active;
+    unsigned clicked;     /* 這段已用點按波形代替，且仍在吞掉期間 */
+} FuxiShapeBurst;
+
+static inline unsigned fuxi_shape_isqrt(unsigned value)
+{
+    unsigned root = 0, bit = 1u << 30;
+    while (bit > value) bit >>= 2;
+    while (bit) {
+        if (value >= root + bit) {
+            value -= root + bit;
+            root = (root >> 1) + bit;
+        } else {
+            root >>= 1;
+        }
+        bit >>= 2;
+    }
+    return root;
+}
+
+/* 這次請求在 now（奈秒）送來、要震 ms 毫秒（0 是停止，已經 fuxi_vibrate_decode 檢查）。 */
+static inline unsigned fuxi_shape_classify(FuxiShapeBurst *burst, uint64_t now, unsigned ms)
+{
+    const uint64_t ms_ns = 1000000ull;
+    if (!burst) return FUXI_SHAPE_PASS;
+    int fresh = !burst->active || now < burst->start || now >= burst->end + FUXI_SHAPE_GAP_MS * ms_ns;
+    int swallowing = !fresh && burst->clicked && now - burst->start < FUXI_SHAPE_SWALLOW_MS * ms_ns;
+    if (!ms) {
+        /* 點按還在吞掉期間：不讓停止取消已排定的點按 */
+        if (swallowing) return FUXI_SHAPE_SWALLOW;
+        burst->clicked = 0;
+        if (burst->active && now < burst->end) burst->end = now;
+        return FUXI_SHAPE_PASS;
+    }
+    uint64_t end = now + (uint64_t)ms * ms_ns;
+    if (fresh) {
+        burst->active = 1;
+        burst->start = now;
+        burst->end = end;
+        burst->clicked = ms <= FUXI_SHAPE_CLICK_MS;
+        return burst->clicked ? FUXI_SHAPE_CLICK : FUXI_SHAPE_PASS;
+    }
+    if (end > burst->end) burst->end = end;
+    if (swallowing) return FUXI_SHAPE_SWALLOW;
+    burst->clicked = 0;
+    return FUXI_SHAPE_PASS;
+}
+
+/* level 0..128（0 視為 FUXI_SHAPE_DEFAULT_LEVEL，超過 128 視為 128）換成點按的 VMAX 碼；base 為 Android VMAX。 */
+static inline uint32_t fuxi_shape_vmax(unsigned level, uint32_t base)
+{
+    if (!level) level = FUXI_SHAPE_DEFAULT_LEVEL;
+    if (level > FUXI_SHAPE_MAX_LEVEL) level = FUXI_SHAPE_MAX_LEVEL;
+    if (base > 0xffu) return 0;
+    unsigned root = fuxi_shape_isqrt(level * 512u); /* 0..256 */
+    uint32_t vmax = (base * (FUXI_SHAPE_FLOOR * 256u + (256u - FUXI_SHAPE_FLOOR) * root) + 32768u) / 65536u;
+    return vmax || !base ? vmax : 1u;
+}
+#endif
