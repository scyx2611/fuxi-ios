+static inline int fc_str_eq(const char *a, const char *b)
+{
+    if (!a || !b) return 0;
+    while (*a && *b) {
+        if (*a != *b) return 0;
+        ++a;
+        ++b;
+    }
+    return *a == *b;
+}
