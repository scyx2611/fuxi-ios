++static inline uint32_t fgl_unlock_prepare_tx(const struct fgl_unlock_fsm *f, uint16_t txn,
++                                             uint8_t *sdu_out, uint32_t room, uint16_t *msg_id_out)
++{
++    if (!f || !sdu_out) return 0u;
