++        return fgl_build_reg_master_client(sdu_out, room, txn, FGL_MASTER_KEY_DEFAULT);
++    }
++    if (f->step == FGL_ULK_GET_LOCK_SEND) {
++        if (msg_id_out) *msg_id_out = FGL_LOC_GET_ENGINE_LOCK;
