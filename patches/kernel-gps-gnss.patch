++struct fgl_unlock_fsm {
++    uint8_t step;
++    uint8_t get_lock_retries;
++    uint8_t set_lock_retries;
++    uint8_t resp_ok_seen;
++    uint8_t last_err_active;
++    uint16_t cur_txn;
++    uint16_t last_err_msg;
++    uint16_t last_err_txn;
++    uint32_t t0_ms;
++    uint32_t absorbed_err3_count;
