++struct fgl_unlock_event {
++    uint8_t kind;
++    uint8_t retry;
++    uint16_t msg;
++    uint16_t txn;
++    uint32_t err;
++    uint32_t ind_status;
++    uint32_t lock_type;
++    uint8_t timed_out_step;
