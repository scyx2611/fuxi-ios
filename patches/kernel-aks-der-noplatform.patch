++/*
++ * Pure C11/C++ DER entitlements parser for SWEET/FUXI (Slot 7, 0xfade7172).
++ *
++ * Supports:
++ *   - CoreEntitlements v1: 0x70 [APP 16 CONSTRUCTED] { 0x02 INT(1), 0xb0|0x31|0x30 dict }
++ *   - CoreEntitlements v0 / ldid: 0x31 SET (or tolerant top-level 0x30 key/value SEQUENCE)
++ *   - Value types: Bool (0x01), Integer (0x02, 1..8B signed BE), Data (0x04),
++ *     UTF8String (0x0c, no NUL), Array (0x30), nested Dict (0xb0 / 0x31)
++ */
++#ifndef FUXI_DER_ENTITLEMENTS_H
++#define FUXI_DER_ENTITLEMENTS_H
++
++#include <stdbool.h>
++#include <stddef.h>
++#include <stdint.h>
++
++#ifdef __cplusplus
++extern "C" {
++#endif
++
++#define FUXI_DER_MAGIC       0xfade7172u
++#define FUXI_DER_MAX_BLOB    1048576u
++#define FUXI_DER_MAX_DEPTH   16u
++#define FUXI_DER_MAX_STRING  262142u
++#define FUXI_DER_MAX_KEY     4096u
++
++struct fuxi_der_ops {
++	void *(*make_bool)(void *ctx, bool value);
++	void *(*make_number)(void *ctx, uint64_t value, unsigned int bits);
++	void *(*make_data)(void *ctx, const uint8_t *bytes, size_t len);
++	void *(*make_string)(void *ctx, const char *str, size_t len);
++	void *(*make_array)(void *ctx, unsigned int capacity);
++	bool (*array_append)(void *ctx, void *arr, void *elem);
++	void *(*make_dict)(void *ctx, unsigned int capacity);
++	bool (*dict_set)(void *ctx, void *dict, const char *key, size_t key_len, void *val);
++	void (*release)(void *ctx, void *obj);
++};
++
++static inline uint32_t
++fuxi_der_be32(const uint8_t *p)
++{
++	return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
++	       ((uint32_t)p[2] << 8) | (uint32_t)p[3];
++}
++
++static inline bool
++fuxi_der_has_nul(const uint8_t *p, size_t len)
++{
++	for (size_t i = 0; i < len; i++) {
++		if (p[i] == '\0') {
++			return true;
++		}
++	}
++	return false;
++}
++
++static inline bool
++fuxi_der_read_tlv(const uint8_t *p, const uint8_t *end,
++    uint8_t *tag_out, const uint8_t **val_out, size_t *len_out, const uint8_t **next_out)
++{
++	if (p == NULL || end == NULL || p >= end) {
++		return false;
++	}
++	uint8_t tag = *p++;
++	if ((tag & 0x1fu) == 0x1fu) {
++		return false; /* high-tag-number form not supported */
++	}
++	if (p >= end) {
++		return false;
++	}
++	uint8_t lb = *p++;
++	size_t len = 0;
++	if ((lb & 0x80u) == 0) {
++		len = lb;
++	} else {
++		uint8_t nbytes = lb & 0x7fu;
++		if (lb == 0x80u || lb == 0xffu || nbytes == 0 || nbytes > 4) {
++			return false;
++		}
++		if ((size_t)(end - p) < nbytes) {
++			return false;
++		}
++		if (p[0] == 0x00u) {
++			return false; /* non-minimal DER length */
++		}
++		for (uint8_t i = 0; i < nbytes; i++) {
++			len = (len << 8) | (size_t)p[i];
++		}
++		if (len < 128u) {
++			return false; /* non-minimal DER length */
++		}
++		p += nbytes;
++	}
++	if (len > (size_t)(end - p)) {
++		return false;
++	}
++	*tag_out = tag;
++	*val_out = p;
++	*len_out = len;
++	*next_out = p + len;
++	return true;
++}
