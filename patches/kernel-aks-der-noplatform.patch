++		uint8_t tag = 0;
++		const uint8_t *val = NULL;
++		size_t len = 0;
++		const uint8_t *next = NULL;
++		if (!fuxi_der_read_tlv(p, end, &tag, &val, &len, &next)) {
++			return false;
++		}
++		(void)tag;
++		(void)val;
++		(void)len;
++		if (count == ~0u) {
++			return false;
++		}
++		count++;
++		p = next;
++	}
++	*count_out = count;
++	return p == end;
++}
