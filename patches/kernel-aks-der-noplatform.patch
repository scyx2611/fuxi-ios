++		const uint8_t *val_end = NULL;
++		void *val_obj = fuxi_der_parse_value(val_start, item_end, &val_end, ops, ctx, depth + 1u);
++		if (val_obj == NULL || val_end != item_end) {
++			if (val_obj != NULL) {
++				ops->release(ctx, val_obj);
++			}
++			ops->release(ctx, dict);
++			return NULL;
++		}
