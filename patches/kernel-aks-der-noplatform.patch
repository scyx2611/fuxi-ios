++		bool ok = ops->dict_set(ctx, dict, (const char *)key_val, key_len, val_obj);
++		ops->release(ctx, val_obj);
++		if (!ok) {
++			ops->release(ctx, dict);
++			return NULL;
++		}
++		cur = item_next;
++	}
++	if (cur != end) {
++		ops->release(ctx, dict);
