++
++static void *
++fuxi_der_parse_dict(const uint8_t *p, const uint8_t *end,
++    const struct fuxi_der_ops *ops, void *ctx, unsigned int depth)
++{
++	if (depth >= FUXI_DER_MAX_DEPTH) {
++		return NULL;
++	}
++	unsigned int count = 0;
++	if (!fuxi_der_count_items(p, end, &count)) {
++		return NULL;
++	}
++	void *dict = ops->make_dict(ctx, count);
++	if (dict == NULL) {
