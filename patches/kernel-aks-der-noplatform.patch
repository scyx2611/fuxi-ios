+        if (!ni) return false;
+        d->items = ni;
+        char **nk = (char **)realloc(d->keys, ncap * sizeof(*nk));
+        if (!nk) return false;
+        d->keys = nk;
+        d->cap = ncap;
+    }
+    char *kdup = (char *)malloc(klen + 1);
+    if (!kdup) return false;
