++	while (cur < end) {
++		uint8_t item_tag = 0;
++		const uint8_t *item_val = NULL;
++		size_t item_len = 0;
++		const uint8_t *item_next = NULL;
++		if (!fuxi_der_read_tlv(cur, end, &item_tag, &item_val, &item_len, &item_next) ||
