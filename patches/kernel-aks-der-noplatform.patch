+/* Minimal RFC 6234 SHA-256 + RFC 2104 HMAC-SHA256 for corecrypto stubs */
+#define CCSHA256_OUTPUT_SIZE 32
+struct ccdigest_info {
+    size_t output_size;
+    size_t block_size;
+};
+static const struct ccdigest_info sha256_info = { 32, 64 };
