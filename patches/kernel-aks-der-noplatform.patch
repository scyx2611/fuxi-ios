++		uint8_t key_tag = 0;
++		const uint8_t *key_val = NULL;
++		size_t key_len = 0;
++		const uint8_t *val_start = NULL;
++		if (!fuxi_der_read_tlv(item_val, item_end, &key_tag, &key_val, &key_len, &val_start) ||
++		    key_tag != 0x0c || key_len == 0 || key_len > FUXI_DER_MAX_KEY ||
++		    key_len >= FUXI_DER_MAX_STRING || fuxi_der_has_nul(key_val, key_len)) {
++			ops->release(ctx, dict);
++			return NULL;
++		}
