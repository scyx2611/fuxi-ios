++		}
++		unsigned int count = 0;
++		if (!fuxi_der_count_items(val, next, &count)) {
++			return NULL;
++		}
++		void *arr = ops->make_array(ctx, count);
++		if (arr == NULL) {
++			return NULL;
++		}
++		const uint8_t *cur = val;
++		while (cur < next) {
++			const uint8_t *elem_next = NULL;
++			void *elem = fuxi_der_parse_value(cur, next, &elem_next, ops, ctx, depth + 1u);
++			if (elem == NULL) {
++				ops->release(ctx, arr);
++				return NULL;
++			}
++			bool ok = ops->array_append(ctx, arr, elem);
++			ops->release(ctx, elem);
++			if (!ok) {
++				ops->release(ctx, arr);
++				return NULL;
++			}
++			cur = elem_next;
++		}
++		if (cur != next) {
++			ops->release(ctx, arr);
++			return NULL;
++		}
++		obj = arr;
++		break;
++	}
++	case 0xb0: /* CE v1 Dictionary */
++	case 0x31: /* CE v0 / ldid Dictionary */
++		obj = fuxi_der_parse_dict(val, next, ops, ctx, depth);
++		break;
++	default:
