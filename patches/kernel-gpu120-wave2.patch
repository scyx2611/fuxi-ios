+    unsigned comp_calls = 0;
+    int rc = uc.bo_alloc(65536, 0, &h, true, /*fail_bind=*/true, nullptr, &comp_calls);
+    assert(rc == SimUserClient::kNoRes);
+    assert(comp_calls == 1);
+    assert(uc.wired_bytes() == 0);
+    uc.client_close();
