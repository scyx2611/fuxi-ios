+    set_channels_40(41);
+    memset(&caller_scan, 0, sizeof(caller_scan));
+    thread = begin(2, false); step(); expect_request(2);
+    assert(!request_attribute(FWC_ATTR_SCAN_DWELL_MS, &size));
+    scan_accept(false); serve_bss(6, 0);
