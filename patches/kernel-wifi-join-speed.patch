+    memset(&caller_scan, 0, sizeof(caller_scan));
+    caller_scan.frequency_count = 13;
+    for (unsigned i = 0; i < 13; i++) caller_scan.frequencies[i] = wli_channels[i].frequency;
+    thread = begin(2, false); step(); expect_request(2);
